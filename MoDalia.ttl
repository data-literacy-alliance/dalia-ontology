:Person rdf:type owl:Class ;
        rdfs:subClassOf :ProviderType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#PlanPhase
:PlanPhase rdf:type owl:Class ;
           rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#PreservePhase
:PreservePhase rdf:type owl:Class ;
               rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Proficiency
:Proficiency rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( :Beginner
                                               :Competent
                                               :Expert
                                               :Novice
                                               :Proficient
                                             )
                                 ] .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Provider
:Provider rdf:type owl:Class ;
          rdfs:comment "Repository that proviedes OER"@en ;
          <http://www.w3.org/2004/02/skos/core#example> "OERSI or Dataone"@en .


