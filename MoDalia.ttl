<http://www.semanticweb.org/abdel/ontologies/2023/0/modalia> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
<http://www.w3.org/2004/02/skos/core#example> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#langString
rdf:langString rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#belongsToPhase
:belongsToPhase rdf:type owl:ObjectProperty ;
                rdfs:domain :RDMResource ;
                rdfs:range :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#canCarryOut
:canCarryOut rdf:type owl:ObjectProperty ;
             rdfs:domain :Skill ;
             rdfs:range :RDMTask .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#canPerform
:canPerform rdf:type owl:ObjectProperty ;
            rdfs:domain :RDMTool ;
            rdfs:range :RDMTask .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#consistsOfKnowledge
:consistsOfKnowledge rdf:type owl:ObjectProperty ;
                     rdfs:domain :LearningPath ;
                     rdfs:range :KnowledgeTopic .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#definesLearningPath
:definesLearningPath rdf:type owl:ObjectProperty ;
                     rdfs:domain :UserProfile ;
                     rdfs:range :LearningPath .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#essentialFor
:essentialFor rdf:type owl:ObjectProperty ;
              rdfs:domain :Skill ;
              rdfs:range :Job ;
              rdfs:label "is essential for"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#generateUserLogs
:generateUserLogs rdf:type owl:ObjectProperty ;
                  rdfs:domain :User ;
                  rdfs:range :UserLogs .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#givesProficiencyLevel
:givesProficiencyLevel rdf:type owl:ObjectProperty ;
                       rdfs:domain <https://github.com/tibonto/educor#EducationalResource> ;
                       rdfs:range :Proficiency .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasAttachment
:hasAttachment rdf:type owl:ObjectProperty ;
               rdfs:domain <https://github.com/tibonto/educor#EducationalResource> ;
               rdfs:range :ResourceAttachment .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasLearningGoal
:hasLearningGoal rdf:type owl:ObjectProperty ;
                 rdfs:domain :LearningPath ;
                 rdfs:range :LearningGoal .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasLearningResource
:hasLearningResource rdf:type owl:ObjectProperty ;
                     rdfs:domain :KnowledgeTopic ;
                     rdfs:range <https://github.com/tibonto/educor#EducationalResource> .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasLearningType
:hasLearningType rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain <https://github.com/tibonto/educor#EducationalResource> ;
                 rdfs:range :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasParentDomain
:hasParentDomain rdf:type owl:ObjectProperty ;
                 rdfs:domain :KnowledgeDomain ;
                 rdfs:range :KnowledgeDomain .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasProfile
:hasProfile rdf:type owl:ObjectProperty ;
            rdfs:domain :User ;
            rdfs:range :UserProfile .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasQuality
:hasQuality rdf:type owl:ObjectProperty ;
            rdfs:domain <https://github.com/tibonto/educor#EducationalResource> ;
            rdfs:range :ContentQuality .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#isLessProficientThan
:isLessProficientThan rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isMoreProficientThan ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#isMoreProficientThan
:isMoreProficientThan rdf:type owl:ObjectProperty ,
                               owl:TransitiveProperty ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#nextPhase
:nextPhase rdf:type owl:ObjectProperty ;
           rdfs:domain :DataLifeCyclePhase ;
           rdfs:range :DataLifeCyclePhase ;
           rdfs:label "has next phase"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#optionalFor
:optionalFor rdf:type owl:ObjectProperty ;
             rdfs:domain :Skill ;
             rdfs:range :Job ;
             rdfs:label "is optional for"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#prerequisites
:prerequisites rdf:type owl:ObjectProperty ;
               rdfs:domain :KnowledgeTopic ;
               rdfs:range :KnowledgeTopic .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#relatedTo
:relatedTo rdf:type owl:ObjectProperty ;
           rdfs:domain :RDMTool ;
           rdfs:range :RDMResource .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#requiresKnowledge
:requiresKnowledge rdf:type owl:ObjectProperty ;
                   rdfs:domain :Skill ;
                   rdfs:range :KnowledgeTopic .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#requiresProficiencyLevel
:requiresProficiencyLevel rdf:type owl:ObjectProperty ;
                          rdfs:domain <https://github.com/tibonto/educor#EducationalResource> ;
                          rdfs:range :Proficiency .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#satisfies
:satisfies rdf:type owl:ObjectProperty ;
           rdfs:domain :RDMTool ;
           rdfs:range :QualityStandards ;
           rdfs:label "satisfies"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#solves
:solves rdf:type owl:ObjectProperty ;
        rdfs:domain :User ;
        rdfs:range :Assesment ,
                   :Questionaire .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#storedIn
:storedIn rdf:type owl:ObjectProperty ;
          rdfs:domain :AcademicParameter ,
                      :LearningGoal ,
                      :LearningPreference ,
                      :Recommendation ;
          rdfs:range :UserProfile ;
          rdfs:label "is stored in"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain :Assesment ,
                                                    :Job ,
                                                    :KnowledgeTopic ,
                                                    :Skill ,
                                                    <https://github.com/tibonto/educor#EducationalResource> .


###  http://purl.org/dc/elements/1.1/type
<http://purl.org/dc/elements/1.1/type> rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf owl:topDataProperty ;
                                       rdfs:domain :Exercise ,
                                                   :Recommendation ,
                                                   :Skill ;
                                       rdfs:range rdfs:Literal ;
                                       rdfs:label "type"@en .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf owl:topDataProperty ;
                                       rdfs:domain :Exercise ,
                                                   :RDMTool ,
                                                   :Skill ,
                                                   <https://github.com/tibonto/educor#EducationalResource> ;
                                       rdfs:range xsd:string ;
                                       rdfs:label "description"@en .


###  http://purl.org/dc/terms/language
<http://purl.org/dc/terms/language> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://github.com/tibonto/educor#EducationalResource> .


###  http://schema.org/email
<http://schema.org/email> rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :User ;
                          rdfs:range xsd:string .


###  http://schema.org/keywords
<http://schema.org/keywords> rdf:type owl:DatatypeProperty ;
                             rdfs:domain :RDMTask ,
                                         :Skill ;
                             rdfs:range rdf:langString ,
                                        xsd:string .


###  http://schema.org/name
<http://schema.org/name> rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Contributer .


###  http://schema.org/timeRequired
<http://schema.org/timeRequired> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <https://github.com/tibonto/educor#EducationalResource> ;
                                 rdfs:range xsd:dateTime .


###  http://schema.org/url
<http://schema.org/url> rdf:type owl:DatatypeProperty ;
                        rdfs:domain :RDMTool ,
                                    <https://github.com/tibonto/educor#EducationalResource> ;
                        rdfs:range xsd:anyURI .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#studyPlan
:studyPlan rdf:type owl:DatatypeProperty ;
           rdfs:domain :LearningPath ;
           rdfs:range rdf:langString .


