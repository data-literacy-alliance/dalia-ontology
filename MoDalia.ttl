@prefix : <http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#> .
@prefix ec: <https://github.com/tibonto/educor#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#> .

<http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#> rdf:type owl:Ontology ;
                                                               owl:versionIRI <https://github.com/tibonto/educor#/0.0.1> ;
                                                               <http://purl.org/dc/elements/1.1/contributor> "Dr. Abdelmoneim Amer Desouki" ,
                                                                                                             "Dr. Marc Fuhrmans" ,
                                                                                                             "Dr. Petra Steiner" ;
                                                               <http://purl.org/dc/elements/1.1/creator> "DALIA project" ;
                                                               <http://purl.org/dc/elements/1.1/description> """MoDalia: An Ontology for Educational Material in RDM and Data Science

. The ontology is developed in OWL in Protege 5.0.0."""@en ;
                                                               <http://purl.org/dc/terms/abstract> "The aim of DALIA project is to build a platform for learning material for Research Data Management (RDA) and Data Science. The platform is based on a knowledge graph. We introduce MoDalia, the base ontology of DALIA knowledge graph. Modalia inherits some modules from EduCOR. It includes also modelling of micro -credentials and certificates."@en ;
                                                               <http://purl.org/dc/terms/created> "2023-08-15" ;
                                                               <http://purl.org/dc/terms/publisher> "ULB TUDa – University and State Library, Technical University, Darmstadt, Germany" ;
                                                               owl:versionInfo "0.0.1 - first version"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/contributor
<http://purl.org/dc/elements/1.1/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
<http://www.w3.org/2004/02/skos/core#example> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#langString
rdf:langString rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#belongsToPhase
:belongsToPhase rdf:type owl:ObjectProperty ;
                rdfs:domain :RDMResource ;
                rdfs:range :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#canCarryOut
:canCarryOut rdf:type owl:ObjectProperty ;
             rdfs:domain :Skill ;
             rdfs:range :RDMTask .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#canPerform
:canPerform rdf:type owl:ObjectProperty ;
            rdfs:domain :RDMTool ;
            rdfs:range :RDMTask .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#consistsOfKnowledge
:consistsOfKnowledge rdf:type owl:ObjectProperty ;
                     rdfs:domain ec:LearningPath ;
                     rdfs:range ec:KnowledgeTopic .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#definesLearningPath
:definesLearningPath rdf:type owl:ObjectProperty ;
                     rdfs:domain :UserProfile ;
                     rdfs:range ec:LearningPath .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#essentialFor
:essentialFor rdf:type owl:ObjectProperty ;
              rdfs:domain :Skill ;
              rdfs:range :Job ;
              rdfs:label "is essential for"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#generateUserLogs
:generateUserLogs rdf:type owl:ObjectProperty ;
                  rdfs:domain :User ;
                  rdfs:range :UserLogs .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#givesProficiencyLevel
:givesProficiencyLevel rdf:type owl:ObjectProperty ;
                       rdfs:domain ec:EducationalResource ;
                       rdfs:range :Proficiency .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasAchievement
:hasAchievement rdf:type owl:ObjectProperty ;
                rdfs:domain :User ;
                rdfs:range :UserAchievement .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasAttachment
:hasAttachment rdf:type owl:ObjectProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range :ResourceAttachment .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasKnowledgeTopic
:hasKnowledgeTopic rdf:type owl:ObjectProperty ;
                   owl:inverseOf :hasLearningResource ;
                   rdfs:domain ec:EducationalResource ;
                   rdfs:range ec:KnowledgeTopic .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasLearningGoal
:hasLearningGoal rdf:type owl:ObjectProperty ;
                 rdfs:domain ec:LearningPath ;
                 rdfs:range ec:LearningGoal .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasLearningResource
:hasLearningResource rdf:type owl:ObjectProperty ;
                     rdfs:domain ec:KnowledgeTopic ;
                     rdfs:range ec:EducationalResource .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasLearningType
:hasLearningType rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain ec:EducationalResource ;
                 rdfs:range :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasMicroCredential
:hasMicroCredential rdf:type owl:ObjectProperty ;
                    rdfs:domain :UserAchievement ;
                    rdfs:range :MicroCredential .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasParentDomain
:hasParentDomain rdf:type owl:ObjectProperty ;
                 rdfs:domain :KnowledgeDomain ;
                 rdfs:range :KnowledgeDomain .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasProfile
:hasProfile rdf:type owl:ObjectProperty ;
            rdfs:domain :User ;
            rdfs:range :UserProfile .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasQuality
:hasQuality rdf:type owl:ObjectProperty ;
            rdfs:domain ec:EducationalResource ;
            rdfs:range :ContentQuality .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasTargetGroup
:hasTargetGroup rdf:type owl:ObjectProperty ;
                rdfs:domain :LearningObjectiveMatrix ;
                rdfs:range :TargetGroup .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#isCoveredIn
:isCoveredIn rdf:type owl:ObjectProperty ;
             rdfs:domain :RDMTopic ;
             rdfs:range :LearningObjectiveMatrix .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#isLessProficientThan
:isLessProficientThan rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isMoreProficientThan ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#isMoreProficientThan
:isMoreProficientThan rdf:type owl:ObjectProperty ,
                               owl:TransitiveProperty ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#nextPhase
:nextPhase rdf:type owl:ObjectProperty ;
           rdfs:domain :DataLifeCyclePhase ;
           rdfs:range :DataLifeCyclePhase ;
           rdfs:label "has next phase"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#optionalFor
:optionalFor rdf:type owl:ObjectProperty ;
             rdfs:domain :Skill ;
             rdfs:range :Job ;
             rdfs:label "is optional for"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#prerequisites
:prerequisites rdf:type owl:ObjectProperty ;
               rdfs:domain ec:KnowledgeTopic ;
               rdfs:range ec:KnowledgeTopic .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#relatedTo
:relatedTo rdf:type owl:ObjectProperty ;
           rdfs:domain :RDMTool ;
           rdfs:range :RDMResource .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#requiresKnowledge
:requiresKnowledge rdf:type owl:ObjectProperty ;
                   rdfs:domain :Skill ;
                   rdfs:range ec:KnowledgeTopic .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#requiresProficiencyLevel
:requiresProficiencyLevel rdf:type owl:ObjectProperty ;
                          rdfs:domain ec:EducationalResource ;
                          rdfs:range :Proficiency .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#satisfies
:satisfies rdf:type owl:ObjectProperty ;
           rdfs:domain :RDMTool ;
           rdfs:range :QualityStandard ;
           rdfs:label "satisfies"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#solves
:solves rdf:type owl:ObjectProperty ;
        rdfs:domain :User ;
        rdfs:range :Assessment ,
                   :Questionnaire .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#storedIn
:storedIn rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( ec:AcademicParameter
                                      ec:LearningGoal
                                      ec:LearningPreference
                                      ec:Recommendation
                                    )
                      ] ;
          rdfs:range :UserProfile ;
          rdfs:label "is stored in"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( :Assessment
                                                                    :Job
                                                                    :MicroCredential
                                                                    :Skill
                                                                    ec:EducationalResource
                                                                    ec:KnowledgeTopic
                                                                  )
                                                    ] .


###  http://purl.org/dc/elements/1.1/type
<http://purl.org/dc/elements/1.1/type> rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf owl:topDataProperty ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( :Exercise
                                                                   :Skill
                                                                   ec:Recommendation
                                                                 )
                                                   ] ;
                                       rdfs:range rdfs:Literal ;
                                       rdfs:label "type"@en .


###  http://purl.org/dc/terms/dateCreated
<http://purl.org/dc/terms/dateCreated> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( :RDMTool
                                                                   ec:EducationalResource
                                                                 )
                                                   ] ;
                                       rdfs:range xsd:dateTime .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf owl:topDataProperty ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( :Exercise
                                                                   :RDMTool
                                                                   :Skill
                                                                   ec:EducationalResource
                                                                 )
                                                   ] ;
                                       rdfs:range xsd:string ;
                                       rdfs:label "description"@en .


###  http://purl.org/dc/terms/language
<http://purl.org/dc/terms/language> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain ec:EducationalResource .


###  http://schema.org/citation
<http://schema.org/citation> rdf:type owl:DatatypeProperty ;
                             rdfs:domain :RDMTool ;
                             rdfs:range xsd:string .


###  http://schema.org/dateModified
<http://schema.org/dateModified> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :RDMTool ;
                                 rdfs:range xsd:dateTime .


###  http://schema.org/downloadUrl
<http://schema.org/downloadUrl> rdf:type owl:DatatypeProperty ;
                                rdfs:domain :RDMTool ;
                                rdfs:range xsd:anyURI .


###  http://schema.org/email
<http://schema.org/email> rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :User ;
                          rdfs:range xsd:string .


###  http://schema.org/keywords
<http://schema.org/keywords> rdf:type owl:DatatypeProperty ;
                             rdfs:domain [ rdf:type owl:Class ;
                                           owl:unionOf ( :RDMTask
                                                         :Skill
                                                       )
                                         ] ;
                             rdfs:range rdf:langString ,
                                        xsd:string .


###  http://schema.org/maintainer
<http://schema.org/maintainer> rdf:type owl:DatatypeProperty ;
                               rdfs:domain :RDMTool ;
                               rdfs:range xsd:string .


###  http://schema.org/name
<http://schema.org/name> rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Contributer .


###  http://schema.org/timeRequired
<http://schema.org/timeRequired> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain ec:EducationalResource ;
                                 rdfs:range xsd:dateTime .


###  http://schema.org/url
<http://schema.org/url> rdf:type owl:DatatypeProperty ;
                        rdfs:domain :RDMTool ,
                                    ec:EducationalResource ;
                        rdfs:range xsd:anyURI .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#accessibleForFree
:accessibleForFree rdf:type owl:DatatypeProperty ;
                   rdfs:domain ec:EducationalResource ;
                   rdfs:range xsd:boolean .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#certificateEndDate
:certificateEndDate rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Certificate ;
                    rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#certificateName
:certificateName rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Certificate ;
                 rdfs:range xsd:string .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#certificateStartDate
:certificateStartDate rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Certificate ;
                      rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#certificateUrl
:certificateUrl rdf:type owl:DatatypeProperty ;
                rdfs:domain :Certificate ;
                rdfs:range xsd:anyURI .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasGrade
:hasGrade rdf:type owl:DatatypeProperty ;
          rdfs:domain :UserAchievement ;
          rdfs:range xsd:string .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasGrantDate
:hasGrantDate rdf:type owl:DatatypeProperty ;
              rdfs:domain :UserAchievement ;
              rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasInterval
:hasInterval rdf:type owl:DatatypeProperty ;
             rdfs:domain :MicroCredential ;
             rdfs:range rdfs:Literal .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#hasLearningObjective
:hasLearningObjective rdf:type owl:DatatypeProperty ;
                      rdfs:domain :LearningObjectiveMatrix ;
                      rdfs:range xsd:string .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#isItClassRoom
:isItClassRoom rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range xsd:boolean .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#microCredentialUrl
:microCredentialUrl rdf:type owl:DatatypeProperty ;
                    rdfs:domain :MicroCredential ;
                    rdfs:range xsd:anyURI .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#studyPlan
:studyPlan rdf:type owl:DatatypeProperty ;
           rdfs:domain ec:LearningPath ;
           rdfs:range rdf:langString .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#viewCount
:viewCount rdf:type owl:DatatypeProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Exercise
                                       ec:EducationalResource
                                     )
                       ] ;
           rdfs:range xsd:int .


###  https://schema.org/language
<https://schema.org/language> rdf:type owl:DatatypeProperty ;
                              rdfs:domain ec:EducationalResource ;
                              rdfs:range xsd:language .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#AnalyzePhase
:AnalyzePhase rdf:type owl:Class ;
              rdfs:subClassOf :DataLifeCyclePhase ;
              owl:disjointWith :AssurePhase ,
                               :CollectPhase ,
                               :DescribePhase ,
                               :DiscoverPhase ,
                               :IntegratePhase ,
                               :PlanPhase ,
                               :PreservePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Assessment
:Assessment rdf:type owl:Class ;
            rdfs:subClassOf :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#AssurePhase
:AssurePhase rdf:type owl:Class ;
             rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#AuthorRole
:AuthorRole rdf:type owl:Class ;
            rdfs:subClassOf :UserRole .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#BachelorStudent
:BachelorStudent rdf:type owl:Class ;
                 rdfs:subClassOf :TargetGroup .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Best-Practices
:Best-Practices rdf:type owl:Class ;
                rdfs:subClassOf :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#CaseStudy
:CaseStudy rdf:type owl:Class ;
           rdfs:subClassOf :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Certificate
:Certificate rdf:type owl:Class .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Code
:Code rdf:type owl:Class ;
      rdfs:subClassOf :ResourceAttachment .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#CollectPhase
:CollectPhase rdf:type owl:Class ;
              rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#ContentQuality
:ContentQuality rdf:type owl:Class ;
                rdfs:label "Content Quality"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Contributer
:Contributer rdf:type owl:Class ;
             rdfs:comment "The author of the OER"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#CuratorRole
:CuratorRole rdf:type owl:Class ;
             rdfs:subClassOf :UserRole .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#DataLifeCyclePhase
:DataLifeCyclePhase rdf:type owl:Class .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#DataSteward
:DataSteward rdf:type owl:Class ;
             rdfs:subClassOf :TargetGroup .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#DescribePhase
:DescribePhase rdf:type owl:Class ;
               rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#DiscoverPhase
:DiscoverPhase rdf:type owl:Class ;
               rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Exercise
:Exercise rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty :hasLearningResource ;
                                owl:allValuesFrom :Assessment
                              ] ;
          rdfs:subClassOf ec:EducationalResource .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Experiment
:Experiment rdf:type owl:Class ;
            rdfs:subClassOf :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#IntegratePhase
:IntegratePhase rdf:type owl:Class ;
                rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Job
:Job rdf:type owl:Class ;
     owl:disjointWith :KnowledgeDomain ,
                      :RDMTool ;
     rdfs:seeAlso "http://schema.org/Occupation"@en ;
     <http://www.w3.org/2004/02/skos/core#definition> "name of a profession"@en ;
     <http://www.w3.org/2004/02/skos/core#example> "Software Developer"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#JupyterNotebook
:JupyterNotebook rdf:type owl:Class ;
                 rdfs:subClassOf :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#KnowledgeDomain
:KnowledgeDomain rdf:type owl:Class ;
                 <http://www.w3.org/2004/02/skos/core#definition> "knowledge of a specific, specialized discipline or field"@en ;
                 <http://www.w3.org/2004/02/skos/core#example> "An example of knowledge domain can be Biology or Chemistry"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#LearningObjectiveMatrix
:LearningObjectiveMatrix rdf:type owl:Class .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#LearningResourceType
:LearningResourceType rdf:type owl:Class .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Lecture
:Lecture rdf:type owl:Class ;
         rdfs:subClassOf :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#MasterStudent
:MasterStudent rdf:type owl:Class ;
               rdfs:subClassOf :TargetGroup .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#MicroCredential
:MicroCredential rdf:type owl:Class .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Organisation
:Organisation rdf:type owl:Class .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf :ProviderType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#PhDStudent
:PhDStudent rdf:type owl:Class ;
            rdfs:subClassOf :TargetGroup .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#PlanPhase
:PlanPhase rdf:type owl:Class ;
           rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#PreservePhase
:PreservePhase rdf:type owl:Class ;
               rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Proficiency
:Proficiency rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( :Beginner
                                               :Competent
                                               :Expert
                                               :Novice
                                               :Proficient
                                             )
                                 ] ;
             <http://www.w3.org/2004/02/skos/core#definition> """Benner’s Novice to Expert
The five stages of proficiency in the novice to expert model are: novice, advanced beginner, competent, proficient, and expert (Benner, 1982)."""@en .


