#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Beginner
:Beginner rdf:type owl:NamedIndividual ,
                   :Proficiency ;
          :isMoreProficientThan :Novice .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Competent
:Competent rdf:type owl:NamedIndividual ,
                    :Proficiency ;
           :isMoreProficientThan :Beginner .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Expert
:Expert rdf:type owl:NamedIndividual ,
                 :Proficiency ;
        :isMoreProficientThan :Proficient .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Novice
:Novice rdf:type owl:NamedIndividual ,
                 :Proficiency .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Proficient
:Proficient rdf:type owl:NamedIndividual ,
                     :Proficiency ;
            :isMoreProficientThan :Competent .


