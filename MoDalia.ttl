###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Code
:Code rdf:type owl:Class ;
      rdfs:subClassOf :ResourceAttachment .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#CollectPhase
:CollectPhase rdf:type owl:Class ;
              rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#ContentQuality
:ContentQuality rdf:type owl:Class ;
                rdfs:label "Content Quality"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Contributer
:Contributer rdf:type owl:Class ;
             rdfs:comment "The author of the OER"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#DataLifeCyclePhase
:DataLifeCyclePhase rdf:type owl:Class .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#DescribePhase
:DescribePhase rdf:type owl:Class ;
               rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#DiscoverPhase
:DiscoverPhase rdf:type owl:Class ;
               rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Exercise
:Exercise rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty :hasLearningResource ;
                                owl:allValuesFrom :Assesment
                              ] ;
          rdfs:subClassOf <https://github.com/tibonto/educor#EducationalResource> .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Experiment
:Experiment rdf:type owl:Class ;
            rdfs:subClassOf :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Image
:Image rdf:type owl:Class ;
       rdfs:subClassOf :ResourceAttachment .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#IntegratePhase
:IntegratePhase rdf:type owl:Class ;
                rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Job
:Job rdf:type owl:Class ;
     <http://www.w3.org/2004/02/skos/core#definition> "name of a profession"@en ;
     <http://www.w3.org/2004/02/skos/core#example> "Software Developer"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#JupyterNotebook
:JupyterNotebook rdf:type owl:Class ;
                 rdfs:subClassOf :LearningResourceType .


