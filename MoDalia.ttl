#    Classes
#################################################################

###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#AcademicParameter
:AcademicParameter rdf:type owl:Class ;
                   <http://www.w3.org/2004/02/skos/core#example> "It contains the quantitative parameters regarding a user performance"@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Accessability
:Accessability rdf:type owl:Class ;
               rdfs:label "Accessibility"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "It describes the user access and content accessibility rights. It can be used as a plugin point to connect with other ontologies."@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#AnalzyePhase
:AnalzyePhase rdf:type owl:Class ;
              rdfs:subClassOf :DataLifeCyclePhase .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Answer
:Answer rdf:type owl:Class ;
        rdfs:label "Answer"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "The input of a user in an exercise or test. It can have many different types, such as string, integer, or text."@en ;
        <http://www.w3.org/2004/02/skos/core#example> "\\\"4\\\", 4, \\\"The answer is 4\\\""@en .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#Assesment
:Assesment rdf:type owl:Class ;
           rdfs:subClassOf :LearningResourceType .


###  http://www.semanticweb.org/abdel/ontologies/2023/0/modalia#AssurePhase
:AssurePhase rdf:type owl:Class ;
             rdfs:subClassOf :DataLifeCyclePhase .


