@prefix : <https://purl.org/ontology/modalia#> .
@prefix bf: <http://id.loc.gov/ontologies/bibframe/> .
@prefix ec: <https://github.com/tibonto/educor#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://purl.org/ontology/modalia#> .

<https://purl.org/ontology/modalia#> rdf:type owl:Ontology ;
                                      owl:versionIRI <https://git.rwth-aachen.de/dalia/dalia-ontology#/0.0.1> ;
                                      <http://purl.org/dc/elements/1.1/contributor> "Dr. Abdelmoneim Amer Desouki (https://orcid.org/0000-0003-2083-1277), Technische Universität Darmstadt (https://ror.org/05n911h24, https://isni.org/isni/0000000109401669)" ,
                                                                                    "Dr. Marc Fuhrmans (https://orcid.org/0000-0002-9826-018X), Technische Universität Darmstadt (https://ror.org/05n911h24, https://isni.org/isni/0000000109401669)" ,
                                                                                    "Dr. Petra C. Steiner (https://orcid.org/0000-0001-8997-2620), Technische Universität Darmstadt (https://ror.org/05n911h24, https://isni.org/isni/0000000109401669)" ;
                                      <http://purl.org/dc/elements/1.1/creator> "BMBF DALIA project" ;
                                      <http://purl.org/dc/elements/1.1/description> """MoDalia: An Ontology for Educational Material in RDM and Data Science

. The ontology is developed in OWL in Protege 5.5.0."""@en ;
                                      dcterms:abstract "The aim of DALIA project is to build a platform for learning material for Research Data Management (RDM) and Data Science. The platform is based on a knowledge graph. We introduce MoDalia, the base ontology of DALIA knowledge graph. Modalia inherits some modules from EduCOR. It includes also modelling of micro -credentials and certificates."@en ;
                                      dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                      dcterms:publisher "ULB TUDa – University and State Library, Technical University, Darmstadt, Germany" ;
                                      rdfs:comment """MoDalia reuses elements from the following ontologies:
- DCTERMS = Dublin Core Terms  
- OWL = Web Ontology Language  
- RDF = Resource Description Framework  
- RDFS = RDF Schema  
- SCHEMA = schema.org  
- SKOS = Simple Knowledge Organization System  
- EC = EduCOR"""@en ;
                                      owl:versionInfo "0.0.1 - first version"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/contributor
<http://purl.org/dc/elements/1.1/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty ;
                                              rdfs:domain _:genid-nodeid-genid-498abde21c7243b7b2ae1549268841ad-D58D406BA13BC0C98B9F6BB9EC7B45EE ,
                                                          _:genid-nodeid-genid-498abde21c7243b7b2ae1549268841ad-EBDD00AF5EB762D2BBB7E0B69F20665F .


###  http://purl.org/dc/terms/abstract
dcterms:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
<http://www.w3.org/2004/02/skos/core#example> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#langString
rdf:langString rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://id.loc.gov/ontologies/bibframe/contribution
bf:contribution rdf:type owl:ObjectProperty ;
                rdfs:domain ec:EducationalResource ;
                rdfs:label "contribution"@en .


###  http://usefulinc.com/ns/doap#repository
<http://usefulinc.com/ns/doap#repository> rdf:type owl:ObjectProperty ;
                                          rdfs:domain ec:EducationalResource ;
                                          rdfs:range <http://purl.org/spar/fabio/Repository> .


###  https://purl.org/ontology/modalia#belongsToPhase
:belongsToPhase rdf:type owl:ObjectProperty ;
                rdfs:domain :RDMResource ;
                rdfs:range :DataLifeCyclePhase ;
                rdfs:label "belongsToPhase" .


###  https://purl.org/ontology/modalia#canCarryOut
:canCarryOut rdf:type owl:ObjectProperty ;
             rdfs:domain :Skill ;
             rdfs:range :RDMTask ;
             rdfs:label "canCarryOut" .


###  https://purl.org/ontology/modalia#commentUserID
:commentUserID rdf:type owl:ObjectProperty ;
               rdfs:domain <https://schema.org#UserComment> ;
               rdfs:range :User .


###  https://purl.org/ontology/modalia#commentedOER
:commentedOER rdf:type owl:ObjectProperty ;
              rdfs:domain <https://schema.org#UserComment> ;
              rdfs:range ec:EducationalResource .


###  https://purl.org/ontology/modalia#consistsOfKnowledge
:consistsOfKnowledge rdf:type owl:ObjectProperty ;
                     rdfs:domain ec:LearningPath ;
                     rdfs:range ec:KnowledgeTopic ;
                     rdfs:label "consistsOfKnowledge" .


###  https://purl.org/ontology/modalia#createdBy
:createdBy rdf:type owl:ObjectProperty ;
           rdfs:domain :Community ;
           rdfs:range :User .


###  https://purl.org/ontology/modalia#definesLearningPath
:definesLearningPath rdf:type owl:ObjectProperty ;
                     rdfs:domain :UserProfile ;
                     rdfs:range ec:LearningPath ;
                     rdfs:label "definesLearningPath" .


###  https://purl.org/ontology/modalia#educationalLevel
:educationalLevel rdf:type owl:ObjectProperty ;
                  rdfs:domain :User ;
                  rdfs:range :EducationalLevel .


###  https://purl.org/ontology/modalia#essentialFor
:essentialFor rdf:type owl:ObjectProperty ;
              rdfs:domain :Skill ;
              rdfs:range :Job ;
              rdfs:label "essentialFor"@en .


###  https://purl.org/ontology/modalia#generateUserLogs
:generateUserLogs rdf:type owl:ObjectProperty ;
                  rdfs:domain :User ;
                  rdfs:range ec:UserLogs ;
                  rdfs:label "generateUserLogs" .


###  https://purl.org/ontology/modalia#givesProficiencyLevel
:givesProficiencyLevel rdf:type owl:ObjectProperty ;
                       rdfs:domain ec:EducationalResource ;
                       rdfs:range :Proficiency ;
                       rdfs:label "givesProficiencyLevel" .


###  https://purl.org/ontology/modalia#hasAchievement
:hasAchievement rdf:type owl:ObjectProperty ;
                rdfs:domain :User ;
                rdfs:range :UserAchievement ;
                rdfs:label "hasAchievement" .


###  https://purl.org/ontology/modalia#hasAttachment
:hasAttachment rdf:type owl:ObjectProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range :ResourceAttachment ;
               rdfs:label "hasAttachment" .


###  https://purl.org/ontology/modalia#hasCommunity
:hasCommunity rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( ec:EducationalResource
                                          ec:LearningPath
                                        )
                          ] ;
              rdfs:range :Community ;
              rdfs:comment "The community of a learning resource or learning path" .


###  https://purl.org/ontology/modalia#hasCompetenceType
:hasCompetenceType rdf:type owl:ObjectProperty ;
                   rdfs:domain :LearningGoalMatrixEntry ;
                   rdfs:range :CompetenceType .


###  https://purl.org/ontology/modalia#hasDiscipline
:hasDiscipline rdf:type owl:ObjectProperty ;
               rdfs:domain :RDMResource ;
               rdfs:range :RDMDiscipline ;
               rdfs:label "hasDiscipline" .


###  https://purl.org/ontology/modalia#hasKnowledgeTopic
:hasKnowledgeTopic rdf:type owl:ObjectProperty ;
                   owl:inverseOf :hasLearningResource ;
                   rdfs:domain ec:EducationalResource ;
                   rdfs:range ec:KnowledgeTopic ;
                   rdfs:label "hasKnowledgeTopic" .


###  https://purl.org/ontology/modalia#hasLearningGoal
:hasLearningGoal rdf:type owl:ObjectProperty ;
                 rdfs:domain ec:LearningPath ;
                 rdfs:range ec:LearningGoal ;
                 rdfs:label "hasLearningGoal" .


###  https://purl.org/ontology/modalia#hasLearningLevel
:hasLearningLevel rdf:type owl:ObjectProperty ;
                  rdfs:domain :LearningGoalMatrixEntry ;
                  rdfs:range :LearningLevel .


###  https://purl.org/ontology/modalia#hasLearningResource
:hasLearningResource rdf:type owl:ObjectProperty ;
                     rdfs:domain ec:KnowledgeTopic ;
                     rdfs:range ec:EducationalResource ;
                     rdfs:label "hasLearningResource" .


###  https://purl.org/ontology/modalia#hasLearningType
:hasLearningType rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain ec:EducationalResource ;
                 rdfs:range :LearningResourceType ;
                 rdfs:label "hasLearningType" .


###  https://purl.org/ontology/modalia#hasMicroCredential
:hasMicroCredential rdf:type owl:ObjectProperty ;
                    rdfs:domain :UserAchievement ;
                    rdfs:range :MicroCredential ;
                    rdfs:label "hasMicroCredential" .


###  https://purl.org/ontology/modalia#hasOwner
:hasOwner rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Community ;
          rdfs:range :User .


###  https://purl.org/ontology/modalia#hasParentDomain
:hasParentDomain rdf:type owl:ObjectProperty ;
                 rdfs:domain :KnowledgeDomain ;
                 rdfs:range :KnowledgeDomain ;
                 rdfs:label "hasParentDomain" .


###  https://purl.org/ontology/modalia#hasProfile
:hasProfile rdf:type owl:ObjectProperty ;
            rdfs:domain :User ;
            rdfs:range :UserProfile ;
            rdfs:label "hasProfile" .


###  https://purl.org/ontology/modalia#hasProvider
:hasProvider rdf:type owl:ObjectProperty ;
             rdfs:domain ec:EducationalResource ;
             rdfs:range :Provider ;
             rdfs:label "hasProvider" .


###  https://purl.org/ontology/modalia#hasProviderType
:hasProviderType rdf:type owl:ObjectProperty ;
                 rdfs:domain :Provider ;
                 rdfs:range :ProviderType ;
                 rdfs:label "hasProviderType" .


###  https://purl.org/ontology/modalia#hasQuality
:hasQuality rdf:type owl:ObjectProperty ;
            rdfs:domain ec:EducationalResource ;
            rdfs:range :ContentQuality ;
            rdfs:label "hasQuality" .


###  https://purl.org/ontology/modalia#hasRating
:hasRating rdf:type owl:ObjectProperty ;
           rdfs:domain ec:EducationalResource ;
           rdfs:range :RatingIndicator ;
           rdfs:label "hasRating"@en .


###  https://purl.org/ontology/modalia#hasRole
:hasRole rdf:type owl:ObjectProperty ;
         rdfs:domain :User ;
         rdfs:range :UserRole .


###  https://purl.org/ontology/modalia#hasTargetGroup
:hasTargetGroup rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( ec:EducationalResource
                                            :LearningGoalMatrixEntry
                                          )
                            ] ;
                rdfs:range :TargetGroup ;
                rdfs:label "hasTargetGroup"@en .


###  https://purl.org/ontology/modalia#hasUser
:hasUser rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         rdfs:domain :RatingIndicator ;
         rdfs:range :User ;
         rdfs:label "hasUser"@en .


###  https://purl.org/ontology/modalia#isCoveredIn
:isCoveredIn rdf:type owl:ObjectProperty ;
             rdfs:domain :RDMTopic ;
             rdfs:range :LearningGoalMatrixEntry ;
             rdfs:label "isCoveredIn"@en .


###  https://purl.org/ontology/modalia#isLessProficientThan
:isLessProficientThan rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isMoreProficientThan ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency ;
                      rdfs:label "isLessProficientThan"@en .


###  https://purl.org/ontology/modalia#isMemberOf
:isMemberOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :User ;
            rdfs:range :Community .


###  https://purl.org/ontology/modalia#isMoreProficientThan
:isMoreProficientThan rdf:type owl:ObjectProperty ,
                               owl:TransitiveProperty ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency ;
                      rdfs:label "isMoreProficientThan"@en .


###  https://purl.org/ontology/modalia#isNewVersionOf
:isNewVersionOf rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain ec:EducationalResource ;
                rdfs:range ec:EducationalResource .


###  https://purl.org/ontology/modalia#nextPhase
:nextPhase rdf:type owl:ObjectProperty ;
           rdfs:domain :DataLifeCyclePhase ;
           rdfs:range :DataLifeCyclePhase ;
           rdfs:label "nextPhase"@en .


###  https://purl.org/ontology/modalia#optionalFor
:optionalFor rdf:type owl:ObjectProperty ;
             rdfs:domain :Skill ;
             rdfs:range :Job ;
             rdfs:label "optionalFor"@en .


###  https://purl.org/ontology/modalia#prerequisites
:prerequisites rdf:type owl:ObjectProperty ;
               rdfs:domain ec:KnowledgeTopic ;
               rdfs:range ec:KnowledgeTopic ;
               rdfs:label "prerequisites"@en .


###  https://purl.org/ontology/modalia#relatedTo
:relatedTo rdf:type owl:ObjectProperty ;
           rdfs:range :RDMResource ;
           rdfs:label "relatedTo"@en .


###  https://purl.org/ontology/modalia#requiresKnowledge
:requiresKnowledge rdf:type owl:ObjectProperty ;
                   rdfs:domain :Skill ;
                   rdfs:range ec:KnowledgeTopic ;
                   rdfs:label "requiresKnowledge"@en .


###  https://purl.org/ontology/modalia#requiresProficiencyLevel
:requiresProficiencyLevel rdf:type owl:ObjectProperty ;
                          rdfs:domain ec:EducationalResource ;
                          rdfs:range :Proficiency ;
                          rdfs:label "requiresProficiencyLevel"@en .


###  https://purl.org/ontology/modalia#satisfies
:satisfies rdf:type owl:ObjectProperty ;
           rdfs:label "satisfies"@en .


###  https://purl.org/ontology/modalia#solves
:solves rdf:type owl:ObjectProperty ;
        rdfs:domain :User ;
        rdfs:range :Assessment ,
                   :Questionnaire ;
        rdfs:label "solves"@en .


###  https://purl.org/ontology/modalia#storedIn
:storedIn rdf:type owl:ObjectProperty ;
          rdfs:range :UserProfile ;
          rdfs:label "storedIn"@en .


###  https://purl.org/ontology/modalia#userBookmarks
:userBookmarks rdf:type owl:ObjectProperty ;
               rdfs:domain :User ;
               rdfs:range ec:EducationalResource .


###  https://purl.org/ontology/modalia#userLikes
:userLikes rdf:type owl:ObjectProperty ;
           rdfs:domain :User ;
           rdfs:range ec:EducationalResource .


###  https://purl.org/ontology/modalia#userViews
:userViews rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :User ;
           rdfs:range ec:EducationalResource .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( ec:EducationalResource
                                                                    ec:KnowledgeTopic
                                                                    :Assessment
                                                                    :Community
                                                                    :Job
                                                                    :KnowledgeDomain
                                                                    :MicroCredential
                                                                    :Skill
                                                                  )
                                                    ] ;
                                        rdfs:range xsd:string ;
                                        rdfs:label "title"@en .


###  http://purl.org/dc/elements/1.1/type
<http://purl.org/dc/elements/1.1/type> rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf owl:topDataProperty ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( ec:Recommendation
                                                                   :Exercise
                                                                   :Skill
                                                                 )
                                                   ] ;
                                       rdfs:range rdfs:Literal ;
                                       rdfs:label "type"@en .


###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( ec:EducationalResource
                                            :Community
                                          )
                            ] ;
                rdfs:range xsd:dateTime ;
                rdfs:label "Date Created"@en .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( ec:EducationalResource
                                                ec:KnowledgeTopic
                                                :Community
                                                :KnowledgeDomain
                                              )
                                ] ;
                    rdfs:range xsd:string ;
                    rdfs:label "description"@en .


###  http://purl.org/dc/terms/format
dcterms:format rdf:type owl:DatatypeProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:isDefinedBy "File format of the file representing the resource" ;
               rdfs:label "file format"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "PDF, AVI" .


###  http://purl.org/dc/terms/language
dcterms:language rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:language ;
                 rdfs:label "language"@en .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:DatatypeProperty ;
                rdfs:domain ec:EducationalResource .


###  http://schema.org/citation
schema:citation rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:string .


###  http://schema.org/downloadUrl
schema:downloadUrl rdf:type owl:DatatypeProperty ;
                   rdfs:range xsd:anyURI ;
                   rdfs:label "downloadUrl"@en .


###  http://schema.org/email
schema:email rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :User ;
             rdfs:range xsd:string ;
             rdfs:label "email"@en .


###  http://schema.org/identifier
schema:identifier rdf:type owl:DatatypeProperty ;
                  rdfs:domain ec:EducationalResource ;
                  rdfs:range xsd:string .


###  http://schema.org/isAccessibleForFree
schema:isAccessibleForFree rdf:type owl:DatatypeProperty ;
                           rdfs:domain ec:EducationalResource ;
                           rdfs:range xsd:boolean ;
                           rdfs:label "accessibleForFree"@en .


###  http://schema.org/keywords
schema:keywords rdf:type owl:DatatypeProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :RDMTask
                                            :Skill
                                          )
                            ] ;
                rdfs:range rdf:langString ,
                           xsd:string ;
                rdfs:label "keywords"@en .


###  http://schema.org/maintainer
schema:maintainer rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:string ;
                  rdfs:label "maintainer"@en .


###  http://schema.org/name
schema:name rdf:type owl:DatatypeProperty ;
            rdfs:domain :Contributor ;
            rdfs:label "name"@en .


###  http://schema.org/timeRequired
schema:timeRequired rdf:type owl:DatatypeProperty ;
                    rdfs:domain ec:EducationalResource ;
                    rdfs:comment "in format xsd:duration"@en ;
                    rdfs:label "timeRequired"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "\"PT7M11S\"^^xsd:duration" .


###  http://schema.org/url
schema:url rdf:type owl:DatatypeProperty ;
           rdfs:domain ec:EducationalResource ;
           rdfs:range xsd:anyURI ;
           rdfs:label "url"@en .


###  http://schema.org/version
schema:version rdf:type owl:DatatypeProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range xsd:string .


###  http://w3id.org/nfdi4ing/metadata4ing#orcidId
<http://w3id.org/nfdi4ing/metadata4ing#orcidId> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain :User .


###  https://purl.org/ontology/modalia#certificateEndDate
:certificateEndDate rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Certificate ;
                    rdfs:range xsd:dateTime ;
                    rdfs:label "certificateEndDate"@en .


###  https://purl.org/ontology/modalia#certificateName
:certificateName rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Certificate ;
                 rdfs:range xsd:string ;
                 rdfs:label "certificateName"@en .


###  https://purl.org/ontology/modalia#certificateStartDate
:certificateStartDate rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Certificate ;
                      rdfs:range xsd:dateTime ;
                      rdfs:label "certificateStartDate"@en .


###  https://purl.org/ontology/modalia#certificateUrl
:certificateUrl rdf:type owl:DatatypeProperty ;
                rdfs:domain :Certificate ;
                rdfs:range xsd:anyURI ;
                rdfs:label "certificateUrl"@en .


###  https://purl.org/ontology/modalia#commentDate
:commentDate rdf:type owl:DatatypeProperty ;
             rdfs:domain <https://schema.org#UserComment> ;
             rdfs:range xsd:dateTimeStamp ;
             <http://www.w3.org/2004/02/skos/core#definition> "The date of a user comment"@en .


###  https://purl.org/ontology/modalia#commentID
:commentID rdf:type owl:DatatypeProperty ;
           <http://www.w3.org/2004/02/skos/core#definition> "ID of a user comment"@en .


###  https://purl.org/ontology/modalia#commentText
:commentText rdf:type owl:DatatypeProperty ;
             rdfs:domain <https://schema.org#UserComment> ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The OER of a user comment"@en .


###  https://purl.org/ontology/modalia#hasDOI
:hasDOI rdf:type owl:DatatypeProperty ;
        rdfs:domain ec:EducationalResource ;
        rdfs:range xsd:string ;
        rdfs:comment "the DOI of the resource if exists."@en ;
        rdfs:label "hasDOI"@en ;
        <http://www.w3.org/2004/02/skos/core#example> "example: 10.18450/dataman/90" .


###  https://purl.org/ontology/modalia#hasGrade
:hasGrade rdf:type owl:DatatypeProperty ;
          rdfs:domain :UserAchievement ;
          rdfs:range xsd:string ;
          rdfs:label "hasGrade"@en .


###  https://purl.org/ontology/modalia#hasGrantDate
:hasGrantDate rdf:type owl:DatatypeProperty ;
              rdfs:domain :UserAchievement ;
              rdfs:range xsd:dateTime ;
              rdfs:label "hasGrantDate"@en .


###  https://purl.org/ontology/modalia#hasInterval
:hasInterval rdf:type owl:DatatypeProperty ;
             rdfs:domain :MicroCredential ;
             rdfs:range rdfs:Literal ;
             rdfs:label "hasInterval"@en .


###  https://purl.org/ontology/modalia#hasLearningObjective
:hasLearningObjective rdf:type owl:DatatypeProperty ;
                      rdfs:domain :LearningGoalMatrixEntry ;
                      rdfs:range xsd:string ;
                      rdfs:label "hasLearningObjective"@en .


###  https://purl.org/ontology/modalia#hasRowID
:hasRowID rdf:type owl:DatatypeProperty ;
          rdfs:domain :LearningGoalMatrixEntry ;
          rdfs:range xsd:integer .


###  https://purl.org/ontology/modalia#isItClassRoom
:isItClassRoom rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range xsd:boolean ;
               rdfs:label "isItClassRoom"@en .


###  https://purl.org/ontology/modalia#microCredentialUrl
:microCredentialUrl rdf:type owl:DatatypeProperty ;
                    rdfs:domain :MicroCredential ;
                    rdfs:range xsd:anyURI .


###  https://purl.org/ontology/modalia#studyPlan
:studyPlan rdf:type owl:DatatypeProperty ;
           rdfs:domain ec:LearningPath ;
           rdfs:range rdf:langString ;
           rdfs:label "studyPlan"@en .


###  https://purl.org/ontology/modalia#viewCount
:viewCount rdf:type owl:DatatypeProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( ec:EducationalResource
                                       :Exercise
                                     )
                       ] ;
           rdfs:range xsd:int ;
           rdfs:label "viewCount"@en .


###  https://schema.org#author
<https://schema.org#author> rdf:type owl:DatatypeProperty ;
                            rdfs:domain ec:EducationalResource .


###  https://schema.org#likesCount
<https://schema.org#likesCount> rdf:type owl:DatatypeProperty ;
                                rdfs:domain ec:EducationalResource ;
                                rdfs:range xsd:int .


#################################################################
#    Classes
#################################################################

###  http://purl.org/spar/fabio/Repository
<http://purl.org/spar/fabio/Repository> rdf:type owl:Class ;
                                        rdfs:isDefinedBy "Repository of OER"@en ;
                                        <http://www.w3.org/2004/02/skos/core#example> "OERSI or Dataone"@en .


###  http:/schema.org/OrganisationProviderType
<http:/schema.org/OrganisationProviderType> rdf:type owl:Class ;
                                            rdfs:subClassOf :ProviderType ;
                                            rdfs:label "OrganisationProviderType"@en .


###  https://github.com/tibonto/educor#Answer
ec:Answer rdf:type owl:Class ;
          rdfs:label "Answer"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The input of a user in an exercise or test. It can have many different types, such as string, integer, or text."@en ;
          <http://www.w3.org/2004/02/skos/core#example> "\\\"4\\\", 4, \\\"The answer is 4\\\""@en .


###  https://github.com/tibonto/educor#EducationalResource
ec:EducationalResource rdf:type owl:Class ;
                       rdfs:label "EducationalResource"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Any educational resources online or offline"@en ;
                       <http://www.w3.org/2004/02/skos/core#example> "A video describing how lists work in Python programming language"@en .


###  https://github.com/tibonto/educor#KnowledgeTopic
ec:KnowledgeTopic rdf:type owl:Class ;
                  owl:disjointWith :Skill ;
                  rdfs:label "KnowledgeTopic"@en ;
                  rdfs:seeAlso "https://w3id.org/ccso/ccso#Topic"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A single node representing a learning module based on the domain ontology. It contains all the learning material for the specific learning module."@en ;
                  <http://www.w3.org/2004/02/skos/core#example> "A knowledge topic can be the “Quadratic equations” in the domain of Mathematics Algebra"@en .


###  https://github.com/tibonto/educor#LearningGoal
ec:LearningGoal rdf:type owl:Class ;
                rdfs:comment "The Learning Goal can vary depending on the personalisation level. For example a user might care to learn some specific topics and not all the skill set."@en ;
                rdfs:label "LearningGoal"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "The reach point of a learning path. The completion of a set of knowledge topics which can lead to mastering a skill. The learning goal in our design can be a Skill or a Knowledge Topic"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "A learning goal could be the skill \\\"Python Programming\\\" or the last Knowledge Topic in this skill set the \\\"Virtual environments in Python\\\""@en .


###  https://github.com/tibonto/educor#LearningPath
ec:LearningPath rdf:type owl:Class ;
                rdfs:comment "Often here it is mapped the background knowledge too."@en ;
                rdfs:label "LearningPath"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "The learning path consists of learner's previously followed topics and future ones in order to reach to the learning goal. It is an ordered list of recommendations, which is personalized to the needs of a certain user and target the accomplishment of a complex skill. It has as a final point a learning goal."@en ;
                <http://www.w3.org/2004/02/skos/core#example> "\"Hello world in python\", \"Comments in python\", \"Strings in python\""@en .


###  https://github.com/tibonto/educor#LearningPreference
ec:LearningPreference rdf:type owl:Class ;
                      rdfs:comment "It is based on the theory which identifies four learning styles (visual, auditory, reading, and kinesthetic)."@en ;
                      rdfs:label "LearningPreference"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "The learning preference of the user based on the learning styles theory"@en ;
                      <http://www.w3.org/2004/02/skos/core#example> "Visual"@en .


###  https://github.com/tibonto/educor#Question
ec:Question rdf:type owl:Class ;
            rdfs:label "Question"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Part of an exercise. A test has one or many exercises and therefore questions. An exercise can have multiple questions too"@en ;
            <http://www.w3.org/2004/02/skos/core#example> "\"What is the solution to the equation ln(x-3)=0 ?\"" .


###  https://github.com/tibonto/educor#Recommendation
ec:Recommendation rdf:type owl:Class ;
                  rdfs:comment "The recommendation in advanced systems can also be an action (take a small break), an exercise, a knowledge topic, a skill, or a learning path"@en ;
                  rdfs:label "Recommendation"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The output of the recommendation system algorithm. The system that reads user profile, content information, ratings and any available rules, in order to generate a meaningful recommendation."@en ;
                  <http://www.w3.org/2004/02/skos/core#example> "The recommendation is \"Quadratic Equation\""@en .


###  https://github.com/tibonto/educor#UserLogs
ec:UserLogs rdf:type owl:Class ;
            rdfs:label "UserLogs"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The user's history activity in the system"@en .


###  https://purl.org/ontology/modalia#AnalyzePhase
:AnalyzePhase rdf:type owl:Class ;
              rdfs:subClassOf :DataLifeCyclePhase ;
              owl:disjointWith :AssurePhase ,
                               :CollectPhase ,
                               :DescribePhase ,
                               :DiscoverPhase ,
                               :IntegratePhase ,
                               :PlanPhase ,
                               :PreservePhase ;
              rdfs:label "AnalyzePhase"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The last phase in data life cycle."@en .


###  https://purl.org/ontology/modalia#Assessment
:Assessment rdf:type owl:Class ;
            rdfs:subClassOf :LearningResourceType ;
            rdfs:label "Assessment"@en .


###  https://purl.org/ontology/modalia#AssurePhase
:AssurePhase rdf:type owl:Class ;
             rdfs:subClassOf :DataLifeCyclePhase ;
             rdfs:label "AssurePhase"@en .


###  https://purl.org/ontology/modalia#BachelorStudent
:BachelorStudent rdf:type owl:Class ;
                 rdfs:subClassOf :TargetGroup ;
                 rdfs:label "BachelorStudent"@en ;
                 rdfs:seeAlso "http://vivoweb.org/ontology/core#UndergraduateStudent" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Student in Bachelor's degree"@en .


###  https://purl.org/ontology/modalia#Best-Practices
:Best-Practices rdf:type owl:Class ;
                rdfs:subClassOf :LearningResourceType ;
                rdfs:label "Best-Practices"@en .


###  https://purl.org/ontology/modalia#CTMethodological
:CTMethodological rdf:type owl:Class ;
                  rdfs:subClassOf :CompetenceType .


###  https://purl.org/ontology/modalia#CTProfessional
:CTProfessional rdf:type owl:Class ;
                rdfs:subClassOf :CompetenceType .


###  https://purl.org/ontology/modalia#CTSelf
:CTSelf rdf:type owl:Class ;
        rdfs:subClassOf :CompetenceType .


###  https://purl.org/ontology/modalia#CTSocial
:CTSocial rdf:type owl:Class ;
          rdfs:subClassOf :CompetenceType .


###  https://purl.org/ontology/modalia#CaseStudy
:CaseStudy rdf:type owl:Class ;
           rdfs:subClassOf :LearningResourceType ;
           rdfs:label "CaseStudy"@en .


###  https://purl.org/ontology/modalia#Certificate
:Certificate rdf:type owl:Class ;
             rdfs:label "Certificate" ;
             <http://www.w3.org/2004/02/skos/core#definition> "A certificate obtained by user."@en ;
             <http://www.w3.org/2004/02/skos/core#example> "SCRUM Professional I"@en .


###  https://purl.org/ontology/modalia#Code
:Code rdf:type owl:Class ;
      rdfs:subClassOf :ResourceAttachment .


###  https://purl.org/ontology/modalia#CollectPhase
:CollectPhase rdf:type owl:Class ;
              rdfs:subClassOf :DataLifeCyclePhase ;
              rdfs:label "CollectPhase"@en .


###  https://purl.org/ontology/modalia#Community
:Community rdf:type owl:Class ;
           rdfs:label "Community"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "A Community gathers users (members) and educational resources/learning paths similar  Zenodo communities"@en .


###  https://purl.org/ontology/modalia#CompetenceType
:CompetenceType rdf:type owl:Class ;
                <http://www.w3.org/2004/02/skos/core#definition> "The different type of competences"@en .


###  https://purl.org/ontology/modalia#ContentQuality
:ContentQuality rdf:type owl:Class ;
                rdfs:label "Content Quality"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Educational quality of an OER"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "High quality"@en .


###  https://purl.org/ontology/modalia#Contributor
:Contributor rdf:type owl:Class ;
             rdfs:comment "Contributed to OER with some contribution type"@en ;
             rdfs:label "Contributor"@en .


###  https://purl.org/ontology/modalia#ContributorRole
:ContributorRole rdf:type owl:Class ;
                 rdfs:label "Contributor Role" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "types of contribution to an OER."@en ;
                 <http://www.w3.org/2004/02/skos/core#example> "Editor"@en .


###  https://purl.org/ontology/modalia#CuratorRole
:CuratorRole rdf:type owl:Class ;
             rdfs:subClassOf :UserRole ;
             rdfs:label "CuratorRole"@en .


###  https://purl.org/ontology/modalia#DataLifeCyclePhase
:DataLifeCyclePhase rdf:type owl:Class ;
                    rdfs:label "DataLifeCyclePhase"@en ;
                    rdfs:seeAlso "https://towson.libguides.com/dataresearch/datamangement/dldataone"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "One of the eight known phases of data life cycle."@en .


###  https://purl.org/ontology/modalia#DataSteward
:DataSteward rdf:type owl:Class ;
             rdfs:subClassOf :TargetGroup ;
             rdfs:label "DataSteward"@en .


