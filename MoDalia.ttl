:VARKVisual rdf:type owl:Class ;
            rdfs:subClassOf ec:LearningPreference ;
            rdfs:label "VARKVisual"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Visual learning (pictures, movies, diagrams)"@en .


###  https://purl.org/ontology/modalia#Workshop
:Workshop rdf:type owl:Class ;
          rdfs:subClassOf :LearningResourceType ;
          rdfs:label "Workshop"@en .


###  https://schema.org#UserComment
<https://schema.org#UserComment> rdf:type owl:Class ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Comment added by a user on an educational resource"@en .


###  https://schema.org/audio
<https://schema.org/audio> rdf:type owl:Class ;
                           rdfs:subClassOf :ResourceAttachment ;
                           rdfs:label "Audio"@en .


###  https://schema.org/image
