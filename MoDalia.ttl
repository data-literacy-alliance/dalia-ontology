:RatingIndicator rdf:type owl:Class ;
                 rdfs:label "RatingIndicator"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Is a URI that relates a User and an OER and have predicate schema:rating" .


###  https://purl.org/ontology/modalia#ResearcherRole
:ResearcherRole rdf:type owl:Class ;
                rdfs:subClassOf :UserRole ;
                rdfs:label "ResearcherRole"@en .


