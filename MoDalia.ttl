               rdfs:label "MasterStudent"@en ;
               rdfs:seeAlso "http://w3id.org/roh#MastersStudent" ;
               <http://www.w3.org/2004/02/skos/core#definition> "A student in Master's degree"@en .


###  https://purl.org/ontology/modalia#MicroCredential
:MicroCredential rdf:type owl:Class ;
                 rdfs:label "MicroCredential"@en .


###  https://purl.org/ontology/modalia#Organization
:Organization rdf:type owl:Class ;
              rdfs:label "Organization" ;
              rdfs:seeAlso <http://xmlns.com/foaf/0.1/Organization> .


