:PlanPhase rdf:type owl:Class ;
           rdfs:subClassOf :DataLifeCyclePhase ;
           rdfs:label "PlanPhase"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "First phase in data life cycle. Description of the data that will be compiled."@en .


###  https://purl.org/ontology/modalia#PreservePhase
:PreservePhase rdf:type owl:Class ;
               rdfs:subClassOf :DataLifeCyclePhase ;
               rdfs:label "PreservePhase"@en .


###  https://purl.org/ontology/modalia#Proficiency
:Proficiency rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( :Beginner
                                               :Competent
                                               :Expert
                                               :Novice
                                               :Proficient
                                             )
                                 ] ;
             rdfs:label "Proficiency"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> """Benner’s Novice to Expert
The five stages of proficiency in the novice to expert model are: novice, advanced beginner, competent, proficient, and expert (Benner, 1982)."""@en .


###  https://purl.org/ontology/modalia#Provider
:Provider rdf:type owl:Class ;
          rdfs:comment "Person, service or organisation that provides the OER"@en ;
          rdfs:label "Provider"@en .


###  https://purl.org/ontology/modalia#ProviderType
:ProviderType rdf:type owl:Class ;
              rdfs:label "Provider Type"@en .


