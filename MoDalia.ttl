:DescribePhase rdf:type owl:Class ;
               rdfs:subClassOf :DataLifeCyclePhase ;
               rdfs:label "DescribePhase"@en .


###  https://purl.org/ontology/modalia#DiscoverPhase
:DiscoverPhase rdf:type owl:Class ;
               rdfs:subClassOf :DataLifeCyclePhase ;
               rdfs:label "DiscoverPhase"@en .


###  https://purl.org/ontology/modalia#EducationalLevel
:EducationalLevel rdf:type owl:Class ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The educational level of a user: Bachlor, Master or PhD"@en .


###  https://purl.org/ontology/modalia#Exercise
:Exercise rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty :hasLearningResource ;
                                owl:allValuesFrom :Assessment
                              ] ;
          rdfs:subClassOf ec:EducationalResource ;
          rdfs:label "Exercise"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "Some questions related to one or more knowledge topics."@en .


###  https://purl.org/ontology/modalia#Experiment
:Experiment rdf:type owl:Class ;
            rdfs:subClassOf :LearningResourceType ;
            rdfs:label "Experiment"@en .


