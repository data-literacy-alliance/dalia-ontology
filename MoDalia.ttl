@prefix : <https://git.rwth-aachen.de/dalia/dalia-ontology#> .
@prefix ec: <https://github.com/tibonto/educor#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://git.rwth-aachen.de/dalia/dalia-ontology#> .

<https://git.rwth-aachen.de/dalia/dalia-ontology#> rdf:type owl:Ontology ;
                                                    owl:versionIRI <https://github.com/tibonto/educor#/0.0.1> ;
                                                    <http://purl.org/dc/elements/1.1/contributor> "Dr. Abdelmoneim Amer Desouki" ,
                                                                                                  "Dr. Marc Fuhrmans" ,
                                                                                                  "Dr. Petra C. Steiner" ;
                                                    <http://purl.org/dc/elements/1.1/creator> "DALIA project" ;
                                                    <http://purl.org/dc/elements/1.1/description> """MoDalia: An Ontology for Educational Material in RDM and Data Science

. The ontology is developed in OWL in Protege 5.0.0."""@en ;
                                                    <http://purl.org/dc/terms/abstract> "The aim of DALIA project is to build a platform for learning material for Research Data Management (RDA) and Data Science. The platform is based on a knowledge graph. We introduce MoDalia, the base ontology of DALIA knowledge graph. Modalia inherits some modules from EduCOR. It includes also modelling of micro -credentials and certificates."@en ;
                                                    <http://purl.org/dc/terms/created> "2023-09-11" ;
                                                    <http://purl.org/dc/terms/publisher> "ULB TUDa – University and State Library, Technical University, Darmstadt, Germany" ;
                                                    rdfs:comment """MoDalia reuses elements from the following ontologies:
- DCTERMS = Dublin Core Terms  
- OWL = Web Ontology Language  
- RDF = Resource Description Framework  
- RDFS = RDF Schema  
- SCHEMA = schema.org  
- SKOS = Simple Knowledge Organization System  
- EC = EduCOR"""@en ;
                                                    owl:versionInfo "0.0.1 - first version"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/contributor
<http://purl.org/dc/elements/1.1/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
<http://www.w3.org/2004/02/skos/core#example> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#langString
rdf:langString rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://git.rwth-aachen.de/dalia/dalia-ontology#belongsToPhase
:belongsToPhase rdf:type owl:ObjectProperty ;
                rdfs:domain :RDMResource ;
                rdfs:range :DataLifeCyclePhase ;
                rdfs:label "belongsToPhase" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#canCarryOut
:canCarryOut rdf:type owl:ObjectProperty ;
             rdfs:domain :Skill ;
             rdfs:range :RDMTask ;
             rdfs:label "canCarryOut" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#consistsOfKnowledge
:consistsOfKnowledge rdf:type owl:ObjectProperty ;
                     rdfs:domain ec:LearningPath ;
                     rdfs:range ec:KnowledgeTopic ;
                     rdfs:label "consistsOfKnowledge" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#definesLearningPath
:definesLearningPath rdf:type owl:ObjectProperty ;
                     rdfs:domain :UserProfile ;
                     rdfs:range ec:LearningPath ;
                     rdfs:label "definesLearningPath" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#essentialFor
:essentialFor rdf:type owl:ObjectProperty ;
              rdfs:domain :Skill ;
              rdfs:range :Job ;
              rdfs:label "essentialFor"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#generateUserLogs
:generateUserLogs rdf:type owl:ObjectProperty ;
                  rdfs:domain :User ;
                  rdfs:range ec:UserLogs ;
                  rdfs:label "generateUserLogs" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#givesProficiencyLevel
:givesProficiencyLevel rdf:type owl:ObjectProperty ;
                       rdfs:domain ec:EducationalResource ;
                       rdfs:range :Proficiency ;
                       rdfs:label "givesProficiencyLevel" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasAchievement
:hasAchievement rdf:type owl:ObjectProperty ;
                rdfs:domain :User ;
                rdfs:range :UserAchievement ;
                rdfs:label "hasAchievement" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasAttachment
:hasAttachment rdf:type owl:ObjectProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range :ResourceAttachment ;
               rdfs:label "hasAttachment" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasContributor
:hasContributor rdf:type owl:ObjectProperty ;
                rdfs:domain ec:EducationalResource ;
                rdfs:range :Contributer ;
                rdfs:label "hasContributor" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasDiscipline
:hasDiscipline rdf:type owl:ObjectProperty ;
               rdfs:domain :RDMResource ;
               rdfs:range :RDMDiscipline ;
               rdfs:label "hasDiscipline" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasKnowledgeTopic
:hasKnowledgeTopic rdf:type owl:ObjectProperty ;
                   owl:inverseOf :hasLearningResource ;
                   rdfs:domain ec:EducationalResource ;
                   rdfs:range ec:KnowledgeTopic ;
                   rdfs:label "hasKnowledgeTopic" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasLearningGoal
:hasLearningGoal rdf:type owl:ObjectProperty ;
                 rdfs:domain ec:LearningPath ;
                 rdfs:range ec:LearningGoal ;
                 rdfs:label "hasLearningGoal" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasLearningResource
:hasLearningResource rdf:type owl:ObjectProperty ;
                     rdfs:domain ec:KnowledgeTopic ;
                     rdfs:range ec:EducationalResource ;
                     rdfs:label "hasLearningResource" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasLearningType
:hasLearningType rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain ec:EducationalResource ;
                 rdfs:range :LearningResourceType ;
                 rdfs:label "hasLearningType" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasMicroCredential
:hasMicroCredential rdf:type owl:ObjectProperty ;
                    rdfs:domain :UserAchievement ;
                    rdfs:range :MicroCredential ;
                    rdfs:label "hasMicroCredential" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasParentDomain
:hasParentDomain rdf:type owl:ObjectProperty ;
                 rdfs:domain :KnowledgeDomain ;
                 rdfs:range :KnowledgeDomain ;
                 rdfs:label "hasParentDomain" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasProfile
:hasProfile rdf:type owl:ObjectProperty ;
            rdfs:domain :User ;
            rdfs:range :UserProfile ;
            rdfs:label "hasProfile" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasProvider
:hasProvider rdf:type owl:ObjectProperty ;
             rdfs:domain ec:EducationalResource ;
             rdfs:range :Provider ;
             rdfs:label "hasProvider" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasProviderType
:hasProviderType rdf:type owl:ObjectProperty ;
                 rdfs:domain :Provider ;
                 rdfs:range :ProviderType ;
                 rdfs:label "hasProviderType" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasQuality
:hasQuality rdf:type owl:ObjectProperty ;
            rdfs:domain ec:EducationalResource ;
            rdfs:range :ContentQuality ;
            rdfs:label "hasQuality" .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasRating
:hasRating rdf:type owl:ObjectProperty ;
           rdfs:domain ec:EducationalResource ;
           rdfs:range :RatingIndicator ;
           rdfs:label "hasRating"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasTargetGroup
:hasTargetGroup rdf:type owl:ObjectProperty ;
                rdfs:domain :LearningObjectiveMatrixEntry ;
                rdfs:range :TargetGroup ;
                rdfs:label "hasTargetGroup"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasUser
:hasUser rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         rdfs:domain :RatingIndicator ;
         rdfs:range :User ;
         rdfs:label "hasUser"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#isCoveredIn
:isCoveredIn rdf:type owl:ObjectProperty ;
             rdfs:domain :RDMTopic ;
             rdfs:range :LearningObjectiveMatrixEntry ;
             rdfs:label "isCoveredIn"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#isLessProficientThan
:isLessProficientThan rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isMoreProficientThan ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency ;
                      rdfs:label "isLessProficientThan"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#isMoreProficientThan
:isMoreProficientThan rdf:type owl:ObjectProperty ,
                               owl:TransitiveProperty ;
                      rdfs:domain :Proficiency ;
                      rdfs:range :Proficiency ;
                      rdfs:label "isMoreProficientThan"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#nextPhase
:nextPhase rdf:type owl:ObjectProperty ;
           rdfs:domain :DataLifeCyclePhase ;
           rdfs:range :DataLifeCyclePhase ;
           rdfs:label "nextPhase"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#optionalFor
:optionalFor rdf:type owl:ObjectProperty ;
             rdfs:domain :Skill ;
             rdfs:range :Job ;
             rdfs:label "optionalFor"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#prerequisites
:prerequisites rdf:type owl:ObjectProperty ;
               rdfs:domain ec:KnowledgeTopic ;
               rdfs:range ec:KnowledgeTopic ;
               rdfs:label "prerequisites"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#relatedTo
:relatedTo rdf:type owl:ObjectProperty ;
           rdfs:range :RDMResource ;
           rdfs:label "relatedTo"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#requiresKnowledge
:requiresKnowledge rdf:type owl:ObjectProperty ;
                   rdfs:domain :Skill ;
                   rdfs:range ec:KnowledgeTopic ;
                   rdfs:label "requiresKnowledge"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#requiresProficiencyLevel
:requiresProficiencyLevel rdf:type owl:ObjectProperty ;
                          rdfs:domain ec:EducationalResource ;
                          rdfs:range :Proficiency ;
                          rdfs:label "requiresProficiencyLevel"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#satisfies
:satisfies rdf:type owl:ObjectProperty ;
           rdfs:label "satisfies"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#solves
:solves rdf:type owl:ObjectProperty ;
        rdfs:domain :User ;
        rdfs:range :Assessment ,
                   :Questionnaire ;
        rdfs:label "solves"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#storedIn
:storedIn rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( ec:AcademicParameter
                                      ec:LearningGoal
                                      ec:LearningPreference
                                      ec:Recommendation
                                    )
                      ] ;
          rdfs:range :UserProfile ;
          rdfs:label "storedIn"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( :Assessment
                                                                    :Job
                                                                    :MicroCredential
                                                                    :Skill
                                                                    ec:EducationalResource
                                                                    ec:KnowledgeTopic
                                                                  )
                                                    ] ;
                                        rdfs:label "title"@en .


###  http://purl.org/dc/elements/1.1/type
<http://purl.org/dc/elements/1.1/type> rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf owl:topDataProperty ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( :Exercise
                                                                   :Skill
                                                                   ec:Recommendation
                                                                 )
                                                   ] ;
                                       rdfs:range rdfs:Literal ;
                                       rdfs:label "type"@en .


###  http://purl.org/dc/terms/dateCreated
<http://purl.org/dc/terms/dateCreated> rdf:type owl:DatatypeProperty ;
                                       rdfs:range xsd:dateTime ;
                                       rdfs:label "dateCreated"@en .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf owl:topDataProperty ;
                                       rdfs:range xsd:string ;
                                       rdfs:label "description"@en .


###  http://purl.org/dc/terms/language
<http://purl.org/dc/terms/language> rdf:type owl:DatatypeProperty ;
                                    rdfs:range xsd:language ;
                                    rdfs:label "language"@en .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain ec:EducationalResource .


###  http://schema.org/citation
<http://schema.org/citation> rdf:type owl:DatatypeProperty ;
                             rdfs:range xsd:string .


###  http://schema.org/dateModified
<http://schema.org/dateModified> rdf:type owl:DatatypeProperty ;
                                 rdfs:range xsd:dateTime ;
                                 rdfs:label "dateModified"@en .


###  http://schema.org/downloadUrl
<http://schema.org/downloadUrl> rdf:type owl:DatatypeProperty ;
                                rdfs:range xsd:anyURI ;
                                rdfs:label "downloadUrl"@en .


###  http://schema.org/email
<http://schema.org/email> rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :User ;
                          rdfs:range xsd:string ;
                          rdfs:label "email"@en .


###  http://schema.org/keywords
<http://schema.org/keywords> rdf:type owl:DatatypeProperty ;
                             rdfs:domain [ rdf:type owl:Class ;
                                           owl:unionOf ( :RDMTask
                                                         :Skill
                                                       )
                                         ] ;
                             rdfs:range rdf:langString ,
                                        xsd:string ;
                             rdfs:label "keywords"@en .


###  http://schema.org/maintainer
<http://schema.org/maintainer> rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:string ;
                               rdfs:label "maintainer"@en .


###  http://schema.org/name
<http://schema.org/name> rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Contributer ;
                         rdfs:label "name"@en .


###  http://schema.org/timeRequired
<http://schema.org/timeRequired> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain ec:EducationalResource ;
                                 rdfs:range xsd:dateTime ;
                                 rdfs:label "timeRequired"@en .


###  http://schema.org/url
<http://schema.org/url> rdf:type owl:DatatypeProperty ;
                        rdfs:domain ec:EducationalResource ;
                        rdfs:range xsd:anyURI ;
                        rdfs:label "url"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#accessibleForFree
:accessibleForFree rdf:type owl:DatatypeProperty ;
                   rdfs:domain ec:EducationalResource ;
                   rdfs:range xsd:boolean ;
                   rdfs:label "accessibleForFree"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#certificateEndDate
:certificateEndDate rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Certificate ;
                    rdfs:range xsd:dateTime ;
                    rdfs:label "certificateEndDate"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#certificateName
:certificateName rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Certificate ;
                 rdfs:range xsd:string ;
                 rdfs:label "certificateName"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#certificateStartDate
:certificateStartDate rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Certificate ;
                      rdfs:range xsd:dateTime ;
                      rdfs:label "certificateStartDate"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#certificateUrl
:certificateUrl rdf:type owl:DatatypeProperty ;
                rdfs:domain :Certificate ;
                rdfs:range xsd:anyURI ;
                rdfs:label "certificateUrl"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasGrade
:hasGrade rdf:type owl:DatatypeProperty ;
          rdfs:domain :UserAchievement ;
          rdfs:range xsd:string ;
          rdfs:label "hasGrade"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasGrantDate
:hasGrantDate rdf:type owl:DatatypeProperty ;
              rdfs:domain :UserAchievement ;
              rdfs:range xsd:dateTime ;
              rdfs:label "hasGrantDate"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasInterval
:hasInterval rdf:type owl:DatatypeProperty ;
             rdfs:domain :MicroCredential ;
             rdfs:range rdfs:Literal ;
             rdfs:label "hasInterval"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#hasLearningObjective
:hasLearningObjective rdf:type owl:DatatypeProperty ;
                      rdfs:domain :LearningObjectiveMatrixEntry ;
                      rdfs:range xsd:string ;
                      rdfs:label "hasLearningObjective"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#isItClassRoom
:isItClassRoom rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain ec:EducationalResource ;
               rdfs:range xsd:boolean ;
               rdfs:label "isItClassRoom"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#microCredentialUrl
:microCredentialUrl rdf:type owl:DatatypeProperty ;
                    rdfs:domain :MicroCredential ;
                    rdfs:range xsd:anyURI .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#studyPlan
:studyPlan rdf:type owl:DatatypeProperty ;
           rdfs:domain ec:LearningPath ;
           rdfs:range rdf:langString ;
           rdfs:label "studyPlan"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#viewCount
:viewCount rdf:type owl:DatatypeProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Exercise
                                       ec:EducationalResource
                                     )
                       ] ;
           rdfs:range xsd:int ;
           rdfs:label "viewCount"@en .


#################################################################
#    Classes
#################################################################

###  http:/schema.org/OrganisationProviderType
<http:/schema.org/OrganisationProviderType> rdf:type owl:Class ;
                                            rdfs:subClassOf :ProviderType ;
                                            rdfs:label "OrganisationProviderType"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#AnalyzePhase
:AnalyzePhase rdf:type owl:Class ;
              rdfs:subClassOf :DataLifeCyclePhase ;
              owl:disjointWith :AssurePhase ,
                               :CollectPhase ,
                               :DescribePhase ,
                               :DiscoverPhase ,
                               :IntegratePhase ,
                               :PlanPhase ,
                               :PreservePhase ;
              rdfs:label "AnalyzePhase"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#Assessment
:Assessment rdf:type owl:Class ;
            rdfs:subClassOf :LearningResourceType ;
            rdfs:label "Assessment"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#AssurePhase
:AssurePhase rdf:type owl:Class ;
             rdfs:subClassOf :DataLifeCyclePhase ;
             rdfs:label "AssurePhase"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#AuthorRole
:AuthorRole rdf:type owl:Class ;
            rdfs:subClassOf :UserRole .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#BachelorStudent
:BachelorStudent rdf:type owl:Class ;
                 rdfs:subClassOf :TargetGroup ;
                 rdfs:label "BachelorStudent"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#Best-Practices
:Best-Practices rdf:type owl:Class ;
                rdfs:subClassOf :LearningResourceType ;
                rdfs:label "Best-Practices"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#CaseStudy
:CaseStudy rdf:type owl:Class ;
           rdfs:subClassOf :LearningResourceType ;
           rdfs:label "CaseStudy"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#Certificate
:Certificate rdf:type owl:Class ;
             rdfs:label "Certificate" ;
             <http://www.w3.org/2004/02/skos/core#definition> "A certificate obtained by user."@en ;
             <http://www.w3.org/2004/02/skos/core#example> "SCRUM Professional I"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#Code
:Code rdf:type owl:Class ;
      rdfs:subClassOf :ResourceAttachment .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#CollectPhase
:CollectPhase rdf:type owl:Class ;
              rdfs:subClassOf :DataLifeCyclePhase ;
              rdfs:label "CollectPhase"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#ContentQuality
:ContentQuality rdf:type owl:Class ;
                rdfs:label "Content Quality"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Educational quality of an OER"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "High quality"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#Contributer
:Contributer rdf:type owl:Class ;
             rdfs:comment "Contributed to OER with some contribution type"@en ;
             rdfs:label "Contributor"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#ContributorType
:ContributorType rdf:type owl:Class ;
                 rdfs:label "ContributorType" ;
                 <http://www.w3.org/2004/02/skos/core#example> "Creator ( Author )"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#CuratorRole
:CuratorRole rdf:type owl:Class ;
             rdfs:subClassOf :UserRole ;
             rdfs:label "CuratorRole"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#DataLifeCyclePhase
:DataLifeCyclePhase rdf:type owl:Class ;
                    rdfs:label "DataLifeCyclePhase"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "One of the eight known phases of data life cycle."@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#DataSteward
:DataSteward rdf:type owl:Class ;
             rdfs:subClassOf :TargetGroup ;
             rdfs:label "DataSteward"@en .


###  https://git.rwth-aachen.de/dalia/dalia-ontology#DescribePhase
