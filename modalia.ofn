AnnotationAssertion(skos:prefLabel bibo:Workshop "workshop"@en)
SubClassOf(bibo:Workshop :LearningResourceType)

# Class: <http://semanticscience.org/resource/SIO_000776> (object)

AnnotationAssertion(rdfs:isDefinedBy <http://semanticscience.org/resource/SIO_000776> <http://semanticscience.org>)
AnnotationAssertion(rdfs:label <http://semanticscience.org/resource/SIO_000776> "object"@en)
AnnotationAssertion(skos:definition <http://semanticscience.org/resource/SIO_000776> "an object that is described (chemical substance, living organism, building, ...)"@en)
