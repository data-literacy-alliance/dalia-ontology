# Individual: :Beginner (advanced beginner)

AnnotationAssertion(rdfs:label :Beginner "advanced beginner"@en)
ClassAssertion(:Proficiency :Beginner)
ObjectPropertyAssertion(:isLessProficientThan :Beginner :Competent)
ObjectPropertyAssertion(:isLessProficientThan :Beginner :Expert)
ObjectPropertyAssertion(:isLessProficientThan :Beginner :Proficient)
ObjectPropertyAssertion(:isMoreProficientThan :Beginner :Novice)
DataPropertyAssertion(:hasOrder :Beginner "2"^^xsd:integer)

