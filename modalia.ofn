ObjectPropertyDomain(dcterms:requires ec:EducationalResource)
ObjectPropertyRange(dcterms:requires owl:Thing)

# Object Property: fabio:hasDiscipline (hasDiscipline)

AnnotationAssertion(rdfs:label fabio:hasDiscipline "hasDiscipline")
ObjectPropertyDomain(fabio:hasDiscipline ObjectUnionOf(ec:EducationalResource ec:KnowledgeTopic))
ObjectPropertyRange(fabio:hasDiscipline :Discipline)

# Object Property: ec:consistsOfKnowledge (consistsOfKnowledge)

