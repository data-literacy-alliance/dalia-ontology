AnnotationAssertion(rdfs:isDefinedBy m4i:Tool <http://w3id.org/nfdi4ing/metadata4ing>)
AnnotationAssertion(rdfs:label m4i:Tool "tool"@en)
AnnotationAssertion(skos:definition m4i:Tool "a tool with which data was obtained (microscope, sensor, ...)"@en)

# Class: ec:EducationalResource (educational resource)

AnnotationAssertion(rdfs:isDefinedBy ec:EducationalResource <https://github.com/tibonto/educor>)
AnnotationAssertion(rdfs:label ec:EducationalResource "educational resource"@en)
AnnotationAssertion(skos:definition ec:EducationalResource "Any educational resources online or offline"@en)
AnnotationAssertion(skos:example ec:EducationalResource "A video describing how lists work in Python programming language"@en)

# Class: ec:KnowledgeTopic (knowledge topic)

AnnotationAssertion(rdfs:isDefinedBy ec:KnowledgeTopic <https://github.com/tibonto/educor>)
AnnotationAssertion(rdfs:label ec:KnowledgeTopic "knowledge topic"@en)
AnnotationAssertion(rdfs:seeAlso ec:KnowledgeTopic "https://w3id.org/ccso/ccso#Topic"@en)
AnnotationAssertion(skos:definition ec:KnowledgeTopic "A single node representing a learning module based on the domain ontology. It contains all the learning material for the specific learning module."@en)
AnnotationAssertion(skos:example ec:KnowledgeTopic "A knowledge topic can be the “Quadratic equations” in the domain of Mathematics Algebra"@en)
DisjointClasses(ec:KnowledgeTopic :Skill)

# Class: ec:LearningPreference (learning preference)

AnnotationAssertion(rdfs:comment ec:LearningPreference "It is based on the theory which identifies four learning styles (visual, auditory, reading, and kinesthetic)."@en)
AnnotationAssertion(rdfs:isDefinedBy ec:LearningPreference <https://github.com/tibonto/educor>)
AnnotationAssertion(rdfs:label ec:LearningPreference "learning preference"@en)
AnnotationAssertion(skos:definition ec:LearningPreference "The learning preference of the user based on the learning styles theory"@en)
AnnotationAssertion(skos:example ec:LearningPreference "Visual"@en)

# Class: ec:Recommendation (recommendation)

AnnotationAssertion(rdfs:comment ec:Recommendation "The recommendation in advanced systems can also be an action (take a small break), an exercise, a knowledge topic, a skill, or a learning path"@en)
AnnotationAssertion(rdfs:isDefinedBy ec:Recommendation <https://github.com/tibonto/educor>)
AnnotationAssertion(rdfs:label ec:Recommendation "recommendation"@en)
AnnotationAssertion(skos:definition ec:Recommendation "The output of the recommendation system algorithm. The system that reads user profile, content information, ratings and any available rules, in order to generate a meaningful recommendation."@en)
AnnotationAssertion(skos:example ec:Recommendation "The recommendation is \"Quadratic Equation\""@en)

# Class: :AnalysingPhase (analysing phase)

AnnotationAssertion(rdfs:label :AnalysingPhase "analysing phase"@en)
AnnotationAssertion(skos:definition :AnalysingPhase "The last phase in data life cycle."@en)
SubClassOf(:AnalysingPhase :DataLifeCyclePhase)
DisjointClasses(:AnalysingPhase :AssurancePhase)
DisjointClasses(:AnalysingPhase :CollectionPhase)
DisjointClasses(:AnalysingPhase :DescriptionPhase)
DisjointClasses(:AnalysingPhase :DiscoveryPhase)
DisjointClasses(:AnalysingPhase :IntegratePhase)
DisjointClasses(:AnalysingPhase :PlanningPhase)
DisjointClasses(:AnalysingPhase :PreservationPhase)

