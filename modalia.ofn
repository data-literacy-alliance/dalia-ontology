AnnotationAssertion(skos:definition :commentedOER "commentedOER"@en)
AnnotationAssertion(skos:definition :commentedOER "defines the OER that is commented in a user comment"@en)
ObjectPropertyDomain(:commentedOER :UserComment)
ObjectPropertyRange(:commentedOER ec:EducationalResource)

# Object Property: :covers (covers)

AnnotationAssertion(rdfs:label :covers "covers"@en)
