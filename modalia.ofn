Ontology(<https://purl.org/ontology/modalia#>
<https://purl.org/ontology/modalia#1.0.0>
Annotation(dcterms:abstract "The aim of the DALIA project is to build a platform for learning material for research data management (RDM) and data science. The platform is based on a knowledge graph. We introduce MoDALIA, the base ontology of DALIA knowledge graph. MoDALIA inherits some modules from EduCOR. It includes also modelling of micro-credentials and certificates."@en)
Annotation(dcterms:contributor <https://orcid.org/0000-0003-4423-4370>)
Annotation(dcterms:contributor "Dr. Abdelmoneim Amer Desouki (https://orcid.org/0000-0003-2083-1277), Technical University of Darmstadt (https://ror.org/05n911h24, https://isni.org/isni/0000000109401669)")
Annotation(dcterms:contributor "Dr. Charles Tapley Hoyt (https://orcid.org/0000-0003-4423-4370), RWTH Aachen University (https://ror.org/04xfq0f34, https://isni.org/isni/000000010728696X)")
Annotation(dcterms:contributor "Dr. Marc Fuhrmans (https://orcid.org/0000-0002-9826-018X), Technical University of Darmstadt (https://ror.org/05n911h24, https://isni.org/isni/0000000109401669)")
Annotation(dcterms:contributor "Dr. Petra C. Steiner (https://orcid.org/0000-0001-8997-2620), Technical University of Darmstadt (https://ror.org/05n911h24, https://isni.org/isni/0000000109401669)")
Annotation(dcterms:contributor "Frank Lange (https://orcid.org/0000-0002-9346-6031), RWTH Aachen University (https://ror.org/04xfq0f34, https://isni.org/isni/000000010728696X)")
Annotation(dcterms:created "2023-02-02")
Annotation(dcterms:creator "BMFTR DALIA project")
Annotation(dcterms:description "MoDALIA: An Ontology for Educational Material in Research Data Management (RDM) and Data Science.
The ontology is used for making a knowledge graph as a backend to platform for teaching, personal learning, and recommendation.
The ontology is developed in OWL in Protege 5.5.0."@en)
Annotation(dcterms:license <https://creativecommons.org/licenses/by/4.0/>)
Annotation(dcterms:modified "2025-10-14")
Annotation(dcterms:publisher "ULB TUDa – University and State Library, Technical University, Darmstadt, Germany")
Annotation(dcterms:title "MoDALIA Ontology"@en)
Annotation(vann:preferredNamespacePrefix "modalia")
Annotation(vann:preferredNamespaceUri "https://purl.org/ontology/modalia#"^^xsd:anyURI)
Annotation(doap:bug-database "https://git.rwth-aachen.de/dalia/dalia-ontology/-/issues"^^xsd:anyURI)
Annotation(<http://www.loc.gov/premis/rdf/v3/documentation> "https://dalia.pages.rwth-aachen.de/dalia-ontology/"^^xsd:anyURI)
Annotation(rdfs:comment "MoDALIA reuses elements from the following ontologies:
- DCTERMS = Dublin Core Terms  
- OWL = Web Ontology Language  
- RDF = Resource Description Framework  
- RDFS = RDF Schema  
- SCHEMA = schema.org  
- SKOS = Simple Knowledge Organization System  
- EC = EduCOR"@en)
Annotation(rdfs:label "MoDALIA")
Annotation(owl:versionInfo "v1.0.0"@en)

