AnnotationAssertion(rdfs:comment schema:teaches "The item being described is intended to help a person learn the competency or learning outcome defined by the referenced term."@en)
AnnotationAssertion(rdfs:label schema:teaches "teaches"@en)
DataPropertyDomain(schema:teaches ec:EducationalResource)
DataPropertyRange(schema:teaches xsd:string)

# Data Property: schema:timeRequired (timeRequired)

AnnotationAssertion(rdfs:comment schema:timeRequired "in format xsd:duration"@en)
AnnotationAssertion(rdfs:label schema:timeRequired "timeRequired"@en)
AnnotationAssertion(skos:example schema:timeRequired "\"PT7M11S\"^^xsd:duration")
DataPropertyDomain(schema:timeRequired ec:EducationalResource)
DataPropertyRange(schema:timeRequired xsd:duration)

# Data Property: schema:title (Job title)

AnnotationAssertion(rdfs:label schema:title "Job title"@en)
DataPropertyDomain(schema:title :Job)
DataPropertyRange(schema:title xsd:string)

# Data Property: schema:url (url)

AnnotationAssertion(rdfs:label schema:url "url"@en)
DataPropertyDomain(schema:url ec:EducationalResource)
DataPropertyRange(schema:url xsd:anyURI)

# Data Property: schema:version (version)

AnnotationAssertion(rdfs:comment schema:version "The version of the OER."@en)
AnnotationAssertion(rdfs:label schema:version "version"@en)
DataPropertyDomain(schema:version ec:EducationalResource)
DataPropertyRange(schema:version xsd:string)



