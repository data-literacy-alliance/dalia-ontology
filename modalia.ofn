# Class: m4i:Method (research method)

AnnotationAssertion(rdfs:isDefinedBy m4i:Method <http://w3id.org/nfdi4ing/metadata4ing>)
AnnotationAssertion(rdfs:label m4i:Method "research method"@en)
AnnotationAssertion(skos:definition m4i:Method "a method with which data was obtained"@en)
AnnotationAssertion(skos:example m4i:Method "bioassay, microscopy, measurement"@en)

