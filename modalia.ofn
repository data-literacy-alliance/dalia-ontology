############################
#   Annotation Properties
############################

# Annotation Property: dcterms:created (dcterms:created)

AnnotationPropertyRange(dcterms:created xsd:dateTime)

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description"@en)

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license"@en)
AnnotationAssertion(skos:definition dcterms:license "Property identifying the license of an Educational Resource"@en)
AnnotationPropertyRange(dcterms:license :License)
AnnotationPropertyDomain(dcterms:license ec:EducationalResource)

# Annotation Property: dcterms:title (title)

AnnotationAssertion(rdfs:label dcterms:title "title"@en)


############################
#   Object Properties
############################

# Object Property: bf:agent (bf:agent)

AnnotationAssertion(rdfs:comment bf:agent "agent"@en)
AnnotationAssertion(rdfs:isDefinedBy bf:agent <http://id.loc.gov/ontologies/bibframe>)
AnnotationAssertion(skos:definition bf:agent "Property that links a contribution to the agent (e.g., the person or organization making the contribution).")
ObjectPropertyDomain(bf:agent bf:Contribution)
ObjectPropertyRange(bf:agent :Contributor)

# Object Property: bf:contribution (contribution)

AnnotationAssertion(rdfs:comment bf:contribution "Property linking an OER to its contribution (e.g., editing)."@en)
AnnotationAssertion(rdfs:label bf:contribution "contribution"@en)
ObjectPropertyDomain(bf:contribution ec:EducationalResource)
ObjectPropertyRange(bf:contribution bf:Contribution)

# Object Property: bf:role (role)

AnnotationAssertion(rdfs:comment bf:role "Property that links a contribution to a role (e.g., contactPerson, editor)."@en)
AnnotationAssertion(rdfs:label bf:role "role"@en)
ObjectPropertyDomain(bf:role bf:Contribution)
ObjectPropertyRange(bf:role bf:Role)

# Object Property: dcterms:hasPart (hasPart)

AnnotationAssertion(rdfs:label dcterms:hasPart "hasPart"@en)
AnnotationAssertion(skos:prefLabel dcterms:hasPart "Has part"@en)
SubObjectPropertyOf(dcterms:hasPart dcterms:relation)
ObjectPropertyDomain(dcterms:hasPart ec:EducationalResource)
ObjectPropertyRange(dcterms:hasPart owl:Thing)

# Object Property: dcterms:isPartOf (isPartOf)

AnnotationAssertion(rdfs:label dcterms:isPartOf "isPartOf"@en)
AnnotationAssertion(skos:prefLabel dcterms:isPartOf "Is part of"@en)
SubObjectPropertyOf(dcterms:isPartOf dcterms:relation)
ObjectPropertyDomain(dcterms:isPartOf ec:EducationalResource)
ObjectPropertyRange(dcterms:isPartOf owl:Thing)

# Object Property: dcterms:isReferencedBy (isReferencedBy)

AnnotationAssertion(rdfs:label dcterms:isReferencedBy "isReferencedBy"@en)
AnnotationAssertion(skos:prefLabel dcterms:isReferencedBy "Is referenced by"@en)
SubObjectPropertyOf(dcterms:isReferencedBy dcterms:relation)
ObjectPropertyDomain(dcterms:isReferencedBy ec:EducationalResource)
ObjectPropertyRange(dcterms:isReferencedBy owl:Thing)

# Object Property: dcterms:isReplacedBy (isReplacedBy)

AnnotationAssertion(rdfs:label dcterms:isReplacedBy "isReplacedBy"@en)
AnnotationAssertion(skos:prefLabel dcterms:isReplacedBy "Is replaced by"@en)
SubObjectPropertyOf(dcterms:isReplacedBy dcterms:relation)
InverseObjectProperties(dcterms:isReplacedBy dcterms:replaces)
ObjectPropertyDomain(dcterms:isReplacedBy ec:EducationalResource)
ObjectPropertyRange(dcterms:isReplacedBy ec:EducationalResource)

# Object Property: dcterms:language (language)

AnnotationAssertion(rdfs:comment dcterms:language "language of resource"@en)
AnnotationAssertion(rdfs:label dcterms:language "language"@en)
ObjectPropertyDomain(dcterms:language ec:EducationalResource)
ObjectPropertyRange(dcterms:language <http://lexvo.org/ontology#Language>)

# Object Property: dcterms:references (references)

AnnotationAssertion(rdfs:label dcterms:references "references"@en)
AnnotationAssertion(skos:prefLabel dcterms:references "References"@en)
SubObjectPropertyOf(dcterms:references dcterms:relation)
ObjectPropertyDomain(dcterms:references ec:EducationalResource)
ObjectPropertyRange(dcterms:references owl:Thing)

# Object Property: dcterms:relation (relation)

AnnotationAssertion(rdfs:label dcterms:relation "relation"@en)
AnnotationAssertion(skos:definition dcterms:relation "The relation(s) to other resources.  It is required to identify the related resource by means of a URI."@en)
ObjectPropertyDomain(dcterms:relation ec:EducationalResource)
ObjectPropertyRange(dcterms:relation owl:Thing)

# Object Property: dcterms:replaces (replaces)

AnnotationAssertion(rdfs:label dcterms:replaces "replaces"@en)
AnnotationAssertion(skos:prefLabel dcterms:replaces "Replaces"@en)
