ObjectPropertyRange(:definesLearningPath :LearningPath)

# Object Property: :describes (describes)

AnnotationAssertion(rdfs:label :describes "describes"@en)
AnnotationAssertion(skos:prefLabel :describes "Describes"@en)
SubObjectPropertyOf(:describes dcterms:relation)
ObjectPropertyDomain(:describes ec:EducationalResource)
ObjectPropertyRange(:describes owl:Thing)

# Object Property: :educationalLevel (educational level)

AnnotationAssertion(rdfs:label :educationalLevel "educational level"@en)
