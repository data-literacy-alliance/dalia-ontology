AnnotationAssertion(rdfs:label :belongsToCluster "belongs to cluster"@en)
ObjectPropertyDomain(:belongsToCluster :RDMTopic)
ObjectPropertyRange(:belongsToCluster :RDMSubjectCluster)

# Object Property: :belongsToLearningPath (belongs to learning path)

