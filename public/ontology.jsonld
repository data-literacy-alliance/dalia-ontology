    "@id" : "https://purl.org/ontology/modalia#LearningResourceType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An informative talk given to an audience or class and usually prepared beforehand, or the text of such a talk."
