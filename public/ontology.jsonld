    "@language" : "en",
    "@value" : "Job Skill, ability to perform some tasks."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "skill"
  } ]
}, {
  "@id" : "https://purl.org/ontology/modalia#SoftwareDeveloper",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
