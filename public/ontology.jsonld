  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Learning Objective as defined in learning objective matrix (LZM)"
  } ]
}, {
  "@id" : "https://purl.org/ontology/modalia#LearningPath",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "learning path"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The learning path consists of a set of learning units (Educational Resources) in a specified order  to reach a learning objective."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "\"Hello world in python\", \"Comments in python\", \"Strings in python\""
  } ]
}, {
  "@id" : "https://purl.org/ontology/modalia#LearningPathStep",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "learning path step"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "One step of a learning path, it has an order and one educational resource. Optionally a learning path step can have a note for learner."
  } ]
}, {
  "@id" : "https://purl.org/ontology/modalia#LearningResourceType",
