    "@value" : "Kind of Source: Quotation. Source of definition: http://w3id.org/nfdi4ing/metadata4ing#Supervisor https://datacite-metadata-schema.readthedocs.io/en/4.6"
  } ]
}, {
  "@id" : "https://purl.org/ontology/modalia#TargetGroup",
