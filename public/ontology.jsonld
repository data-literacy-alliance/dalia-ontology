    "@language" : "en",
    "@value" : "rightsholder role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://w3id.org/nfdi4ing/metadata4ing#RightsHolder"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Person or institution owning or managing property rights, including intellectual property rights over the resource."
  } ],
