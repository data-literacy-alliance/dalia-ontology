  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://w3id.org/nfdi4ing/metadata4ing#Supervisor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Designated administrator over one or more groups/teams working to produce a resource, or over one or more steps of a development process."
  } ],
