    "@value" : "AnalyzePhase"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://purl.org/ontology/modalia#DataLifeCyclePhase"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://purl.org/ontology/modalia#AssurePhase"
  }, {
    "@id" : "https://purl.org/ontology/modalia#CollectPhase"
  }, {
    "@id" : "https://purl.org/ontology/modalia#DescribePhase"
  }, {
    "@id" : "https://purl.org/ontology/modalia#DiscoverPhase"
  }, {
    "@id" : "https://purl.org/ontology/modalia#IntegratePhase"
  }, {
    "@id" : "https://purl.org/ontology/modalia#PlanPhase"
  }, {
    "@id" : "https://purl.org/ontology/modalia#PreservePhase"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The last phase in data life cycle."
  } ]
}, {
  "@id" : "https://purl.org/ontology/modalia#AssurePhase",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
