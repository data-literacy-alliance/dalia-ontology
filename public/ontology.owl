        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#EducationalLevel"/>
        <rdfs:label xml:lang="en">educational level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#essentialFor -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#essentialFor">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#Skill"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Job"/>
        <rdfs:label xml:lang="en">essential for</rdfs:label>
        <skos:definition xml:lang="en">A property defining the essential skills for a certain job</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#givesProficiencyLevel -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#givesProficiencyLevel">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Proficiency"/>
        <rdfs:label xml:lang="en">gives proficiency level</rdfs:label>
        <skos:definition xml:lang="en">gives in the sense of produce/yield/leads to a proficiency level</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#hasLearningObjective -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#hasLearningObjective">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#EducationalResource"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#LearningPath"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#LearningObjective"/>
        <rdfs:label xml:lang="en">has learning objective</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#hasLearningPreference -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#hasLearningPreference">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#LearningPreference"/>
        <rdfs:label xml:lang="en">has learning preference</rdfs:label>
        <skos:definition xml:lang="en">The preferred learning style from VARK</skos:definition>
