            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#EducationalResource"/>
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#LearningPath"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#LearningGoalMatrixEntry"/>
