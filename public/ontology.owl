        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#Community"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:isDefinedBy xml:lang="en">defines the user who owns a specific community. There is only one owner to a specific community</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">hasOwner</rdfs:label>
    </owl:ObjectProperty>
    


