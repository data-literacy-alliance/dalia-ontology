    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://bibfra.me/vocab/relation/supportinghost -->


    <owl:ObjectProperty rdf:about="http://bibfra.me/vocab/relation/supportinghost">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Community"/>
        <rdfs:label xml:lang="en">supportinghost</rdfs:label>
        <skos:definition xml:lang="en">Associated community(ies) of the resource who are either the supporting organization/institution, or the recommender, or both. Here indicates supporting.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/agent -->


    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/agent">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Contribution"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Contributor"/>
        <rdfs:comment xml:lang="en">Property that links a contribution to the agent (e.g., the person or organization making the contribution).</rdfs:comment>
        <rdfs:comment xml:lang="en">agent</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/contribution -->


    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/contribution">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Contribution"/>
        <rdfs:comment xml:lang="en">Property linking an OER to its contribution (e.g., editing).</rdfs:comment>
        <rdfs:label xml:lang="en">contribution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/role -->


    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/role">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Contribution"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#ContributorRole"/>
        <rdfs:comment xml:lang="en">Property that links a contribution to a role (e.g., contactPerson, editor).</rdfs:comment>
        <rdfs:label xml:lang="en">role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ontology/rec/core#recommender -->


    <owl:ObjectProperty rdf:about="http://purl.org/ontology/rec/core#recommender">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Community"/>
        <rdfs:label xml:lang="en">recommender</rdfs:label>
        <skos:definition xml:lang="en">Associated community(ies) of the resource who are either the supporting organization/institution, or the recommender, or both.  Here indicates recommender</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/fabio/hasDiscipline -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/fabio/hasDiscipline">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#EducationalResource"/>
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#KnowledgeTopic"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Discipline"/>
        <rdfs:label>hasDiscipline</rdfs:label>
    </owl:ObjectProperty>
    


