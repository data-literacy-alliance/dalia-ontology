    <!-- https://purl.org/ontology/modalia#isDescribedBy -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#isDescribedBy">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">is described by</rdfs:label>
        <skos:definition xml:lang="en">A related resource that provides a description (detailed account) of the described resource. This can be a manual, an instruction, a documentation, a cookbook, a README file, or something similar.</skos:definition>
        <skos:editorialNote>Kind of Source: paraphrase. Source of definition: https://datacite-metadata-schema.readthedocs.io/_/downloads/en/4.6/pdf/ http://semanticscience.org/resource/SIO_000557</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is described by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#isDuplicateOf -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#isDuplicateOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">is duplicate of</rdfs:label>
        <skos:definition xml:lang="en">Duplicated metadata in DALIA platform</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#isIdenticalTo -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#isIdenticalTo">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">is identical to</rdfs:label>
        <skos:definition xml:lang="en">The related work is the same as the described resource but is saved on another location, maybe another institution.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://datacite-metadata-schema.readthedocs.io/_/downloads/en/4.6/pdf</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is identical to</skos:prefLabel>
    </owl:ObjectProperty>
    


