        <rdfs:range rdf:resource="http://purl.org/spar/fabio/Repository"/>
        <rdfs:comment xml:lang="en">Property linking an OER to a repository hosting it.</rdfs:comment>
        <rdfs:label xml:lang="en">repository</rdfs:label>
    </owl:ObjectProperty>
    


