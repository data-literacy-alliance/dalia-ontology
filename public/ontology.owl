            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#LearningObjective"/>
        <rdfs:label xml:lang="en">hasLearningObjective</rdfs:label>
    </owl:ObjectProperty>
    


