    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#langString -->


    <rdfs:Datatype rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://id.loc.gov/ontologies/bibframe/agent -->


    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/agent">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Contribution"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Contributor"/>
        <rdfs:isDefinedBy rdf:resource="http://id.loc.gov/ontologies/bibframe"/>
        <skos:definition>Property that links a contribution to the agent (e.g., the person or organization making the contribution).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/contribution -->


    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/contribution">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Contribution"/>
        <rdfs:label xml:lang="en">contribution</rdfs:label>
        <skos:definition xml:lang="en">Property linking an OER to its contribution (e.g., editing).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/role -->


    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/role">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Contribution"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Role"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:definition xml:lang="en">Property that links a contribution to a role (e.g., contactPerson, editor).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/hasPart -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/hasPart">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">hasPart</rdfs:label>
        <skos:definition xml:lang="en">A related resource that is included either physically or logically in the described resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/hasPart/</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Has part</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/isPartOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/isPartOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">isPartOf</rdfs:label>
        <skos:definition xml:lang="en">A related resource in which the described resource is physically or logically included.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/isPartOf/</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is part of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/isReferencedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/isReferencedBy">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">isReferencedBy</rdfs:label>
        <skos:definition xml:lang="en">A related resource that references, cites, or otherwise points to the described resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/isReferencedBy/</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is referenced by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/isReplacedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/isReplacedBy">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <owl:inverseOf rdf:resource="http://purl.org/dc/terms/replaces"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">isReplacedBy</rdfs:label>
        <skos:definition xml:lang="en">A related resource that supplants, displaces, or supersedes the described resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://purl.org/dc/terms/isReplacedBy</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is replaced by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/language -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/language">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://lexvo.org/ontology#Language"/>
        <rdfs:label xml:lang="en">language</rdfs:label>
        <skos:definition xml:lang="en">language of resource</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/references -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/references">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">references</rdfs:label>
        <skos:definition xml:lang="en">A related resource that is referenced, cited, or otherwise pointed to by the described resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/references/</skos:editorialNote>
        <skos:prefLabel xml:lang="en">References</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/relation -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/relation">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">relation</rdfs:label>
        <skos:definition xml:lang="en">The relation(s) to other resources.  It is required to identify the related resource by means of a URL.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: DIF 1.4, https://www.dublincore.org/specifications/dublin-core/dcmi-terms/elements11/relation/</skos:editorialNote>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/replaces -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/replaces">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">replaces</rdfs:label>
        <skos:definition xml:lang="en">A related resource that is supplanted, displaced, or superseded by the described resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://purl.org/dc/terms/replaces</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Replaces</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/requires -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/requires">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy>http://purl.org/dc/terms/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">requires</rdfs:label>
        <skos:definition xml:lang="en">A related resource that is required by the described resource to support its function, delivery, or coherence.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/fabio/hasDiscipline -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/fabio/hasDiscipline">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#EducationalResource"/>
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#KnowledgeTopic"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Discipline"/>
        <rdfs:label>hasDiscipline</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tibonto/educor#consistsOfKnowledge -->


    <owl:ObjectProperty rdf:about="https://github.com/tibonto/educor#consistsOfKnowledge">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#LearningPath"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#KnowledgeTopic"/>
        <rdfs:label>consistsOfKnowledge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/tibonto/educor#generatedFrom -->


    <owl:ObjectProperty rdf:about="https://github.com/tibonto/educor#generatedFrom">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#Recommendation"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:label xml:lang="en">generated from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#belongsToCluster -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#belongsToCluster">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#RDMTopic"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#RDMSubjectCluster"/>
        <rdfs:label xml:lang="en">belongs to cluster</rdfs:label>
        <skos:definition xml:lang="en">A property that relates RDM Topic to RDM Topic Cluster, similar to LZM</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#belongsToLearningPath -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#belongsToLearningPath">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#LearningPathStep"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#LearningPath"/>
        <rdfs:label xml:lang="en">belongs to learning path</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#belongsToPhase -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#belongsToPhase">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#RDMResource"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:label xml:lang="en">belongs to phase</rdfs:label>
        <skos:definition xml:lang="en">refers to the data life cycle phase that the resource covers</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#commentUserID -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#commentUserID">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#UserComment"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:label xml:lang="en">comment has user</rdfs:label>
        <skos:definition xml:lang="en">relates a user to their comment</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#commentedOER -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#commentedOER">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#UserComment"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">comment has OER</rdfs:label>
        <skos:definition xml:lang="en">commentedOER</skos:definition>
        <skos:definition xml:lang="en">defines the OER that is commented in a user comment</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#covers -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#covers">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#KnowledgeTopic"/>
        <rdfs:label xml:lang="en">covers</rdfs:label>
        <skos:definition xml:lang="en">Defines the topics covered in a learning resource</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#coversManagementOfDataDescribing -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#coversManagementOfDataDescribing">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#RDMResource"/>
        <rdfs:range rdf:resource="http://semanticscience.org/resource/SIO_000776"/>
        <rdfs:label xml:lang="en">covers management of data describing</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#coversManagementOfDataKind -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#coversManagementOfDataKind">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#RDMResource"/>
        <rdfs:range rdf:resource="http://edamontology.org/data_0006"/>
        <rdfs:label xml:lang="en">covers management of data kind</rdfs:label>
        <skos:definition xml:lang="en">A property that relates a RDMResource to data kind being managed</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#coversManagementOfDataObtainedWithMethod -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#coversManagementOfDataObtainedWithMethod">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#RDMResource"/>
        <rdfs:range rdf:resource="http://w3id.org/nfdi4ing/metadata4ing#Method"/>
        <rdfs:label xml:lang="en">covers management of data obtained with method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#coversManagementOfDataObtainedWithTool -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#coversManagementOfDataObtainedWithTool">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#RDMResource"/>
        <rdfs:range rdf:resource="http://w3id.org/nfdi4ing/metadata4ing#Tool"/>
        <rdfs:label xml:lang="en">covers management of data obtained with tool</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#createdBy -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#createdBy">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#Community"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:label xml:lang="en">created by</rdfs:label>
        <skos:definition xml:lang="en">A property defining the user who created a community</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#definesLearningPath -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#definesLearningPath">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#Recommendation"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#User"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#LearningPath"/>
        <rdfs:label xml:lang="en">defines learning path</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#describes -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#describes">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">describes</rdfs:label>
        <skos:definition xml:lang="en">A related resource that is described by the resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://datacite-metadata-schema.readthedocs.io/_/downloads/en/4.6/pdf/ http://semanticscience.org/resource/SIO_000563</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Describes</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#educationalLevel -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#educationalLevel">
