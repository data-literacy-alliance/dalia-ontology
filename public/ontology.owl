    <!-- https://w3id.org/citedcat-ap/isSupplementTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/citedcat-ap/isSupplementTo">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">isSupplementTo</rdfs:label>
        <skos:prefLabel xml:lang="en">Is supplement to</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/citedcat-ap/isSupplementedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/citedcat-ap/isSupplementedBy">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">isSupplementedBy</rdfs:label>
        <skos:prefLabel xml:lang="en">Is supplemented by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/format -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/format">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms"/>
        <rdfs:label xml:lang="en">file format</rdfs:label>
        <skos:definition>File format of the file representing the resource</skos:definition>
        <skos:example>PDF, AVI</skos:example>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">issued</rdfs:label>
        <skos:definition xml:lang="en">Date of formal issuance (e.g., publication) of the resource.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/rights -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/rights">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">rights</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/spar/fabio/hasSubtitle -->


    <owl:DatatypeProperty rdf:about="http://purl.org/spar/fabio/hasSubtitle">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has subtitle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/nfdi4ing/metadata4ing#hasRorId -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/nfdi4ing/metadata4ing#hasRorId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Community"/>
                    <rdf:Description rdf:about="https://schema.org/Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>https://ror.org/[0-9][0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][0-9][0-9]</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:isDefinedBy>http://w3id.org/nfdi4ing/metadata4ing</rdfs:isDefinedBy>
        <skos:altLabel xml:lang="en">has research organization registry id</skos:altLabel>
        <skos:altLabel xml:lang="de">hat Forschungsorganisationsid</skos:altLabel>
        <skos:definition xml:lang="en">A Research Organization Registry identifier that persistently and uniquely identifies a research organization</skos:definition>
        <skos:definition xml:lang="de">Ein persistenter Identifikator für Organisationen, vergeben durch die Research Organization Registry, der eine Forschungseinrichtung eindeutig identifiziert.</skos:definition>
        <skos:prefLabel xml:lang="en">has ROR ID</skos:prefLabel>
        <skos:prefLabel xml:lang="de">hat ROR ID</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/nfdi4ing/metadata4ing#orcidId -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/nfdi4ing/metadata4ing#orcidId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Contributor"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#User"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>https://orcid.org/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9X]</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <skos:definition xml:lang="en">Open Researcher and Contributor ID: an identifier, that allows unique identification of a person, usually active in research.</skos:definition>
        <skos:definition xml:lang="de">Open Researcher and Contributor ID: ein persistenter Identifikator, der eine in der Forschung tätige Person eindeutig identifiziert.</skos:definition>
        <skos:prefLabel xml:lang="en">has ORCID ID</skos:prefLabel>
        <skos:prefLabel xml:lang="de">hat ORCID ID</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#authorUnordered -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#authorUnordered">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A property that links OER to its authors in unordered way to improve perrformance.</rdfs:comment>
        <rdfs:comment xml:lang="en">authorUnordered</rdfs:comment>
        <rdfs:label xml:lang="en">has author (unordered)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#citation -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#citation">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Citation text of the OER (APA)</rdfs:comment>
        <rdfs:label xml:lang="en">citation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#commentDate -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#commentDate">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#UserComment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:label xml:lang="en">comment date</rdfs:label>
        <skos:definition xml:lang="en">The date of a user comment</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#commentID -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#commentID">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#UserComment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">comment has identifier</rdfs:label>
        <skos:definition xml:lang="en">ID of a user comment</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#commentText -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#commentText">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#UserComment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">comment text</rdfs:label>
        <skos:definition xml:lang="en">The OER of a user comment</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#hasDOI -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#hasDOI">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the DOI of the resource if exists.</rdfs:comment>
        <rdfs:label xml:lang="en">has DOI</rdfs:label>
        <skos:example>example: 10.18450/dataman/90</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#hasOrder -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#hasOrder">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#LearningPathStep"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Proficiency"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">has order</rdfs:label>
        <skos:definition xml:lang="en">Order of proficiency level, starting from 1 for Novice and increasing by proficiency</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#industry -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#industry">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#Job"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">job has industry</rdfs:label>
        <skos:definition xml:lang="en">The industry of a job</skos:definition>
        <skos:example>Research &amp; Academia</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#likesCount -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#likesCount">
