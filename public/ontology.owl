        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Community"/>
        <rdfs:label xml:lang="en">is member of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#isMoreProficientThan -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#isMoreProficientThan">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#Proficiency"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Proficiency"/>
        <rdfs:label xml:lang="en">is more proficient than</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#isNewVersionOf -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#isNewVersionOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <owl:inverseOf rdf:resource="https://purl.org/ontology/modalia#isPreviousVersionOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">is new version of</rdfs:label>
        <skos:definition xml:lang="en">The related work is a previous version, or edition of the described resource, of which the described resource has been modified or updated.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://datacite-metadata-schema.readthedocs.io/_/downloads/en/4.6/pdf  http://purl.org/dc/terms/isVersionOf</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is new version of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#isPreviousVersionOf -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#isPreviousVersionOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">is previous version of</rdfs:label>
        <skos:definition xml:lang="en">The related work is a new version, or edition of the described resource, where the new version has been modified or updated.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://datacite-metadata-schema.readthedocs.io/_/downloads/en/4.6/pdf  http://purl.org/dc/terms/isVersionOf</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is previous version of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#isSourceCodeOf -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#isSourceCodeOf">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">is source code of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#isTranslationOf -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#isTranslationOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">is translation of</rdfs:label>
        <skos:definition xml:lang="en">The related resouce that this OER has been translated from. When a resource is shared in one language, then later translated to another language, use “IsTranslationOf” to link the translation to the original.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://datacite-metadata-schema.readthedocs.io/_/downloads/en/4.6/pdf/</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is translation of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#isVersionOf -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#isVersionOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">is version of</rdfs:label>
        <skos:definition xml:lang="en">A related resource of which the described resource is a version, or edition. Can be used instead of isPreviousVersionOf and isNewVersionOf, if the sequence of versioning is unclear. </skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition:  http://purl.org/dc/terms/isVersionOf</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is version of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#nextPhase -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#nextPhase">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:label xml:lang="en">next phase</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#optionalFor -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#optionalFor">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#Skill"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Job"/>
        <rdfs:comment xml:lang="en">Defines the skills that are optional for a certain Job</rdfs:comment>
        <rdfs:label xml:lang="en">optional for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#prerequisites -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#prerequisites">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#KnowledgeTopic"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#KnowledgeTopic"/>
        <rdfs:label xml:lang="en">prerequisites</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#recommender -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#recommender">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#EducationalResource"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#LearningPath"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Community"/>
        <terms:description>A community which provides the recommendation of the OER. In the context of DIF, the recommending community is the organization or institution or project or body or online group which recommends the OER.</terms:description>
        <rdfs:label xml:lang="en">recommender</rdfs:label>
        <skos:definition xml:lang="en">Associated community(ies) of the resource who are either the supporting organization/institution, or the recommender, or both.  Here indicates recommender</skos:definition>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://purl.org/ontology/modalia#recommender"/>
        <owl:annotatedProperty rdf:resource="http://purl.org/dc/terms/description"/>
        <owl:annotatedTarget>A community which provides the recommendation of the OER. In the context of DIF, the recommending community is the organization or institution or project or body or online group which recommends the OER.</owl:annotatedTarget>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8997-2620"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0452-7075"/>
        <terms:source>DIF1.3</terms:source>
        <terms:source>recommendationontology</terms:source>
    </owl:Axiom>
    


    <!-- https://purl.org/ontology/modalia#requiresKnowledge -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#requiresKnowledge">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#Skill"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#KnowledgeTopic"/>
        <rdfs:label xml:lang="en">requires knowledge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#requiresProficiencyLevel -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#requiresProficiencyLevel">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Proficiency"/>
        <rdfs:label xml:lang="en">requires proficiency level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#solves -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#solves">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/kim/hcrt/assessment"/>
                    <rdf:Description rdf:about="https://w3id.org/kim/hcrt/questionnaire"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">solves</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#supportingHost -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#supportingHost">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Community"/>
        <rdfs:label xml:lang="en">supportinghost</rdfs:label>
        <skos:definition xml:lang="en">Associated community(ies) of the resource who are either the supporting organization/institution, or the recommender, or both. Here indicates supporting.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#teachesSkill -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#teachesSkill">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#Skill"/>
        <rdfs:label xml:lang="en">teaches skill</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#userBookmarks -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#userBookmarks">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">user bookmarks</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#userLikes -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#userLikes">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">user likes</rdfs:label>
        <skos:definition xml:lang="en">stores that user liked a given OER</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/ontology/modalia#userViews -->


    <owl:ObjectProperty rdf:about="https://purl.org/ontology/modalia#userViews">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">user views</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/author -->


    <owl:ObjectProperty rdf:about="https://schema.org/author">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
        <rdfs:comment xml:lang="en">Property linking an OER  to a list of authors.</rdfs:comment>
        <rdfs:label xml:lang="en">author</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/isBasedOn -->


    <owl:ObjectProperty rdf:about="https://schema.org/isBasedOn">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">isBasedOn</rdfs:label>
        <skos:definition xml:lang="en">A resource from which this work is derived or from which it is a modification or adaptation.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://schema.org/isBasedOn</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is based on</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/itemReviewed -->


    <owl:ObjectProperty rdf:about="https://schema.org/itemReviewed">
        <rdfs:domain rdf:resource="https://schema.org/Review"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <skos:definition xml:lang="en">The item that is being reviewed/rated.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/citedcat-ap/continues -->


    <owl:ObjectProperty rdf:about="https://w3id.org/citedcat-ap/continues">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <owl:inverseOf rdf:resource="https://w3id.org/citedcat-ap/isContinuedBy"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">continues</rdfs:label>
        <skos:definition xml:lang="en">A related resource which is the direct predecessor of the described resource. This applies to a story, a series of lessons, a serial, a journal etc. Predecessors typically form part of a common whole - such as a  series of lectures.</skos:definition>
        <skos:editorialNote>Kind of Source: S, M. Source of definition: https://github.com/europeana/metis-schema/blob/master/src/main/resources/schema_xsds/EDM-COMMON-MAIN.xsd  https://datacite-metadata-schema.readthedocs.io/_/downloads/en/4.6/pdf/</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Continues</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/citedcat-ap/isCompiledBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/citedcat-ap/isCompiledBy">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">isCompiledBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/citedcat-ap/isContinuedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/citedcat-ap/isContinuedBy">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:label xml:lang="en">isContinuedBy</rdfs:label>
        <skos:definition xml:lang="en">A related resource which is the direct continuation of the described resource. This applies to a story, a series of lessons, a serial, a journal etc. Successors typically form part of a common whole - such as a  series of lectures.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://github.com/europeana/metis-schema/blob/master/src/main/resources/schema_xsds/EDM-COMMON-MAIN.xsd</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is continued by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/citedcat-ap/isSupplementTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/citedcat-ap/isSupplementTo">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">isSupplementTo</rdfs:label>
        <skos:definition xml:lang="en">Resource that is complemented by the described augmenting resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://id.loc.gov/ontologies/bibframe/supplement.rdf</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is supplement to</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/citedcat-ap/isSupplementedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/citedcat-ap/isSupplementedBy">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">isSupplementedBy</rdfs:label>
        <skos:definition xml:lang="en">Resource that complements the predominant described resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://id.loc.gov/ontologies/bibframe/supplementTo.rdf</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Is supplemented by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/format -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/format">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms"/>
        <rdfs:label xml:lang="en">file format</rdfs:label>
        <skos:definition>File format of the file representing the resource</skos:definition>
        <skos:example>PDF, AVI</skos:example>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">issued</rdfs:label>
        <skos:definition xml:lang="en">Date of formal issuance (e.g., publication) of the resource.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/rights -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/rights">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">rights</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/spar/fabio/hasSubtitle -->


    <owl:DatatypeProperty rdf:about="http://purl.org/spar/fabio/hasSubtitle">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has subtitle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/nfdi4ing/metadata4ing#hasRorId -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/nfdi4ing/metadata4ing#hasRorId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Community"/>
                    <rdf:Description rdf:about="https://schema.org/Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>https://ror.org/[0-9][0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][0-9][0-9]</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:isDefinedBy>http://w3id.org/nfdi4ing/metadata4ing</rdfs:isDefinedBy>
        <skos:altLabel xml:lang="en">has research organization registry id</skos:altLabel>
        <skos:altLabel xml:lang="de">hat Forschungsorganisationsid</skos:altLabel>
        <skos:definition xml:lang="en">A Research Organization Registry identifier that persistently and uniquely identifies a research organization</skos:definition>
        <skos:definition xml:lang="de">Ein persistenter Identifikator für Organisationen, vergeben durch die Research Organization Registry, der eine Forschungseinrichtung eindeutig identifiziert.</skos:definition>
        <skos:prefLabel xml:lang="en">has ROR ID</skos:prefLabel>
        <skos:prefLabel xml:lang="de">hat ROR ID</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/nfdi4ing/metadata4ing#orcidId -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/nfdi4ing/metadata4ing#orcidId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Contributor"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#User"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>https://orcid.org/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9X]</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <skos:definition xml:lang="en">Open Researcher and Contributor ID: an identifier, that allows unique identification of a person, usually active in research.</skos:definition>
        <skos:definition xml:lang="de">Open Researcher and Contributor ID: ein persistenter Identifikator, der eine in der Forschung tätige Person eindeutig identifiziert.</skos:definition>
        <skos:prefLabel xml:lang="en">has ORCID ID</skos:prefLabel>
        <skos:prefLabel xml:lang="de">hat ORCID ID</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#authorUnordered -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#authorUnordered">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A property that links OER to its authors in unordered way to improve perrformance.</rdfs:comment>
        <rdfs:comment xml:lang="en">authorUnordered</rdfs:comment>
        <rdfs:label xml:lang="en">has author (unordered)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#citation -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#citation">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Citation text of the OER (APA)</rdfs:comment>
        <rdfs:label xml:lang="en">citation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#commentDate -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#commentDate">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#UserComment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:label xml:lang="en">comment date</rdfs:label>
        <skos:definition xml:lang="en">The date of a user comment</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#commentID -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#commentID">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#UserComment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">comment has identifier</rdfs:label>
        <skos:definition xml:lang="en">ID of a user comment</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#commentText -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#commentText">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#UserComment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">comment text</rdfs:label>
        <skos:definition xml:lang="en">The OER of a user comment</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#hasDOI -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#hasDOI">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">the DOI of the resource if exists.</rdfs:comment>
        <rdfs:label xml:lang="en">has DOI</rdfs:label>
        <skos:example>example: 10.18450/dataman/90</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#hasOrder -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#hasOrder">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#LearningPathStep"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Proficiency"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">has order</rdfs:label>
        <skos:definition xml:lang="en">Order of proficiency level, starting from 1 for Novice and increasing by proficiency</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#industry -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#industry">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#Job"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">job has industry</rdfs:label>
        <skos:definition xml:lang="en">The industry of a job</skos:definition>
        <skos:example>Research &amp; Academia</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#likesCount -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#likesCount">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">likes count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#notesForLearner -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#notesForLearner">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#EducationalResource"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#LearningPathStep"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has notes for learner</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#studyPlan -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#studyPlan">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#LearningPath"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:label xml:lang="en">study plan</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#viewCount -->


    <owl:DatatypeProperty rdf:about="https://purl.org/ontology/modalia#viewCount">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">view count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/abstract -->


    <owl:DatatypeProperty rdf:about="https://schema.org/abstract">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">An abstract is a short description that summarizes an OER.</rdfs:comment>
        <rdfs:label xml:lang="en">abstract</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/accessibilityFeature -->


    <owl:DatatypeProperty rdf:about="https://schema.org/accessibilityFeature">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">accessibilityfeature</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/datePublished -->


    <owl:DatatypeProperty rdf:about="https://schema.org/datePublished">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">Publication Date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/downloadUrl -->


    <owl:DatatypeProperty rdf:about="https://schema.org/downloadUrl">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">If the OER can be downloaded, URL to download it.</rdfs:comment>
        <rdfs:label xml:lang="en">has download URL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/email -->


    <owl:DatatypeProperty rdf:about="https://schema.org/email">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/familyName -->


    <owl:DatatypeProperty rdf:about="https://schema.org/familyName">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Contributor"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#User"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Family name. In the U.S., the last name of a Person.</rdfs:comment>
        <rdfs:label xml:lang="en">familyName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/fileSize -->


    <owl:DatatypeProperty rdf:about="https://schema.org/fileSize">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">fileSize</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/givenName -->


    <owl:DatatypeProperty rdf:about="https://schema.org/givenName">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Contributor"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#User"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">givenName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/identifier -->


    <owl:DatatypeProperty rdf:about="https://schema.org/identifier">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/image -->


    <owl:DatatypeProperty rdf:about="https://schema.org/image">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Property linking an OER to an image representing it.</rdfs:comment>
        <rdfs:label xml:lang="en">image</rdfs:label>
        <skos:definition xml:lang="en">A resource has the media type image if it mainly consists of (a) still image(s).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/isAccessibleForFree -->


    <owl:DatatypeProperty rdf:about="https://schema.org/isAccessibleForFree">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">isAccessibleForFree</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/keywords -->


    <owl:DatatypeProperty rdf:about="https://schema.org/keywords">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Keywords or tags used to describe some item.</rdfs:comment>
        <rdfs:label xml:lang="en">keywords</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/ratingValue -->


    <owl:DatatypeProperty rdf:about="https://schema.org/ratingValue">
        <rdfs:domain rdf:resource="https://schema.org/Rating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>rating value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/reviewBody -->


    <owl:DatatypeProperty rdf:about="https://schema.org/reviewBody">
        <rdfs:domain rdf:resource="https://schema.org/Review"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">review body</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/reviewRating -->


    <owl:DatatypeProperty rdf:about="https://schema.org/reviewRating">
        <rdfs:domain rdf:resource="https://schema.org/Review"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">rating according to the reviewer of the OER</rdfs:comment>
        <rdfs:label xml:lang="en">review rating</rdfs:label>
        <skos:definition xml:lang="en">The rating given in this review. Note that reviews can themselves be rated. The reviewRating applies to rating given by the review.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/teaches -->


    <owl:DatatypeProperty rdf:about="https://schema.org/teaches">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The item being described is intended to help a person learn the competency or learning outcome defined by the referenced term.</rdfs:comment>
        <rdfs:label xml:lang="en">teaches</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/timeRequired -->


    <owl:DatatypeProperty rdf:about="https://schema.org/timeRequired">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="en">in format xsd:duration</rdfs:comment>
        <rdfs:label xml:lang="en">timeRequired</rdfs:label>
        <skos:example>&quot;PT7M11S&quot;^^xsd:duration</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/title -->


    <owl:DatatypeProperty rdf:about="https://schema.org/title">
        <rdfs:domain rdf:resource="https://purl.org/ontology/modalia#Job"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Job title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/url -->


    <owl:DatatypeProperty rdf:about="https://schema.org/url">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">url</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/version -->


    <owl:DatatypeProperty rdf:about="https://schema.org/version">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The version of the OER.</rdfs:comment>
        <rdfs:label xml:lang="en">version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://edamontology.org/data_0006 -->


    <owl:Class rdf:about="http://edamontology.org/data_0006">
        <rdfs:label xml:lang="en">data</rdfs:label>
        <skos:definition xml:lang="en">Kind of data being managed</skos:definition>
    </owl:Class>
    


    <!-- http://id.loc.gov/ontologies/bibframe/Contribution -->


    <owl:Class rdf:about="http://id.loc.gov/ontologies/bibframe/Contribution">
        <skos:definition xml:lang="en">A contribution to an OER, including agent and role information.</skos:definition>
    </owl:Class>
    


    <!-- http://id.loc.gov/ontologies/bibframe/Role -->


    <owl:Class rdf:about="http://id.loc.gov/ontologies/bibframe/Role">
        <rdfs:label xml:lang="en">contributor role</rdfs:label>
        <skos:definition xml:lang="en">Function played or provided by a contributor, e.g., author or illustrator.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://id.loc.gov/ontologies/bibframe.html#c_Role</skos:editorialNote>
        <skos:example xml:lang="en">Editor</skos:example>
    </owl:Class>
    


    <!-- http://lexvo.org/ontology#Language -->


    <owl:Class rdf:about="http://lexvo.org/ontology#Language">
        <rdfs:label xml:lang="en">language</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q315"/>
        <skos:definition xml:lang="en">Natural language</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OCCO_25401100 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OCCO_25401100">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">archivist</rdfs:label>
        <skos:definition xml:lang="en"> A person who appraises, edits, and directs safekeeping of permanent records and historically valuable documents. Participates in research activities based on archival materials.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://purl.obolibrary.org/obo/OCCO_25401100</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Archivist</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OCCO_25402200 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OCCO_25402200">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">librarian</rdfs:label>
        <skos:prefLabel xml:lang="en">Librarian</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/T4FS_0000178 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/T4FS_0000178">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">data steward</rdfs:label>
        <skos:prefLabel xml:lang="en">Data Steward</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.org/ontology/bibo/Article -->


    <owl:Class rdf:about="http://purl.org/ontology/bibo/Article">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing OERs that are articles (e.g academic article)</rdfs:comment>
        <rdfs:label xml:lang="en">article</rdfs:label>
        <skos:definition xml:lang="en">A written composition in prose, usually nonfiction, on a specific topic, forming an independent part of a book or other publication, as a newspaper or magazine.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://purl.org/ontology/bibo/Article</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Article</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.org/ontology/bibo/Book -->


    <owl:Class rdf:about="http://purl.org/ontology/bibo/Book">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">book</rdfs:label>
        <skos:definition xml:lang="en">Class representing OER which is a book.</skos:definition>
        <skos:prefLabel xml:lang="en">Book</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.org/ontology/bibo/Report -->


    <owl:Class rdf:about="http://purl.org/ontology/bibo/Report">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">report</rdfs:label>
        <skos:definition xml:lang="en">A document describing an account or statement describing in detail an event, situation, or the like, usually as the result of observation, inquiry, etc. </skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://purl.org/ontology/bibo/Report</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Report</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.org/ontology/bibo/Thesis -->


    <owl:Class rdf:about="http://purl.org/ontology/bibo/Thesis">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">thesis</rdfs:label>
        <skos:definition xml:lang="en">A document created to summarize research findings associated with the completion of an academic degree.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://purl.org/ontology/bibo/Thesis</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Thesis</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.org/ontology/bibo/Webpage -->


    <owl:Class rdf:about="http://purl.org/ontology/bibo/Webpage">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">webpage</rdfs:label>
        <skos:definition xml:lang="en">A web page is an online document available (at least initially) on the world wide web. </skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://purl.org/ontology/bibo/Webpage  </skos:editorialNote>
        <skos:prefLabel xml:lang="en">Web page</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.org/ontology/bibo/Workshop -->


    <owl:Class rdf:about="http://purl.org/ontology/bibo/Workshop">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/ontology/bibo"/>
        <rdfs:label xml:lang="en">workshop</rdfs:label>
        <skos:definition xml:lang="en">A seminar, discussion group, or the like, that emphasizes the exchange of ideas and the demonstration and application of techniques, skills, etc. in a specialized field or occupation.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://purl.org/ontology/bibo/Workshop   http://vocab.getty.edu/page/aat/300069765</skos:editorialNote>
        <skos:prefLabel xml:lang="en">workshop</skos:prefLabel>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000776 -->


    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000776">
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org"/>
        <rdfs:label xml:lang="en">object</rdfs:label>
        <skos:definition xml:lang="en">an object that is described (chemical substance, living organism, building, ...)</skos:definition>
        <skos:example xml:lang="en">mouse cells</skos:example>
    </owl:Class>
    


    <!-- http://w3id.org/nfdi4ing/metadata4ing#Method -->


    <owl:Class rdf:about="http://w3id.org/nfdi4ing/metadata4ing#Method">
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/nfdi4ing/metadata4ing"/>
        <rdfs:label xml:lang="en">research method</rdfs:label>
        <skos:definition xml:lang="en">a method with which data was obtained</skos:definition>
        <skos:example xml:lang="en">bioassay, microscopy, measurement</skos:example>
    </owl:Class>
    


    <!-- http://w3id.org/nfdi4ing/metadata4ing#Tool -->


    <owl:Class rdf:about="http://w3id.org/nfdi4ing/metadata4ing#Tool">
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/nfdi4ing/metadata4ing"/>
        <rdfs:label xml:lang="en">tool</rdfs:label>
        <skos:definition xml:lang="en">a tool with which data was obtained (microscope, sensor, ...)</skos:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#List -->


    <owl:Class rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
    


    <!-- https://github.com/tibonto/educor#EducationalResource -->


    <owl:Class rdf:about="https://github.com/tibonto/educor#EducationalResource">
        <rdfs:isDefinedBy rdf:resource="https://github.com/tibonto/educor"/>
        <rdfs:label xml:lang="en">educational resource</rdfs:label>
        <skos:definition xml:lang="en">Any educational resources online or offline</skos:definition>
        <skos:example xml:lang="en">A video describing how lists work in Python programming language</skos:example>
    </owl:Class>
    


    <!-- https://github.com/tibonto/educor#KnowledgeTopic -->


    <owl:Class rdf:about="https://github.com/tibonto/educor#KnowledgeTopic">
        <owl:disjointWith rdf:resource="https://purl.org/ontology/modalia#Skill"/>
        <rdfs:isDefinedBy rdf:resource="https://github.com/tibonto/educor"/>
        <rdfs:label xml:lang="en">knowledge topic</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://w3id.org/ccso/ccso#Topic</rdfs:seeAlso>
        <skos:definition xml:lang="en">A single node representing a learning module based on the domain ontology. It contains all the learning material for the specific learning module.</skos:definition>
        <skos:example xml:lang="en">A knowledge topic can be the “Quadratic equations” in the domain of Mathematics Algebra</skos:example>
    </owl:Class>
    


    <!-- https://github.com/tibonto/educor#LearningPreference -->


    <owl:Class rdf:about="https://github.com/tibonto/educor#LearningPreference">
        <rdfs:comment xml:lang="en">It is based on the theory which identifies four learning styles (visual, auditory, reading, and kinesthetic).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://github.com/tibonto/educor"/>
        <rdfs:label xml:lang="en">learning preference</rdfs:label>
        <skos:definition xml:lang="en">The learning preference of the user based on the learning styles theory</skos:definition>
        <skos:example xml:lang="en">Visual</skos:example>
    </owl:Class>
    


    <!-- https://github.com/tibonto/educor#Recommendation -->


    <owl:Class rdf:about="https://github.com/tibonto/educor#Recommendation">
        <rdfs:comment xml:lang="en">The recommendation in advanced systems can also be an action (take a small break), an exercise, a knowledge topic, a skill, or a learning path</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://github.com/tibonto/educor"/>
        <rdfs:label xml:lang="en">recommendation</rdfs:label>
        <skos:definition xml:lang="en">The output of the recommendation system algorithm. The system that reads user profile, content information, ratings and any available rules, in order to generate a meaningful recommendation.</skos:definition>
        <skos:example xml:lang="en">The recommendation is &quot;Quadratic Equation&quot;</skos:example>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#AnalysingPhase -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#AnalysingPhase">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <owl:disjointWith rdf:resource="https://purl.org/ontology/modalia#AssurancePhase"/>
        <owl:disjointWith rdf:resource="https://purl.org/ontology/modalia#CollectionPhase"/>
        <owl:disjointWith rdf:resource="https://purl.org/ontology/modalia#DescriptionPhase"/>
        <owl:disjointWith rdf:resource="https://purl.org/ontology/modalia#DiscoveryPhase"/>
        <owl:disjointWith rdf:resource="https://purl.org/ontology/modalia#IntegratePhase"/>
        <owl:disjointWith rdf:resource="https://purl.org/ontology/modalia#PlanningPhase"/>
        <owl:disjointWith rdf:resource="https://purl.org/ontology/modalia#PreservationPhase"/>
        <rdfs:label xml:lang="en">analysing phase</rdfs:label>
        <skos:definition xml:lang="en">The last phase in data life cycle.</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#AssurancePhase -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#AssurancePhase">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:label xml:lang="en">assurance phase</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#BachelorStudent -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#BachelorStudent">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">bachelor student</rdfs:label>
        <rdfs:seeAlso>http://vivoweb.org/ontology/core#UndergraduateStudent</rdfs:seeAlso>
        <skos:definition xml:lang="en">A student of Higher Education who is attending a university or college (e.g. in USA, GB) for achieving level 6 of the 2011 version of the International Standard Classification of Education structure.</skos:definition>
        <skos:prefLabel xml:lang="en">Bachelor Student</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#BestPractices -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#BestPractices">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing OERs that are best practices in scientific area.</rdfs:comment>
        <rdfs:label xml:lang="en">best practices</rdfs:label>
        <skos:definition xml:lang="en">A process or method that has been shown to work well, succeeds in achieving its objective(s), is acknowledged and therefore can be recommended as an approach.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: ISO 22163:2024, 4</skos:editorialNote>
        <skos:prefLabel xml:lang="en">best practices</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Code -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Code">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#MediaType"/>
        <rdfs:comment xml:lang="en">Class representing OER which are code like Jupyternotebook.</rdfs:comment>
        <rdfs:label xml:lang="en">code</rdfs:label>
        <skos:definition xml:lang="en">A resource has the media type code if it mainly consists of programming code.</skos:definition>
        <skos:prefLabel xml:lang="en">code</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#CodeNotebook -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#CodeNotebook">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">code notebook</rdfs:label>
        <skos:definition xml:lang="en">Program used to mix code, comments, and visualizations in an interactive document called notebook that can be shared, reused, and reworked in a web browser. </skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://www.wikidata.org/wiki/Q70357595 </skos:editorialNote>
        <skos:example xml:lang="en">Jupyter Notebook</skos:example>
        <skos:prefLabel xml:lang="en">Code Notebook</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#CollectionPhase -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#CollectionPhase">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:label xml:lang="en">collection phase</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Community -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Community">
        <rdfs:label xml:lang="en">community</rdfs:label>
        <skos:definition xml:lang="en">A Community gathers users (members) and educational resources/learning paths similar  to Zenodo communities</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#ContentProvider -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#ContentProvider">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">content provider</rdfs:label>
        <rdfs:seeAlso>https://bibfra.me/view/rare/lite/provider</rdfs:seeAlso>
        <skos:definition xml:lang="en">Person or group who is providing (an) OER.</skos:definition>
        <skos:prefLabel xml:lang="en">Content Provider</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#ContentQuality -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#ContentQuality">
        <rdfs:label xml:lang="en">content quality</rdfs:label>
        <skos:definition xml:lang="en">Educational quality of an OER</skos:definition>
        <skos:example xml:lang="en">High quality</skos:example>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Contributor -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Contributor">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://schema.org/Organization"/>
                    <rdf:Description rdf:about="https://schema.org/Person"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Contributed to OER with some contribution type</rdfs:comment>
        <rdfs:label xml:lang="en">contributor</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Cookbook -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Cookbook">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">cookbook</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://www.wikidata.org/wiki/Q3689925</rdfs:seeAlso>
        <skos:definition xml:lang="en">A thematic collection of useful procedures in IT.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://www.wikidata.org/wiki/Q3689925</skos:editorialNote>
        <skos:prefLabel xml:lang="en">cookbook</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#CuratorRole -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#CuratorRole">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#UserRole"/>
        <rdfs:label xml:lang="en">curator user role</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#DataLifeCyclePhase -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#DataLifeCyclePhase">
        <rdfs:label xml:lang="en">data life cycle phase</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://towson.libguides.com/dataresearch/datamangement/dldataone</rdfs:seeAlso>
        <skos:definition xml:lang="en">One of the phases of data life cycle.</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#DescriptionPhase -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#DescriptionPhase">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:label xml:lang="en">description phase</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Discipline -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Discipline">
        <rdfs:label xml:lang="en">discipline</rdfs:label>
        <rdfs:seeAlso xml:lang="en">http://purl.org/spar/fabio/SubjectDiscipline</rdfs:seeAlso>
        <skos:definition xml:lang="en">knowledge of a specific, specialized discipline or field</skos:definition>
        <skos:example xml:lang="en">e.g Engineering</skos:example>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#DiscoveryPhase -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#DiscoveryPhase">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:label xml:lang="en">discovery phase</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#EducationalLevel -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#EducationalLevel">
        <rdfs:label xml:lang="en">education level</rdfs:label>
        <skos:definition xml:lang="en">The educational level of a user: Bachlors, Masters or PhD</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#FiveStarRating -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#FiveStarRating">
        <rdfs:subClassOf rdf:resource="https://schema.org/Rating"/>
        <rdfs:label xml:lang="en">five star rating</rdfs:label>
        <skos:definition xml:lang="en">Standard five star rating, min value 1 maximum 5</skos:definition>
        <schema:bestRating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</schema:bestRating>
        <schema:worstRating rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</schema:worstRating>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#FreeLicense -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#FreeLicense">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#License"/>
        <rdfs:label xml:lang="en">free license</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#IntegratePhase -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#IntegratePhase">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:label xml:lang="en">integration phase</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Job -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Job">
        <rdfs:label xml:lang="en">job</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://schema.org/Occupation</rdfs:seeAlso>
        <skos:definition xml:lang="en">name of a profession</skos:definition>
        <skos:example xml:lang="en">Software Developer</skos:example>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#LearnerRole -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#LearnerRole">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#UserRole"/>
        <rdfs:label xml:lang="en">learner role</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#LearningObjective -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#LearningObjective">
        <rdfs:comment xml:lang="en">The Learning Goal can vary depending on the personalisation level. For example a user might care to learn some specific topics and not all the skill set.</rdfs:comment>
        <rdfs:label xml:lang="en">learning objective</rdfs:label>
        <rdfs:seeAlso>https://github.com/tibonto/educor#LearningGoal</rdfs:seeAlso>
        <skos:definition xml:lang="en">Learning Objective as defined in learning objective matrix (LZM)</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#LearningPath -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#LearningPath">
        <rdfs:label xml:lang="en">learning path</rdfs:label>
        <skos:definition xml:lang="en">The learning path consists of a set of learning units (Educational Resources) in a specified order  to reach a learning objective.</skos:definition>
        <skos:example xml:lang="en">&quot;Hello world in python&quot;, &quot;Comments in python&quot;, &quot;Strings in python&quot;</skos:example>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#LearningPathStep -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#LearningPathStep">
        <rdfs:label xml:lang="en">learning path step</rdfs:label>
        <skos:definition xml:lang="en">One step of a learning path, it has an order and one educational resource. Optionally a learning path step can have a note for learner.</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#LearningResourceType -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#LearningResourceType">
        <rdfs:label xml:lang="en">learning resource type</rdfs:label>
        <skos:definition xml:lang="en">The type of the learning resource can be lecture, experiment, Assessment, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Lecture -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Lecture">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing OERs that are lectures.</rdfs:comment>
        <rdfs:label xml:lang="en">lecture</rdfs:label>
        <skos:definition xml:lang="en">An informative talk given to an audience or class and usually prepared beforehand, or the text of such a talk.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: ISO/IEC 19788-5:2014, 30</skos:editorialNote>
        <skos:prefLabel xml:lang="en">lecture</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#License -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#License">
        <rdfs:label xml:lang="en">license</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#MastersStudent -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#MastersStudent">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">master&apos;s student</rdfs:label>
        <rdfs:seeAlso>http://w3id.org/roh#MastersStudent</rdfs:seeAlso>
        <skos:definition xml:lang="en">A student of Higher Education who is attending a university or college (e.g. in USA, GB) for achieving level 7 of the 2011 version of the International Standard Classification of Education structure.</skos:definition>
        <skos:prefLabel xml:lang="en">Master&apos;s Student</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#MediaType -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#MediaType">
        <rdfs:label xml:lang="en">media type</rdfs:label>
        <skos:definition xml:lang="en">General type of data content encoded in a computer file. Digital media type of the resource. To be used with user preferences according to VARK learning style.</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Multipart -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Multipart">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#MediaType"/>
        <rdfs:label xml:lang="en">multipart</rdfs:label>
        <skos:definition xml:lang="en">A resource has the media type multipart if it consists of more than one part, each of a different media type.</skos:definition>
        <skos:prefLabel xml:lang="en">Multipart</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#MuseumProfessional -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#MuseumProfessional">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">museum professional</rdfs:label>
        <skos:definition xml:lang="en">A person who works in a museum and has specialized knowledge, training, or expertise related to museums and their functions.</skos:definition>
        <skos:prefLabel xml:lang="en">Museum Professional</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#PhDStudent -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#PhDStudent">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">PhD student</rdfs:label>
        <rdfs:seeAlso>http://vivoweb.org/ontology/core#GraduateStudent</rdfs:seeAlso>
        <skos:definition xml:lang="en">A student in PhD degree</skos:definition>
        <skos:prefLabel xml:lang="en">PhD student</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#PlanningPhase -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#PlanningPhase">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:label xml:lang="en">planning phase</rdfs:label>
        <skos:definition xml:lang="en">First phase in data life cycle. Description of the data that will be compiled.</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Podcast -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Podcast">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">podcast</rdfs:label>
        <skos:definition xml:lang="en">The learning resource type podcast is an episodic series of digital audio or video files or an episode of that, which a user can download and listen to.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://schema.org/PodcastSeries</skos:editorialNote>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Poster -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Poster">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing OERs that are Posters</rdfs:comment>
        <rdfs:label xml:lang="en">poster</rdfs:label>
        <skos:definition xml:lang="en">A large, usually printed placard, bill, or announcement, often illustrated, that is posted to advertise or publicize something.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://schema.org/Poster</skos:editorialNote>
        <skos:prefLabel xml:lang="en">poster</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#PreservationPhase -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#PreservationPhase">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#DataLifeCyclePhase"/>
        <rdfs:label xml:lang="en">preservation phase</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Proficiency -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Proficiency">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Beginner"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Competent"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Expert"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Novice"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Proficient"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">proficiency</rdfs:label>
        <skos:definition xml:lang="en">Benner’s Novice to Expert
The five stages of proficiency in the novice to expert model are: novice, advanced beginner, competent, proficient, and expert (Benner, 1982).</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#ProprietaryLicense -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#ProprietaryLicense">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#License"/>
        <rdfs:label xml:lang="en">proprietary license</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#RDMResource -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#RDMResource">
        <rdfs:subClassOf rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:comment xml:lang="en">OER related to Research Data Management</rdfs:comment>
        <rdfs:label xml:lang="en">RDM resource</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#RDMSkill -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#RDMSkill">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#Skill"/>
        <rdfs:comment xml:lang="en">Research Data Managment Skill</rdfs:comment>
        <rdfs:label xml:lang="en">RDM skill</rdfs:label>
        <skos:definition xml:lang="en">The ability to carry out tasks.</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#RDMSubjectCluster -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#RDMSubjectCluster">
        <rdfs:label xml:lang="en">RDM subject cluster</rdfs:label>
        <skos:definition xml:lang="en">Cluster of RDM topics areas. Matches Subject area in Learning Objective Matrix version 3 ( https://zenodo.org/records/15846806 )</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#RDMTopic -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#RDMTopic">
        <rdfs:subClassOf rdf:resource="https://github.com/tibonto/educor#KnowledgeTopic"/>
        <rdfs:label xml:lang="en">RDM topic</rdfs:label>
        <skos:definition xml:lang="en">Topic related to research data management</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Researcher -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Researcher">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">researcher</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://www.wikidata.org/wiki/Q1650915</rdfs:seeAlso>
        <skos:definition xml:lang="en">A person or a group who attempts to answer research questions,  establish facts, and reach new conclusions by  systematically investigating and studying materials and sources, observing, or conducting experiments in a particular field relevant to the questions.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://framenet.icsi.berkeley.edu/fnReports/data/frame/Research.xml and https://framenet.icsi.berkeley.edu/fnReports/data/lu/lu10685.xml?mode=lexentry</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Researcher</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#ResearcherUserRole -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#ResearcherUserRole">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#UserRole"/>
        <rdfs:label xml:lang="en">researcher user role</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Skill -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Skill">
        <rdfs:comment xml:lang="en">Job Skill, ability to perform some tasks.</rdfs:comment>
        <rdfs:label xml:lang="en">skill</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#StudentSchool -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#StudentSchool">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">student (school)</rdfs:label>
        <skos:definition xml:lang="en">A student who is attending a school for achieving levels 1, 2, or 3 of the 2011 version of the International Standard Classification of Education structure.</skos:definition>
        <skos:prefLabel xml:lang="en">Student (School)</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#TargetGroup -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#TargetGroup">
        <rdfs:label xml:lang="en">target group</rdfs:label>
        <rdfs:seeAlso>http://purl.org/dcx/lrmi-terms/EducationalAudience</rdfs:seeAlso>
        <skos:definition xml:lang="en">The target group refers to the learners of the resource: A class of agents for whom the learning resource is intended or useful.</skos:definition>
        <skos:editorialNote>Kind of Source: M, Q. Source of definition: DIF1.3, DIF1.4</skos:editorialNote>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#TeacherHigherEducation -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#TeacherHigherEducation">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">teacher (higher education)</rdfs:label>
        <skos:definition xml:lang="en">A teacher who is working at a university or college (e.g. USA, GB) for levels 6, 7, or 8 of the 2011 version of the International Standard Classification of Education structure.</skos:definition>
        <skos:prefLabel xml:lang="en">Teacher (Higher Education)</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#TeacherRole -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#TeacherRole">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#UserRole"/>
        <rdfs:label xml:lang="en">teacher user role</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#TeacherSchool -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#TeacherSchool">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#TargetGroup"/>
        <rdfs:label xml:lang="en">teacher (school)</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://www.wikidata.org/wiki/Q37226</rdfs:seeAlso>
        <skos:definition xml:lang="en">A teacher who is working at a school for levels 1, 2, or 3 of the 2011 version of the International Standard Classification of Education structure. </skos:definition>
        <skos:editorialNote>Kind of Source: paraphrase. Source of definition: https://uis.unesco.org/sites/default/files/documents/international-standard-classification-of-education-isced-2011-en.pdf</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Teacher (School)</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#Tutorial -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#Tutorial">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing OERs that are in form of tutorial.</rdfs:comment>
        <rdfs:label xml:lang="en">tutorial</rdfs:label>
        <skos:definition xml:lang="en">A course with strong instructional components containing exercises, information, etc.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: ISO/IEC 19788-5:2014, 32</skos:editorialNote>
        <skos:prefLabel xml:lang="en">tutorial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#User -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#User">
        <rdfs:label xml:lang="en">user</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <skos:definition xml:lang="en">Registered user in the system, can have different roles i.e learner , teacher , curator, etc</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#UserComment -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#UserComment">
        <rdfs:label xml:lang="en">user comment</rdfs:label>
        <skos:definition xml:lang="en">Comment added by a user on an educational resource</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#UserRole -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#UserRole">
        <rdfs:label xml:lang="en">user role</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#VARKAuditory -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#VARKAuditory">
        <rdfs:subClassOf rdf:resource="https://github.com/tibonto/educor#LearningPreference"/>
        <rdfs:label xml:lang="en">VARK auditory</rdfs:label>
        <skos:definition xml:lang="en">Auditory learning (music, discussion, lectures)</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#VARKKinesthetic -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#VARKKinesthetic">
        <rdfs:subClassOf rdf:resource="https://github.com/tibonto/educor#LearningPreference"/>
        <rdfs:label xml:lang="en">VARK kinesthetic</rdfs:label>
        <skos:definition xml:lang="en">Kinesthetic learning (movement, experiments, hands-on activities)</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#VARKReading -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#VARKReading">
        <rdfs:subClassOf rdf:resource="https://github.com/tibonto/educor#LearningPreference"/>
        <rdfs:label xml:lang="en">VARK reading</rdfs:label>
        <skos:definition xml:lang="en">Reading and writing (making lists, reading textbooks, taking notes)</skos:definition>
    </owl:Class>
    


    <!-- https://purl.org/ontology/modalia#VARKVisual -->


    <owl:Class rdf:about="https://purl.org/ontology/modalia#VARKVisual">
        <rdfs:subClassOf rdf:resource="https://github.com/tibonto/educor#LearningPreference"/>
        <rdfs:label xml:lang="en">VARK visual</rdfs:label>
        <skos:definition xml:lang="en">Visual learning (pictures, movies, diagrams)</skos:definition>
    </owl:Class>
    


    <!-- https://schema.org/AudioObject -->


    <owl:Class rdf:about="https://schema.org/AudioObject">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#MediaType"/>
        <rdfs:comment xml:lang="en">A class representing OERs which are audio files.</rdfs:comment>
        <rdfs:label xml:lang="en">audio</rdfs:label>
        <skos:definition xml:lang="en">A resource has the media type audio if it mainly consists of aural material.</skos:definition>
        <skos:prefLabel xml:lang="en">Audio</skos:prefLabel>
    </owl:Class>
    


    <!-- https://schema.org/ImageObject -->


    <owl:Class rdf:about="https://schema.org/ImageObject">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#MediaType"/>
        <rdfs:comment xml:lang="en">An image file.</rdfs:comment>
        <rdfs:label xml:lang="en">image</rdfs:label>
        <skos:prefLabel xml:lang="en">Image</skos:prefLabel>
    </owl:Class>
    


    <!-- https://schema.org/Organization -->


    <owl:Class rdf:about="https://schema.org/Organization">
        <rdfs:isDefinedBy rdf:resource="https://schema.org"/>
        <rdfs:label xml:lang="en">organization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <skos:definition xml:lang="en">An organization such as a school (including Universities), NGO, corporation, club, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://schema.org/Person -->


    <owl:Class rdf:about="https://schema.org/Person">
        <rdfs:comment xml:lang="en">can be author or contributor</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org"/>
        <rdfs:label xml:lang="en">person</rdfs:label>
        <skos:definition xml:lang="en">A person (alive, dead, undead, or fictional).</skos:definition>
    </owl:Class>
    


    <!-- https://schema.org/PodcastEpisode -->


    <owl:Class rdf:about="https://schema.org/PodcastEpisode">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">podcast episode</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/PodcastSeries -->


    <owl:Class rdf:about="https://schema.org/PodcastSeries">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">podcast series</rdfs:label>
        <skos:definition xml:lang="en">A podcast is an episodic series of digital audio or video files which a user can download and listen to.</skos:definition>
        <skos:prefLabel xml:lang="en">Podcast Series</skos:prefLabel>
    </owl:Class>
    


    <!-- https://schema.org/PresentationDigitalDocument -->


    <owl:Class rdf:about="https://schema.org/PresentationDigitalDocument">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#MediaType"/>
        <rdfs:comment xml:lang="en">A presentation / slides file.</rdfs:comment>
        <rdfs:label xml:lang="en">presentation</rdfs:label>
        <skos:definition xml:lang="en">A resource has the media type presentation if it mainly consists of slides.</skos:definition>
        <skos:prefLabel xml:lang="en">Presentation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://schema.org/Rating -->


    <owl:Class rdf:about="https://schema.org/Rating">
        <rdfs:isDefinedBy rdf:resource="https://schema.org"/>
        <rdfs:label xml:lang="en">rating indicator</rdfs:label>
        <skos:definition xml:lang="en">A rating is an evaluation on a numeric scale, such as 1 to 5 stars.</skos:definition>
    </owl:Class>
    


    <!-- https://schema.org/Review -->


    <owl:Class rdf:about="https://schema.org/Review">
        <rdfs:isDefinedBy rdf:resource="https://schema.org"/>
        <rdfs:label xml:lang="en">review</rdfs:label>
        <skos:definition xml:lang="en">A review of an item - for example, of a restaurant, movie, or store.</skos:definition>
    </owl:Class>
    


    <!-- https://schema.org/SoftwareSourceCode -->


    <owl:Class rdf:about="https://schema.org/SoftwareSourceCode">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Computer programming source code. Example: Full (compile ready) solutions, code snippet samples, scripts, templates.</rdfs:comment>
        <rdfs:label xml:lang="en">software source code</rdfs:label>
        <skos:definition xml:lang="en">Source code (also referred to as source or code) is the version of software as it is originally written in plain text (i.e., human readable alphanumeric characters).</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://w3id.org/emmo#EMMO_348d39f7_6a17_49d1_9860_9b33b69b51de</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Software Source Code</skos:prefLabel>
    </owl:Class>
    


    <!-- https://schema.org/Text -->


    <owl:Class rdf:about="https://schema.org/Text">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#MediaType"/>
        <rdfs:comment xml:lang="en">Class representing OER which are text.</rdfs:comment>
        <rdfs:label xml:lang="en">text</rdfs:label>
        <skos:definition xml:lang="en">A resource has the media type text if it mainly consists of written  or writing materials.</skos:definition>
        <skos:prefLabel xml:lang="en">Text</skos:prefLabel>
    </owl:Class>
    


    <!-- https://schema.org/VideoObject -->


    <owl:Class rdf:about="https://schema.org/VideoObject">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#MediaType"/>
        <rdfs:comment xml:lang="en">A video file.</rdfs:comment>
        <rdfs:label xml:lang="en">video</rdfs:label>
        <skos:definition xml:lang="en">A resource has the media type video if it mainly consists of moving images.</skos:definition>
        <skos:prefLabel xml:lang="en">Video</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/application -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/application">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">application</rdfs:label>
        <skos:definition xml:lang="en">A software application is software that can be directly executed by some processing unit.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://semanticscience.org/resource/SIO_000101</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Application</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/assessment -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/assessment">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing OERs that are in form of assessment of knowledge.</rdfs:comment>
        <rdfs:label xml:lang="en">assessment</rdfs:label>
        <skos:definition xml:lang="en">The description of an activity or resource used to ensure attainment of a learning objective or learning outcome.</skos:definition>
        <skos:editorialNote>Kind of Source: paraphrase. Source of definition: ISO/IEC 19788-5:2014, 14</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Assessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/case_study -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/case_study">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing OERs that are in form of case study.</rdfs:comment>
        <rdfs:label xml:lang="en">case study</rdfs:label>
        <skos:definition xml:lang="en">A description of an actual situation, commonly involving a decision, a challenge, an opportunity, a problem or an issue.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: ISO/IEC 19788-5:2014, 30</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Case Study</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/course -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/course">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">course</rdfs:label>
        <skos:definition xml:lang="en">An educational course comprises one or more educational events and/or creative works which aims to build knowledge, competence or ability of learners.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://schema.org/Course</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Course</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/data -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/data">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">data</rdfs:label>
        <skos:prefLabel xml:lang="en">Data</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/diagram -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/diagram">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing an OER that is a diagram</rdfs:comment>
        <rdfs:label xml:lang="en">diagram</rdfs:label>
        <skos:definition xml:lang="en"> An image that illustrates the structure and/or its component substructures and/or relations with other structures by using lines, shapes, text, and other symbols. </skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://schema.org/diagram </skos:editorialNote>
        <skos:prefLabel xml:lang="en">Diagram</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/drill_and_practice -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/drill_and_practice">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">drill_and_practice</rdfs:label>
        <skos:definition xml:lang="en">Exercise(s) or activities for the (repetitive) training of a skill or knowledge.</skos:definition>
        <skos:prefLabel xml:lang="en">Drill and practice</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/educational_game -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/educational_game">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing OERs that are in form of educational games.</rdfs:comment>
        <rdfs:label xml:lang="en">educational game</rdfs:label>
        <skos:definition xml:lang="en">An individual or group game intended to teach a subject, skill, or attitude.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: http://vocab.getty.edu/page/aat/300262798</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Educational Game</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/experiment -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/experiment">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:comment xml:lang="en">Class representing OERs that are describing an experiment</rdfs:comment>
        <rdfs:label xml:lang="en">experiment</rdfs:label>
        <skos:definition xml:lang="en">A scientific procedure undertaken to make a discovery, test a hypothesis, or demonstrate a known fact.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: ISO/IEC 19788-5:2014, 31</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Experiment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/index -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/index">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="de">Nachschlagewerk</rdfs:label>
        <rdfs:label xml:lang="en">index</rdfs:label>
        <skos:definition xml:lang="en">Material to be consulted for authoritative factual information, such as a dictionary, encyclopaedia, entry, handbook, standard, or field guide, or an informative web page such as an institutional, research group or project home page.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: http://purl.org/spar/fabio/ReferenceWork </skos:editorialNote>
        <skos:example xml:lang="en">glossary, encyclopedia, dictionary</skos:example>
        <skos:prefLabel xml:lang="en">Reference Work</skos:prefLabel>
        <skos:scopeNote xml:lang="de">zum Beispiel Glossar, Enzyklopädie, Lexikonzum Beispiel Glossar, Enzyklopädie, Lexikon</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/lesson_plan -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/lesson_plan">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">lesson plan</rdfs:label>
        <skos:definition xml:lang="en">Detailed descriptions or outlines for a pedagogical session. Usually includes objective(s), instructional components or methods, and assessment.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: http://vocab.getty.edu/page/aat/300417283</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Lesson_plan</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/map -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/map">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">map</rdfs:label>
        <skos:prefLabel xml:lang="en">Map</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/other -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/other">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">other resource type</rdfs:label>
        <skos:definition xml:lang="en">A learning resource type that is not covered by the other listed categories.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/portal -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/portal">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">portal</rdfs:label>
        <skos:definition xml:lang="en">A website that integrates applications, processes and services.</skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: https://www.wikidata.org/wiki/Q186165</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Portal</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/questionnaire -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/questionnaire">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">questionnaire</rdfs:label>
        <skos:definition xml:lang="en">A set of questions with a choice of answers, devised for the purposes of a survey or statistical study.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: ISO/IEC 19788-5:2014 , 32</skos:editorialNote>
        <skos:prefLabel xml:lang="en">questionnaire</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/script -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/script">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">script</rdfs:label>
        <skos:definition xml:lang="en">A script or scriptum is a textbook or study materials that include the content of a lecture series or course.</skos:definition>
        <skos:prefLabel xml:lang="en">Script</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/sheet_music -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/sheet_music">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">sheet music</rdfs:label>
        <skos:definition xml:lang="en">A piece of musical notation. </skos:definition>
        <skos:prefLabel xml:lang="en">Sheet_music</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/simulation -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/simulation">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">simulation</rdfs:label>
        <skos:definition xml:lang="en">The reproducing of characteristics, conditions, and/or systems, often by the use of a model or a representation. </skos:definition>
        <skos:editorialNote>Kind of Source: Modified quotation. Source of definition: ISO/IEC 19788-5:2014 , 32
</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Simulation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/textbook -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/textbook">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">textbook</rdfs:label>
        <skos:definition xml:lang="en">Book used as standard work for the formal study of a particular subject.  </skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://vocab.getty.edu/aat/300026384</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Textbook</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/kim/hcrt/worksheet -->


    <owl:Class rdf:about="https://w3id.org/kim/hcrt/worksheet">
        <rdfs:subClassOf rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label xml:lang="en">worksheet</rdfs:label>
        <skos:definition xml:lang="en">A sheet containing exercises or tasks to be completed for the purpose of imparting knowledge, attitudes, or skills.</skos:definition>
        <skos:editorialNote>Kind of Source: paraphrase, Original. Source of definition: http://vocab.getty.edu/page/aat/300026367</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Worksheet</skos:prefLabel>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://creativecommons.org/licenses/by/4.0/ -->


    <owl:NamedIndividual rdf:about="https://creativecommons.org/licenses/by/4.0/">
        <rdfs:label>CC-BY-4.0</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#Annotator -->


    <owl:NamedIndividual rdf:about="https://purl.org/ontology/modalia#Annotator">
        <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Role"/>
        <rdfs:label xml:lang="en">annotator role</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://id.loc.gov/vocabulary/relators/ann"/>
        <skos:definition xml:lang="en">A person who makes manuscript annotations on an item.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://id.loc.gov/vocabulary/relators/ann.html</skos:editorialNote>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#Beginner -->


    <owl:NamedIndividual rdf:about="https://purl.org/ontology/modalia#Beginner">
        <rdf:type rdf:resource="https://purl.org/ontology/modalia#Proficiency"/>
        <isLessProficientThan rdf:resource="https://purl.org/ontology/modalia#Competent"/>
        <isLessProficientThan rdf:resource="https://purl.org/ontology/modalia#Expert"/>
        <isLessProficientThan rdf:resource="https://purl.org/ontology/modalia#Proficient"/>
        <isMoreProficientThan rdf:resource="https://purl.org/ontology/modalia#Novice"/>
        <hasOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasOrder>
        <rdfs:label xml:lang="en">advanced beginner</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#Competent -->


    <owl:NamedIndividual rdf:about="https://purl.org/ontology/modalia#Competent">
        <rdf:type rdf:resource="https://purl.org/ontology/modalia#Proficiency"/>
        <isLessProficientThan rdf:resource="https://purl.org/ontology/modalia#Expert"/>
        <isLessProficientThan rdf:resource="https://purl.org/ontology/modalia#Proficient"/>
        <isMoreProficientThan rdf:resource="https://purl.org/ontology/modalia#Beginner"/>
        <isMoreProficientThan rdf:resource="https://purl.org/ontology/modalia#Novice"/>
        <hasOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasOrder>
        <rdfs:label xml:lang="en">competent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#ContactPerson -->


    <owl:NamedIndividual rdf:about="https://purl.org/ontology/modalia#ContactPerson">
        <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Role"/>
        <rdfs:label xml:lang="en">contactperson role</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/nfdi4ing/metadata4ing#ContactPerson"/>
        <skos:definition xml:lang="en">Person with knowledge of how to access, troubleshoot, or otherwise field issues related to the resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://w3id.org/nfdi4ing/metadata4ing/#ContactPerson https://datacite-metadata-schema.readthedocs.io/en/4.6/</skos:editorialNote>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#DataCollector -->


    <owl:NamedIndividual rdf:about="https://purl.org/ontology/modalia#DataCollector">
        <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Role"/>
        <rdfs:label xml:lang="en">datacollector role</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/nfdi4ing/metadata4ing#DataCollector"/>
        <skos:definition xml:lang="en">Person/institution responsible for finding or gathering/collecting data under the guidelines of the author(s) or Principal Investigator (PI). </skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://w3id.org/nfdi4ing/metadata4ing/#DataCollector https://datacite-metadata-schema.readthedocs.io/en/4.6/</skos:editorialNote>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#DataCurator -->


    <owl:NamedIndividual rdf:about="https://purl.org/ontology/modalia#DataCurator">
        <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Role"/>
        <rdfs:label xml:lang="en">datacurator role</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/nfdi4ing/metadata4ing#DataCurator"/>
        <skos:definition xml:lang="en">A data curator is a person tasked with reviewing, enhancing, cleaning, or standardizing metadata and the associated data submitted for storage, use, and maintenance within a data centre or repository. </skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://w3id.org/nfdi4ing/metadata4ing#DataCurator https://datacite-metadata-schema.readthedocs.io/en/4.6/ </skos:editorialNote>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#DataManager -->


    <owl:NamedIndividual rdf:about="https://purl.org/ontology/modalia#DataManager">
        <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Role"/>
        <rdfs:label xml:lang="en">datamanager role</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://id.loc.gov/vocabulary/relators/dtm"/>
        <skos:definition xml:lang="en">Person (or organisation with a staff of data managers, such as a data centre) responsible for maintaining the finished resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://w3id.org/nfdi4ing/metadata4ing#DataManager https://datacite-metadata-schema.readthedocs.io/en/4.6/</skos:editorialNote>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#Distributor -->


    <owl:NamedIndividual rdf:about="https://purl.org/ontology/modalia#Distributor">
        <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Role"/>
        <rdfs:label xml:lang="en">distributor role</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://w3id.org/nfdi4ing/metadata4ing#Distributor"/>
        <skos:definition xml:lang="en">Institution tasked with responsibility to generate/disseminate copies of the resource in either electronic or print form.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://w3id.org/nfdi4ing/metadata4ing#Distributor https://datacite-metadata-schema.readthedocs.io/en/4.6</skos:editorialNote>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#Editor -->


