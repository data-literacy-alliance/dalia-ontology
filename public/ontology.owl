        <rdfs:range rdf:resource="https://purl.org/ontology/modalia#LearningResourceType"/>
        <rdfs:label>hasLearningType</rdfs:label>
        <skos:definition xml:lang="en">The value is the learning type of content of a learning resource (e.g Lecture)</skos:definition>
    </owl:ObjectProperty>
    


