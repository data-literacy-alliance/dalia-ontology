        <rdfs:seeAlso rdf:resource="http://id.loc.gov/vocabulary/relators/ive"/>
        <skos:definition xml:lang="en">A person, family, or organization responsible for creating or contributing to a resource by responding to an interviewer, usually a reporter, pollster, or some other information gathering agent.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: https://id.loc.gov/vocabulary/relators/ive.html</skos:editorialNote>
