        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Keywords or tags used to describe some item.</rdfs:comment>
        <rdfs:label xml:lang="en">keywords</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/ratingValue -->


    <owl:DatatypeProperty rdf:about="https://schema.org/ratingValue">
        <rdfs:domain rdf:resource="https://schema.org/Rating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
