        <rdfs:seeAlso rdf:resource="http://w3id.org/nfdi4ing/metadata4ing#RightsHolder"/>
        <skos:definition xml:lang="en">Person or institution owning or managing property rights, including intellectual property rights over the resource.</skos:definition>
        <skos:editorialNote>Kind of Source: Quotation. Source of definition: http://w3id.org/nfdi4ing/metadata4ing#RightsHolder https://datacite-metadata-schema.readthedocs.io/en/4.6</skos:editorialNote>
    </owl:NamedIndividual>
    


    <!-- https://purl.org/ontology/modalia#SoftwareDeveloper -->


    <owl:NamedIndividual rdf:about="https://purl.org/ontology/modalia#SoftwareDeveloper">
