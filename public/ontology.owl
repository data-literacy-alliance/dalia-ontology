                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">Date Created</rdfs:label>
        <skos:definition xml:lang="en">Date of creation of the resource.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#EducationalResource"/>
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#KnowledgeTopic"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Community"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/format -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/format">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy>File format of the file representing the resource</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">file format</rdfs:label>
        <skos:example>PDF, AVI</skos:example>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">issued</rdfs:label>
        <skos:definition xml:lang="en">Date of formal issuance (e.g., publication) of the resource.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/language -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/language">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#language"/>
        <rdfs:label xml:lang="en">language</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/license">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/rights -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/rights">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">rights</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#EducationalResource"/>
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#KnowledgeTopic"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Community"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/type -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/type">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://github.com/tibonto/educor#Recommendation"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Exercise"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Skill"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:isDefinedBy xml:lang="en">The nature or genre of the resource.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/spar/fabio/hasSubtitle -->


    <owl:DatatypeProperty rdf:about="http://purl.org/spar/fabio/hasSubtitle">
        <rdfs:domain rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has Subtitle</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/nfdi4ing/metadata4ing#hasRorId -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/nfdi4ing/metadata4ing#hasRorId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Community"/>
                    <rdf:Description rdf:about="https://schema.org/Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>https://ror.org/[0-9][0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][0-9][0-9]</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <skos:altLabel xml:lang="en">has research organization registry id</skos:altLabel>
        <skos:altLabel xml:lang="de">hat Forschungsorganisationsid</skos:altLabel>
        <skos:definition xml:lang="en">A Research Organization Registry identifier that persistently and uniquely identifies a research organization</skos:definition>
        <skos:definition xml:lang="de">Ein persistenter Identifikator für Organisationen, vergeben durch die Research Organization Registry, der eine Forschungseinrichtung eindeutig identifiziert.</skos:definition>
        <skos:prefLabel xml:lang="en">has ROR ID</skos:prefLabel>
        <skos:prefLabel xml:lang="de">hat ROR ID</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/nfdi4ing/metadata4ing#orcidId -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/nfdi4ing/metadata4ing#orcidId">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#Contributor"/>
                    <rdf:Description rdf:about="https://purl.org/ontology/modalia#User"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>https://orcid.org/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9X]</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <skos:definition xml:lang="en">Open Researcher and Contributor ID: an identifier, that allows unique identification of a person, usually active in research.</skos:definition>
        <skos:definition xml:lang="de">Open Researcher and Contributor ID: ein persistenter Identifikator, der eine in der Forschung tätige Person eindeutig identifiziert.</skos:definition>
        <skos:prefLabel xml:lang="en">has ORCID ID</skos:prefLabel>
        <skos:prefLabel xml:lang="de">hat ORCID ID</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/ontology/modalia#certificateEndDate -->


