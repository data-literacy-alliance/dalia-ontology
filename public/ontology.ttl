###  https://purl.org/ontology/modalia#recommender
:recommender rdf:type owl:ObjectProperty ;
             rdfs:domain <https://github.com/tibonto/educor#EducationalResource> ;
             rdfs:range :Community ;
             <http://purl.org/dc/terms/description> "A community which provides the recommendation of the OER. In the context of DIF, the recommending community is the organization or institution or project or body or online group which recommends the OER." ;
             rdfs:label "recommender"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Associated community(ies) of the resource who are either the supporting organization/institution, or the recommender, or both.  Here indicates recommender"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :recommender ;
   owl:annotatedProperty <http://purl.org/dc/terms/description> ;
   owl:annotatedTarget "A community which provides the recommendation of the OER. In the context of DIF, the recommending community is the organization or institution or project or body or online group which recommends the OER." ;
   <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0001-8997-2620> ,
                                          <https://orcid.org/0000-0002-0452-7075> ;
   <http://purl.org/dc/terms/source> "DIF1.3" ,
                                     "recommendationontology"
 ] .


