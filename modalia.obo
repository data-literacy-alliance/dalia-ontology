[Term]
id: modalia:DataLifeCyclePhase
name: data life cycle phase
def: "One of the eight known phases of data life cycle." []
property_value: seeAlso "https://towson.libguides.com/dataresearch/datamangement/dldataone" xsd:string

[Term]
id: modalia:DescribePhase
name: describe phase
is_a: modalia:DataLifeCyclePhase ! data life cycle phase

[Term]
id: modalia:Discipline
name: discipline
def: "knowledge of a specific, specialized discipline or field" []
property_value: seeAlso "http://purl.org/spar/fabio/SubjectDiscipline" xsd:string
property_value: skos:example "e.g Engineering" xsd:string

[Term]
id: modalia:DiscoverPhase
name: discover phase
is_a: modalia:DataLifeCyclePhase ! data life cycle phase

[Term]
id: modalia:EducationalLevel
name: education level
def: "The educational level of a user: Bachlors, Masters or PhD" []

[Term]
id: modalia:FiveStarRating
name: five star rating
def: "Standard five star rating, min value 1 maximum 5" []
is_a: schema:Rating ! rating indicator
property_value: schema:bestRating "5" xsd:integer
property_value: schema:worstRating "1" xsd:integer

[Term]
id: modalia:FreeLicense
name: free license
is_a: modalia:License ! license

[Term]
id: modalia:IntegratePhase
name: integrate phase
is_a: modalia:DataLifeCyclePhase ! data life cycle phase

[Term]
id: modalia:Job
name: job
def: "name of a profession" []
property_value: seeAlso "https://schema.org/Occupation" xsd:string
property_value: skos:example "Software Developer" xsd:string

[Term]
id: modalia:LearnerRole
name: learner role
is_a: modalia:UserRole ! user role

[Term]
id: modalia:LearningObjective
name: learning objective
def: "Learning Objective as defined in learning objective matrix (LZM)" []
def: "The Learning Goal can vary depending on the personalisation level. For example a user might care to learn some specific topics and not all the skill set." []
property_value: seeAlso "https://github.com/tibonto/educor#LearningGoal" xsd:string

[Term]
id: modalia:LearningPath
name: learning path
def: "The learning path consists of a set of learning units (Educational Resources) in a specified order  to reach a learning objective." []
property_value: skos:example "\"Hello world in python\", \"Comments in python\", \"Strings in python\"" xsd:string

[Term]
id: modalia:LearningPathStep
name: learning path step
def: "One step of a learning path, it has an order and one educational resource. Optionally a learning path step can have a note for learner." []

[Term]
id: modalia:LearningResourceType
name: learning resource type
def: "The type of the learning resource can be lecture, experiment, Assessment, etc." []

[Term]
id: modalia:Lecture
name: lecture
def: "Class representing OERs that are lectures." []
is_a: modalia:LearningResourceType ! learning resource type
property_value: skos:prefLabel "lecture" xsd:string

[Term]
id: modalia:License
name: license

[Term]
id: modalia:MastersStudent
name: master's student
def: "A student in Master's degree" []
is_a: modalia:TargetGroup ! target group
property_value: seeAlso "http://w3id.org/roh#MastersStudent" xsd:string
property_value: skos:prefLabel "Master's Student" xsd:string

[Term]
id: modalia:MediaType
name: media type
def: "General type of data content encoded in a computer file. Digital media type of the resource. To be used with user preferences according to VARK learning style." []

[Term]
id: modalia:Multipart
name: multipart
def: "If the resource consists of more than one item with different DOIs, the MediaType is \"multipart\" and the relations are provided in the field \"RelatedWork\"." []
is_a: modalia:MediaType ! media type
property_value: skos:prefLabel "Multipart" xsd:string

[Term]
id: modalia:MuseumProfessional
name: museum professional
is_a: modalia:TargetGroup ! target group
property_value: skos:prefLabel "Museum Professional" xsd:string

[Term]
id: modalia:PhDStudent
name: PhD student
def: "A student in PhD degree" []
is_a: modalia:TargetGroup ! target group
property_value: seeAlso "http://vivoweb.org/ontology/core#GraduateStudent" xsd:string
property_value: skos:prefLabel "PhD student" xsd:string

[Term]
id: modalia:PlanPhase
name: plan phase
def: "First phase in data life cycle. Description of the data that will be compiled." []
is_a: modalia:DataLifeCyclePhase ! data life cycle phase

[Term]
id: modalia:Podcast
name: podcast
def: "The learning resource type podcast is an episodic series of digital audio or video files or an episode of that, which a user can download and listen to." []
is_a: modalia:LearningResourceType ! learning resource type

[Term]
