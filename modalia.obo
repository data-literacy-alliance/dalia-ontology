[Term]
id: modalia:AnalyzePhase
name: analyze phase
def: "The last phase in data life cycle." []
is_a: modalia:DataLifeCyclePhase ! data life cycle phase
disjoint_from: modalia:AssurePhase ! assure phase
disjoint_from: modalia:CollectPhase ! collect phase
disjoint_from: modalia:DescribePhase ! describe phase
disjoint_from: modalia:DiscoverPhase ! discover phase
disjoint_from: modalia:IntegratePhase ! integrate phase
disjoint_from: modalia:PlanPhase ! plan phase
disjoint_from: modalia:PreservePhase ! preserve phase

