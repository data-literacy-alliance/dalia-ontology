owl-axioms: Prefix(owl:=<http://www.w3.org/2002/07/owl#>)\nPrefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)\nPrefix(xml:=<http://www.w3.org/XML/1998/namespace>)\nPrefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)\nPrefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)\n\n\nOntology(\nDeclaration(Class(<https://github.com/tibonto/educor#EducationalResource>))\nDeclaration(Class(<https://purl.org/ontology/modalia#Community>))\nDeclaration(Class(<https://purl.org/ontology/modalia#Contributor>))\nDeclaration(Class(<https://purl.org/ontology/modalia#Job>))\nDeclaration(Class(<https://purl.org/ontology/modalia#LearningPath>))\nDeclaration(Class(<https://purl.org/ontology/modalia#LearningPathStep>))\nDeclaration(Class(<https://purl.org/ontology/modalia#Proficiency>))\nDeclaration(Class(<https://purl.org/ontology/modalia#User>))\nDeclaration(Class(<https://purl.org/ontology/modalia#UserComment>))\nDeclaration(Class(<https://schema.org/Organization>))\nDeclaration(Class(<https://schema.org/Rating>))\nDeclaration(Class(<https://schema.org/Review>))\nDeclaration(Class(<https://w3id.org/kim/hcrt/assessment>))\nDeclaration(Class(<https://w3id.org/kim/hcrt/questionnaire>))\nDeclaration(ObjectProperty(<http://purl.org/dc/terms/hasPart>))\nDeclaration(ObjectProperty(<http://purl.org/dc/terms/isPartOf>))\nDeclaration(ObjectProperty(<http://purl.org/dc/terms/isReferencedBy>))\nDeclaration(ObjectProperty(<http://purl.org/dc/terms/references>))\nDeclaration(ObjectProperty(<http://purl.org/dc/terms/relation>))\nDeclaration(ObjectProperty(<http://purl.org/dc/terms/requires>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#describes>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#hasMetadata>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#hasSourceCode>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#hasTranslation>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#isDescribedBy>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#isLessProficientThan>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#isMoreProficientThan>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#isNewVersionOf>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#isSourceCodeOf>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#isTranslationOf>))\nDeclaration(ObjectProperty(<https://purl.org/ontology/modalia#solves>))\nDeclaration(ObjectProperty(<https://schema.org/isBasedOn>))\nDeclaration(ObjectProperty(<https://w3id.org/citedcat-ap/isCompiledBy>))\nDeclaration(ObjectProperty(<https://w3id.org/citedcat-ap/isSupplementTo>))\nDeclaration(ObjectProperty(<https://w3id.org/citedcat-ap/isSupplementedBy>))\nDeclaration(DataProperty(<http://purl.org/dc/terms/format>))\nDeclaration(DataProperty(<http://purl.org/dc/terms/issued>))\nDeclaration(DataProperty(<http://purl.org/dc/terms/rights>))\nDeclaration(DataProperty(<http://purl.org/spar/fabio/hasSubtitle>))\nDeclaration(DataProperty(<http://w3id.org/nfdi4ing/metadata4ing#hasRorId>))\nDeclaration(DataProperty(<http://w3id.org/nfdi4ing/metadata4ing#orcidId>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#authorUnordered>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#citation>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#commentDate>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#commentID>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#commentText>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#hasDOI>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#hasOrder>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#industry>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#likesCount>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#notesForLearner>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#studyPlan>))\nDeclaration(DataProperty(<https://purl.org/ontology/modalia#viewCount>))\nDeclaration(DataProperty(<https://schema.org/abstract>))\nDeclaration(DataProperty(<https://schema.org/accessibilityFeature>))\nDeclaration(DataProperty(<https://schema.org/datePublished>))\nDeclaration(DataProperty(<https://schema.org/downloadUrl>))\nDeclaration(DataProperty(<https://schema.org/email>))\nDeclaration(DataProperty(<https://schema.org/familyName>))\nDeclaration(DataProperty(<https://schema.org/fileSize>))\nDeclaration(DataProperty(<https://schema.org/givenName>))\nDeclaration(DataProperty(<https://schema.org/identifier>))\nDeclaration(DataProperty(<https://schema.org/image>))\nDeclaration(DataProperty(<https://schema.org/isAccessibleForFree>))\nDeclaration(DataProperty(<https://schema.org/keywords>))\nDeclaration(DataProperty(<https://schema.org/ratingValue>))\nDeclaration(DataProperty(<https://schema.org/reviewBody>))\nDeclaration(DataProperty(<https://schema.org/reviewRating>))\nDeclaration(DataProperty(<https://schema.org/teaches>))\nDeclaration(DataProperty(<https://schema.org/timeRequired>))\nDeclaration(DataProperty(<https://schema.org/title>))\nDeclaration(DataProperty(<https://schema.org/url>))\nDeclaration(DataProperty(<https://schema.org/version>))\nDeclaration(NamedIndividual(<https://purl.org/ontology/modalia#Beginner>))\nDeclaration(NamedIndividual(<https://purl.org/ontology/modalia#Competent>))\nDeclaration(NamedIndividual(<https://purl.org/ontology/modalia#Expert>))\nDeclaration(NamedIndividual(<https://purl.org/ontology/modalia#Novice>))\nDeclaration(NamedIndividual(<https://purl.org/ontology/modalia#Proficient>))\nDeclaration(AnnotationProperty(<http://purl.org/dc/terms/created>))\nDeclaration(AnnotationProperty(<http://purl.org/dc/terms/license>))\nDeclaration(Datatype(xsd:duration))\n############################\n#   Annotation Properties\n############################\n\n# Annotation Property: <http://purl.org/dc/terms/created> (<http://purl.org/dc/terms/created>)\n\nAnnotationPropertyRange(<http://purl.org/dc/terms/created> xsd:dateTime)\n\n# Annotation Property: <http://purl.org/dc/terms/license> (<http://purl.org/dc/terms/license>)\n\nAnnotationPropertyRange(<http://purl.org/dc/terms/license> <https://purl.org/ontology/modalia#License>)\nAnnotationPropertyDomain(<http://purl.org/dc/terms/license> <https://github.com/tibonto/educor#EducationalResource>)\n\n\n############################\n#   Object Properties\n############################\n\n# Object Property: <http://purl.org/dc/terms/hasPart> (<http://purl.org/dc/terms/hasPart>)\n\nObjectPropertyRange(<http://purl.org/dc/terms/hasPart> owl:Thing)\n\n# Object Property: <http://purl.org/dc/terms/isPartOf> (<http://purl.org/dc/terms/isPartOf>)\n\nObjectPropertyRange(<http://purl.org/dc/terms/isPartOf> owl:Thing)\n\n# Object Property: <http://purl.org/dc/terms/isReferencedBy> (<http://purl.org/dc/terms/isReferencedBy>)\n\nObjectPropertyRange(<http://purl.org/dc/terms/isReferencedBy> owl:Thing)\n\n# Object Property: <http://purl.org/dc/terms/references> (<http://purl.org/dc/terms/references>)\n\nObjectPropertyRange(<http://purl.org/dc/terms/references> owl:Thing)\n\n# Object Property: <http://purl.org/dc/terms/relation> (<http://purl.org/dc/terms/relation>)\n\nObjectPropertyRange(<http://purl.org/dc/terms/relation> owl:Thing)\n\n# Object Property: <http://purl.org/dc/terms/requires> (<http://purl.org/dc/terms/requires>)\n\nObjectPropertyRange(<http://purl.org/dc/terms/requires> owl:Thing)\n\n# Object Property: <https://purl.org/ontology/modalia#describes> (<https://purl.org/ontology/modalia#describes>)\n\nObjectPropertyRange(<https://purl.org/ontology/modalia#describes> owl:Thing)\n\n# Object Property: <https://purl.org/ontology/modalia#hasMetadata> (<https://purl.org/ontology/modalia#hasMetadata>)\n\nObjectPropertyRange(<https://purl.org/ontology/modalia#hasMetadata> owl:Thing)\n\n# Object Property: <https://purl.org/ontology/modalia#hasSourceCode> (<https://purl.org/ontology/modalia#hasSourceCode>)\n\nObjectPropertyRange(<https://purl.org/ontology/modalia#hasSourceCode> owl:Thing)\n\n# Object Property: <https://purl.org/ontology/modalia#hasTranslation> (<https://purl.org/ontology/modalia#hasTranslation>)\n\nObjectPropertyRange(<https://purl.org/ontology/modalia#hasTranslation> owl:Thing)\n\n# Object Property: <https://purl.org/ontology/modalia#isDescribedBy> (<https://purl.org/ontology/modalia#isDescribedBy>)\n\nObjectPropertyRange(<https://purl.org/ontology/modalia#isDescribedBy> owl:Thing)\n\n# Object Property: <https://purl.org/ontology/modalia#isNewVersionOf> (<https://purl.org/ontology/modalia#isNewVersionOf>)\n\nIrreflexiveObjectProperty(<https://purl.org/ontology/modalia#isNewVersionOf>)\n\n# Object Property: <https://purl.org/ontology/modalia#isSourceCodeOf> (<https://purl.org/ontology/modalia#isSourceCodeOf>)\n\nObjectPropertyRange(<https://purl.org/ontology/modalia#isSourceCodeOf> owl:Thing)\n\n# Object Property: <https://purl.org/ontology/modalia#isTranslationOf> (<https://purl.org/ontology/modalia#isTranslationOf>)\n\nObjectPropertyRange(<https://purl.org/ontology/modalia#isTranslationOf> owl:Thing)\n\n# Object Property: <https://purl.org/ontology/modalia#solves> (<https://purl.org/ontology/modalia#solves>)\n\nObjectPropertyRange(<https://purl.org/ontology/modalia#solves> ObjectUnionOf(<https://w3id.org/kim/hcrt/assessment> <https://w3id.org/kim/hcrt/questionnaire>))\n\n# Object Property: <https://schema.org/isBasedOn> (<https://schema.org/isBasedOn>)\n\nObjectPropertyRange(<https://schema.org/isBasedOn> owl:Thing)\n\n# Object Property: <https://w3id.org/citedcat-ap/isCompiledBy> (<https://w3id.org/citedcat-ap/isCompiledBy>)\n\nObjectPropertyRange(<https://w3id.org/citedcat-ap/isCompiledBy> owl:Thing)\n\n# Object Property: <https://w3id.org/citedcat-ap/isSupplementTo> (<https://w3id.org/citedcat-ap/isSupplementTo>)\n\nObjectPropertyRange(<https://w3id.org/citedcat-ap/isSupplementTo> owl:Thing)\n\n# Object Property: <https://w3id.org/citedcat-ap/isSupplementedBy> (<https://w3id.org/citedcat-ap/isSupplementedBy>)\n\nObjectPropertyRange(<https://w3id.org/citedcat-ap/isSupplementedBy> owl:Thing)\n\n\n############################\n#   Data Properties\n############################\n\n# Data Property: <http://purl.org/dc/terms/format> (<http://purl.org/dc/terms/format>)\n\nDataPropertyDomain(<http://purl.org/dc/terms/format> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<http://purl.org/dc/terms/format> xsd:string)\n\n# Data Property: <http://purl.org/dc/terms/issued> (<http://purl.org/dc/terms/issued>)\n\nDataPropertyDomain(<http://purl.org/dc/terms/issued> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<http://purl.org/dc/terms/issued> xsd:dateTime)\n\n# Data Property: <http://purl.org/dc/terms/rights> (<http://purl.org/dc/terms/rights>)\n\nDataPropertyDomain(<http://purl.org/dc/terms/rights> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<http://purl.org/dc/terms/rights> xsd:string)\n\n# Data Property: <http://purl.org/spar/fabio/hasSubtitle> (<http://purl.org/spar/fabio/hasSubtitle>)\n\nDataPropertyDomain(<http://purl.org/spar/fabio/hasSubtitle> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<http://purl.org/spar/fabio/hasSubtitle> xsd:string)\n\n# Data Property: <http://w3id.org/nfdi4ing/metadata4ing#hasRorId> (<http://w3id.org/nfdi4ing/metadata4ing#hasRorId>)\n\nDataPropertyDomain(<http://w3id.org/nfdi4ing/metadata4ing#hasRorId> ObjectUnionOf(<https://purl.org/ontology/modalia#Community> <https://schema.org/Organization>))\nDataPropertyRange(<http://w3id.org/nfdi4ing/metadata4ing#hasRorId> DatatypeRestriction(xsd:string xsd:pattern \"https://ror.org/[0-9][0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][0-9][0-9]\"))\n\n# Data Property: <http://w3id.org/nfdi4ing/metadata4ing#orcidId> (<http://w3id.org/nfdi4ing/metadata4ing#orcidId>)\n\nDataPropertyDomain(<http://w3id.org/nfdi4ing/metadata4ing#orcidId> ObjectUnionOf(<https://purl.org/ontology/modalia#Contributor> <https://purl.org/ontology/modalia#User>))\nDataPropertyRange(<http://w3id.org/nfdi4ing/metadata4ing#orcidId> DatatypeRestriction(xsd:string xsd:pattern \"https://orcid.org/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9X]\"))\n\n# Data Property: <https://purl.org/ontology/modalia#authorUnordered> (<https://purl.org/ontology/modalia#authorUnordered>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#authorUnordered> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://purl.org/ontology/modalia#authorUnordered> xsd:string)\n\n# Data Property: <https://purl.org/ontology/modalia#citation> (<https://purl.org/ontology/modalia#citation>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#citation> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://purl.org/ontology/modalia#citation> xsd:string)\n\n# Data Property: <https://purl.org/ontology/modalia#commentDate> (<https://purl.org/ontology/modalia#commentDate>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#commentDate> <https://purl.org/ontology/modalia#UserComment>)\nDataPropertyRange(<https://purl.org/ontology/modalia#commentDate> xsd:dateTimeStamp)\n\n# Data Property: <https://purl.org/ontology/modalia#commentID> (<https://purl.org/ontology/modalia#commentID>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#commentID> <https://purl.org/ontology/modalia#UserComment>)\nDataPropertyRange(<https://purl.org/ontology/modalia#commentID> xsd:string)\n\n# Data Property: <https://purl.org/ontology/modalia#commentText> (<https://purl.org/ontology/modalia#commentText>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#commentText> <https://purl.org/ontology/modalia#UserComment>)\nDataPropertyRange(<https://purl.org/ontology/modalia#commentText> xsd:string)\n\n# Data Property: <https://purl.org/ontology/modalia#hasDOI> (<https://purl.org/ontology/modalia#hasDOI>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#hasDOI> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://purl.org/ontology/modalia#hasDOI> xsd:string)\n\n# Data Property: <https://purl.org/ontology/modalia#hasOrder> (<https://purl.org/ontology/modalia#hasOrder>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#hasOrder> ObjectUnionOf(<https://purl.org/ontology/modalia#LearningPathStep> <https://purl.org/ontology/modalia#Proficiency>))\nDataPropertyRange(<https://purl.org/ontology/modalia#hasOrder> xsd:integer)\n\n# Data Property: <https://purl.org/ontology/modalia#industry> (<https://purl.org/ontology/modalia#industry>)\n\nSubDataPropertyOf(<https://purl.org/ontology/modalia#industry> owl:topDataProperty)\nDataPropertyDomain(<https://purl.org/ontology/modalia#industry> <https://purl.org/ontology/modalia#Job>)\nDataPropertyRange(<https://purl.org/ontology/modalia#industry> xsd:string)\n\n# Data Property: <https://purl.org/ontology/modalia#likesCount> (<https://purl.org/ontology/modalia#likesCount>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#likesCount> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://purl.org/ontology/modalia#likesCount> xsd:int)\n\n# Data Property: <https://purl.org/ontology/modalia#notesForLearner> (<https://purl.org/ontology/modalia#notesForLearner>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#notesForLearner> ObjectUnionOf(<https://github.com/tibonto/educor#EducationalResource> <https://purl.org/ontology/modalia#LearningPathStep>))\nDataPropertyRange(<https://purl.org/ontology/modalia#notesForLearner> xsd:string)\n\n# Data Property: <https://purl.org/ontology/modalia#studyPlan> (<https://purl.org/ontology/modalia#studyPlan>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#studyPlan> <https://purl.org/ontology/modalia#LearningPath>)\nDataPropertyRange(<https://purl.org/ontology/modalia#studyPlan> rdf:langString)\n\n# Data Property: <https://purl.org/ontology/modalia#viewCount> (<https://purl.org/ontology/modalia#viewCount>)\n\nDataPropertyDomain(<https://purl.org/ontology/modalia#viewCount> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://purl.org/ontology/modalia#viewCount> xsd:int)\n\n# Data Property: <https://schema.org/abstract> (<https://schema.org/abstract>)\n\nDataPropertyDomain(<https://schema.org/abstract> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/abstract> xsd:string)\n\n# Data Property: <https://schema.org/accessibilityFeature> (<https://schema.org/accessibilityFeature>)\n\nDataPropertyDomain(<https://schema.org/accessibilityFeature> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/accessibilityFeature> xsd:string)\n\n# Data Property: <https://schema.org/datePublished> (<https://schema.org/datePublished>)\n\nDataPropertyDomain(<https://schema.org/datePublished> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/datePublished> xsd:dateTime)\n\n# Data Property: <https://schema.org/downloadUrl> (<https://schema.org/downloadUrl>)\n\nDataPropertyDomain(<https://schema.org/downloadUrl> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/downloadUrl> xsd:anyURI)\n\n# Data Property: <https://schema.org/email> (<https://schema.org/email>)\n\nFunctionalDataProperty(<https://schema.org/email>)\nDataPropertyDomain(<https://schema.org/email> <https://purl.org/ontology/modalia#User>)\nDataPropertyRange(<https://schema.org/email> xsd:string)\n\n# Data Property: <https://schema.org/familyName> (<https://schema.org/familyName>)\n\nDataPropertyDomain(<https://schema.org/familyName> ObjectUnionOf(<https://purl.org/ontology/modalia#Contributor> <https://purl.org/ontology/modalia#User>))\nDataPropertyRange(<https://schema.org/familyName> xsd:string)\n\n# Data Property: <https://schema.org/fileSize> (<https://schema.org/fileSize>)\n\nDataPropertyDomain(<https://schema.org/fileSize> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/fileSize> xsd:string)\n\n# Data Property: <https://schema.org/givenName> (<https://schema.org/givenName>)\n\nDataPropertyDomain(<https://schema.org/givenName> ObjectUnionOf(<https://purl.org/ontology/modalia#Contributor> <https://purl.org/ontology/modalia#User>))\nDataPropertyRange(<https://schema.org/givenName> xsd:string)\n\n# Data Property: <https://schema.org/identifier> (<https://schema.org/identifier>)\n\nDataPropertyDomain(<https://schema.org/identifier> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/identifier> xsd:string)\n\n# Data Property: <https://schema.org/image> (<https://schema.org/image>)\n\nDataPropertyDomain(<https://schema.org/image> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/image> xsd:anyURI)\n\n# Data Property: <https://schema.org/isAccessibleForFree> (<https://schema.org/isAccessibleForFree>)\n\nDataPropertyDomain(<https://schema.org/isAccessibleForFree> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/isAccessibleForFree> xsd:boolean)\n\n# Data Property: <https://schema.org/keywords> (<https://schema.org/keywords>)\n\nDataPropertyDomain(<https://schema.org/keywords> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/keywords> xsd:string)\n\n# Data Property: <https://schema.org/ratingValue> (<https://schema.org/ratingValue>)\n\nDataPropertyDomain(<https://schema.org/ratingValue> <https://schema.org/Rating>)\nDataPropertyRange(<https://schema.org/ratingValue> xsd:integer)\n\n# Data Property: <https://schema.org/reviewBody> (<https://schema.org/reviewBody>)\n\nDataPropertyDomain(<https://schema.org/reviewBody> <https://schema.org/Review>)\nDataPropertyRange(<https://schema.org/reviewBody> xsd:string)\n\n# Data Property: <https://schema.org/reviewRating> (<https://schema.org/reviewRating>)\n\nDataPropertyDomain(<https://schema.org/reviewRating> <https://schema.org/Review>)\nDataPropertyRange(<https://schema.org/reviewRating> xsd:integer)\n\n# Data Property: <https://schema.org/teaches> (<https://schema.org/teaches>)\n\nDataPropertyDomain(<https://schema.org/teaches> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/teaches> xsd:string)\n\n# Data Property: <https://schema.org/timeRequired> (<https://schema.org/timeRequired>)\n\nDataPropertyDomain(<https://schema.org/timeRequired> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/timeRequired> xsd:duration)\n\n# Data Property: <https://schema.org/title> (<https://schema.org/title>)\n\nDataPropertyDomain(<https://schema.org/title> <https://purl.org/ontology/modalia#Job>)\nDataPropertyRange(<https://schema.org/title> xsd:string)\n\n# Data Property: <https://schema.org/url> (<https://schema.org/url>)\n\nDataPropertyDomain(<https://schema.org/url> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/url> xsd:anyURI)\n\n# Data Property: <https://schema.org/version> (<https://schema.org/version>)\n\nDataPropertyDomain(<https://schema.org/version> <https://github.com/tibonto/educor#EducationalResource>)\nDataPropertyRange(<https://schema.org/version> xsd:string)\n\n\n\n############################\n#   Classes\n############################\n\n# Class: <https://purl.org/ontology/modalia#Proficiency> (<https://purl.org/ontology/modalia#Proficiency>)\n\nEquivalentClasses(<https://purl.org/ontology/modalia#Proficiency> ObjectOneOf(<https://purl.org/ontology/modalia#Beginner> <https://purl.org/ontology/modalia#Competent> <https://purl.org/ontology/modalia#Expert> <https://purl.org/ontology/modalia#Novice> <https://purl.org/ontology/modalia#Proficient>))\n\n\n############################\n#   Named Individuals\n############################\n\n# Individual: <https://purl.org/ontology/modalia#Beginner> (<https://purl.org/ontology/modalia#Beginner>)\n\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Beginner> <https://purl.org/ontology/modalia#Competent>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Beginner> <https://purl.org/ontology/modalia#Expert>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Beginner> <https://purl.org/ontology/modalia#Proficient>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Beginner> <https://purl.org/ontology/modalia#Novice>)\nDataPropertyAssertion(<https://purl.org/ontology/modalia#hasOrder> <https://purl.org/ontology/modalia#Beginner> \"2\"^^xsd:integer)\n\n# Individual: <https://purl.org/ontology/modalia#Competent> (<https://purl.org/ontology/modalia#Competent>)\n\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Competent> <https://purl.org/ontology/modalia#Expert>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Competent> <https://purl.org/ontology/modalia#Proficient>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Competent> <https://purl.org/ontology/modalia#Beginner>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Competent> <https://purl.org/ontology/modalia#Novice>)\nDataPropertyAssertion(<https://purl.org/ontology/modalia#hasOrder> <https://purl.org/ontology/modalia#Competent> \"3\"^^xsd:integer)\n\n# Individual: <https://purl.org/ontology/modalia#Expert> (<https://purl.org/ontology/modalia#Expert>)\n\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Expert> <https://purl.org/ontology/modalia#Beginner>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Expert> <https://purl.org/ontology/modalia#Competent>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Expert> <https://purl.org/ontology/modalia#Novice>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Expert> <https://purl.org/ontology/modalia#Proficient>)\nDataPropertyAssertion(<https://purl.org/ontology/modalia#hasOrder> <https://purl.org/ontology/modalia#Expert> \"5\"^^xsd:integer)\n\n# Individual: <https://purl.org/ontology/modalia#Novice> (<https://purl.org/ontology/modalia#Novice>)\n\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Novice> <https://purl.org/ontology/modalia#Beginner>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Novice> <https://purl.org/ontology/modalia#Competent>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Novice> <https://purl.org/ontology/modalia#Expert>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Novice> <https://purl.org/ontology/modalia#Proficient>)\nDataPropertyAssertion(<https://purl.org/ontology/modalia#hasOrder> <https://purl.org/ontology/modalia#Novice> \"1\"^^xsd:integer)\n\n# Individual: <https://purl.org/ontology/modalia#Proficient> (<https://purl.org/ontology/modalia#Proficient>)\n\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isLessProficientThan> <https://purl.org/ontology/modalia#Proficient> <https://purl.org/ontology/modalia#Expert>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Proficient> <https://purl.org/ontology/modalia#Beginner>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Proficient> <https://purl.org/ontology/modalia#Competent>)\nObjectPropertyAssertion(<https://purl.org/ontology/modalia#isMoreProficientThan> <https://purl.org/ontology/modalia#Proficient> <https://purl.org/ontology/modalia#Novice>)\nDataPropertyAssertion(<https://purl.org/ontology/modalia#hasOrder> <https://purl.org/ontology/modalia#Proficient> \"4\"^^xsd:integer)\n\n\n)
