property_value: skos:prefLabel "Thesis" xsd:string

[Term]
id: bibo:Webpage
name: webpage
is_a: modalia:LearningResourceType ! learning resource type
property_value: skos:prefLabel "Web page" xsd:string

[Term]
id: bibo:Workshop
name: workshop
def: "A seminar, discussion group, or the like, that emphasizes zxchange of ideas and the demonstration and application of techniques, skills, etc." []
is_a: modalia:LearningResourceType ! learning resource type
property_value: skos:prefLabel "workshop" xsd:string

[Term]
id: ec:EducationalResource
name: educational resource
def: "Any educational resources online or offline" []
property_value: skos:example "A video describing how lists work in Python programming language" xsd:string

[Term]
id: ec:KnowledgeTopic
name: knowledge topic
def: "A single node representing a learning module based on the domain ontology. It contains all the learning material for the specific learning module." []
disjoint_from: modalia:Skill ! skill
property_value: seeAlso "https://w3id.org/ccso/ccso#Topic" xsd:string
property_value: skos:example "A knowledge topic can be the “Quadratic equations” in the domain of Mathematics Algebra" xsd:string

[Term]
id: ec:LearningPreference
name: learning preference
def: "The learning preference of the user based on the learning styles theory" []
comment: It is based on the theory which identifies four learning styles (visual, auditory, reading, and kinesthetic).
property_value: skos:example "Visual" xsd:string

[Term]
id: ec:Recommendation
name: recommendation
def: "The output of the recommendation system algorithm. The system that reads user profile, content information, ratings and any available rules, in order to generate a meaningful recommendation." []
comment: The recommendation in advanced systems can also be an action (take a small break), an exercise, a knowledge topic, a skill, or a learning path
property_value: skos:example "The recommendation is \"Quadratic Equation\"" xsd:string

[Term]
id: edamdata:0006
name: data
def: "Kind of data being managed" []

