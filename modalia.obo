property_value: dcterms:created "2023-02-02" xsd:string
property_value: dcterms:creator "BMFTR DALIA project" xsd:string
property_value: dcterms:description "MoDALIA: An Ontology for Educational Material in Research Data Management (RDM) and Data Science.\nThe ontology is used for making a knowledge graph as a backend to platform for teaching, personal learning, and recommendation.\nThe ontology is developed in OWL in Protege 5.5.0." xsd:string
