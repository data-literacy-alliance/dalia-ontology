# Was sind Forschungsdaten?
# https://www.cms.hu-berlin.de/de/dl/dataman/support/material
# row 29: https://docs.google.com/spreadsheets/d/1zsxpuFgkf9duk-sCum5gmm7_9p9sQOPFCPxnS66WKhc/edit#gid=0 
:E5 a :EducationalResource;
   dc:title "Was sind Forschungsdaten?";
   dc:description "An online tutorial by the research data management initiative of the Humboldt University in Berlin." ;
   dcterms:langauge "de";
   :hasQuality 9;
   :requiresProficiencyLevel :Novice ;
   :givesProficiencyLevel  :Beginner ;
   schema:keywords "research data" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
   schema:url <https://www.cms.hu-berlin.de/de/dl/dataman/support/material> ;
   :hasLearningType :Tutorial ;
   schema:author ( "Anja Rosenbaum" ) ;
   schema:dateCreated "2016-12-02"^^xsd:date ;
   schema:timeRequired "PT7M11S"^^xsd:duration ;
   schema:identifier "DOI:10.18450/dataman/90" ;
   :hasDOI "10.18450/dataman/90" ;
   :accessibleForFree "true"^^xsd:boolean ;
   :hasAttachment <https://w3id.org/kim/hcrt/video> ;
   bf:contribution [ 
           a bf:Contribution ;
		   bf:role :DataCurator ;
	       bf:agent :user1  ] ;
   :hasTargetGroup :MasterStudent, :BachelorStudent .
   
#Provider/repository
:E5 :hasProvider [
                  a :Provider ;
				  schema:name "Humboldt University in Berlin";
				  :hasProviderType :OrganisationProviderType
				  ] .
#topics
:KT1 a :KnowledgeTopic ;
     dc:title "Research data definition" ;
	 :hasKnowledgeDomain :KD1;
	 :hasLearningResource :E5 .
:KT2 a :KnowledgeTopic ;
     dc:title "Research data subdivisions" ;
	 :hasKnowledgeDomain :KD1;
	 :hasLearningResource :E5 .
