# Datenmanagement nach Plan
# https://www.rwth-aachen.de/cms/root/Forschung/Forschungsdatenmanagement/Weiterbildungsangebote/~udzt/Lehrvideos/
# row 24: https://docs.google.com/spreadsheets/d/1zsxpuFgkf9duk-sCum5gmm7_9p9sQOPFCPxnS66WKhc/edit#gid=0 
:E6 a :EducationalResource;
   dc:title "Datenmanagement nach Plan";
   dc:description "Das Lehrvideo „Datenmanagement nach Plan“ erklärt kurz, was ein Datenmanagementplan (DMP) ist und welche Vorteile er für die Forschung bietet."@de ;
   dcterms:langauge "de";
   :hasQuality 9;
   :requiresProficiencyLevel :Novice ;
   :givesProficiencyLevel  :Beginner ;
   schema:keywords "data management plan", "DMP" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
   schema:url <https://www.rwth-aachen.de/cms/root/Forschung/Forschungsdatenmanagement/Weiterbildungsangebote/~udzt/Lehrvideos/> ;
   :hasLearningType :Tutorial ;
   schema:author ("Dominik Schmitz" "Daniela Hausen" "Ute Trautwein-Bruns") ;
   schema:dateCreated "2019-02-26"^^xsd:date ;
   schema:timeRequired "PT5M20S"^^xsd:duration ;
   schema:identifier "DOI: 10.18154/RWTH-2018-231100" ;
   :hasDOI "10.18154/RWTH-2018-231100" ;
   :accessibleForFree "true"^^xsd:boolean ;
   :hasAttachment <https://w3id.org/kim/hcrt/video> ;
   :hasTargetGroup :MasterStudent, :PhDStudent .
   
#Provider/repository
:E6 :hasProvider [
                  a :Provider ;
				  schema:name "RWTH Aachen University";
				  :hasProviderType :OrganisationProviderType
				  ] .
#topics
:KT3 a :KnowledgeTopic ;
     dc:title "data management plan (DMP)" ;
	 :hasKnowledgeDomain :KD1;
	 :hasLearningResource :E6 .
