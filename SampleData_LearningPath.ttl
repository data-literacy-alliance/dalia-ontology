ex:LP1 a mo:LearningPath ;
 dcterms:title "RDM for PhD Candidate in Chemistry" ;
 dcterms:description "Learn important info for RDM in chemistry for PhD students, including DMP" ;
 schema:author [ 
           a schema:Person ;
		   schema:familyName "Desouki"
		   ] ;
 mo:studyPlan "Two hours per week for five weeks" ;
 mo:hasLearningObjective ex:LO1 .
 
 ex:LP1Step1 a mo:LearningPathStep ;
   mo:notesforlearner "Slides 19 to 28";
   mo:hasOrder 1;
   mo:belongsToLearningPath ex:LP1 ;
   mo:hasEducationalResource <https://id.dalia.education/learning-resource/f111d6c4-d316-4161-8b06-0ec7f4181ce6> . 
   # e.g. DMP
   
   
 ex:LP1Step2 a mo:LearningPathStep ;
   mo:notesforlearner "From min 30 to the end";
   mo:hasOrder 2;
   mo:belongsToLearningPath ex:LP1 ;
   mo:hasEducationalResource <https://id.dalia.education/learning-resource/1bcd8f00-e2a6-4427-9e75-cb897d67d204> . 
   # e.g General Concepts and Focus on ELN
   
 ex:LO1 a mo:LearningObjective ;
    skos:prefLabel "Lernende können die Relevanz eines Datenmanagementplans diskutieren."@de .
   
   <https://id.dalia.education/learning-resource/1bcd8f00-e2a6-4427-9e75-cb897d67d204> a ec:EducationalResource ;
    dcterms:title "NFDI4Chem Web Seminars - 01. General Concepts and Focus on Electronic Laboratory Notebooks (ELN)" ;
