@prefix schema: <http://www.schema.org/> .
@prefix ec:   <https://github.com/tibonto/educor#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xml:  <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix : <https://purl.org/ontology/modalia#> .

:UserShape a sh:NodeShape;
   sh:targetClass :User ;
   sh:property [                  # name
    sh:path     schema:name ;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string ;
  ] ;
  sh:property [                   # email, unique?
   sh:path schema:email ;
   sh:minCount 1;
   sh:maxCount 1;
  ] .
  
:EducationalResourceShape a  sh:NodeShape;
        sh:targetClass :EducationalResource ;
        sh:property [                  # url
           sh:path   schema:url
           sh:datatype  xsd:anyURI  ; 
		   sh:minCount 1;
		   sh:maxCount 1;
		] ; 
		sh:property [                  # title
           sh:path   dc:title
           sh:datatype xsd:string  ; 
		   sh:minCount 1;
		   sh:maxCount 1;
		] ; 
		sh:property [                  # dateCreated
           sh:path   schema:dateCreated
           sh:datatype  xsd:dateTime ; 
		   sh:maxCount 1;
		] ;
		sh:property [                  # hasLearningType
           sh:path   :hasLearningType
           sh:class     :LearningResourceType  ; 
		   sh:maxCount 1;
		] ;
		sh:property [                  # accessibleForFree
           sh:path   :accessibleForFree
           sh:datatype  xsd:boolean ; 
		   sh:maxCount 1;
		] ;
		sh:property [                  # requiresProficiencyLevel
           sh:path   :requiresProficiencyLevel
           sh:class     :ProficiencyLevel  ; 
		] ;
		sh:property [                  # givesProficiencyLevel
           sh:path   :givesProficiencyLevel
           sh:class     :ProficiencyLevel  ; 
		] ;
               .
		
